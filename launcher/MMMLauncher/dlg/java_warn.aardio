//dlg/java_warn.aardio

//Java 版本不匹配的提示框。返回：1 自动换用推荐版本 / 2 手动选择 / 3 强制使用

import win.ui;
import m3theme;
/*DSG{{*/
var winform = win.form(text="Java 版本有误";right=560;bottom=230;bgcolor=0xF2F2F2;border="dialog frame";max=false;min=false)
winform.add(
btnAuto={cls="plus";text="换用推荐版本";left=24;top=104;right=176;bottom=140;font=LOGFONT(name='Microsoft YaHei');z=2};
btnForce={cls="plus";text="强制使用这个";left=352;top=104;right=504;bottom=140;font=LOGFONT(name='Microsoft YaHei');z=4};
btnManual={cls="plus";text="手动选择 Java";left=188;top=104;right=340;bottom=140;font=LOGFONT(name='Microsoft YaHei');z=3};
lblHint={cls="static";text="换用推荐版本将自动挑选一个符合该游戏版本要求的 Java。";left=24;top=158;right=536;bottom=180;font=LOGFONT(h=-11;name='Microsoft YaHei');z=5};
lblMsg={cls="static";left=24;top=24;right=536;bottom=72;font=LOGFONT(name='Microsoft YaHei');z=1}
)
/*}}*/

m3theme.ink(winform.lblMsg);
m3theme.note(winform.lblHint);

m3theme.primary(winform.btnAuto);
m3theme.button(winform.btnManual);
m3theme.ghost(winform.btnForce);

winform.btnAuto.oncommand = function(id, event) {
	winform.endModal(1);
}

winform.btnManual.oncommand = function(id, event) {
	winform.endModal(2);
}

winform.btnForce.oncommand = function(id, event) {
	winform.endModal(3);
}

winform.onCancel = function() {
	winform.endModal(3);
}

return winform;
