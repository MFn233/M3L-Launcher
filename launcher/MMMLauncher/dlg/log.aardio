//dlg/log.aardio

//日志窗口：一个窗口显示一个会话（一个游戏实例）。
//主窗口 loadForm 之后调 bind(会话)，这里不自己挂。
//
//要点：
//1) 按级别上色 + 错误加粗，误差要小（游戏日志的 ERROR/WARN、栈帧都要认出来）；
//2) 顶部四个筛选按钮带实时计数，切换时整段重设文本，不会残留旧内容；
//3) 追加只写命中当前筛选的行，但计数始终更新。

import win.ui;
import m3theme;
import m3pack;
import m3config;
import process;

/*DSG{{*/
var winform = win.form(text="日志";right=640;bottom=452;bgcolor=0xF2F2F2;border="resizable")
winform.add(
btnAll={cls="plus";text="全部";left=16;top=12;right=104;bottom=38;anchors={left=1;top=1};font=LOGFONT(name='Microsoft YaHei';h=-12);z=10};
btnError={cls="plus";text="错误";left=110;top=12;right=198;bottom=38;anchors={left=1;top=1};font=LOGFONT(name='Microsoft YaHei';h=-12);z=11};
btnWarn={cls="plus";text="警告";left=204;top=12;right=292;bottom=38;anchors={left=1;top=1};font=LOGFONT(name='Microsoft YaHei';h=-12);z=12};
btnDebug={cls="plus";text="调试";left=298;top=12;right=386;bottom=38;anchors={left=1;top=1};font=LOGFONT(name='Microsoft YaHei';h=-12);z=13};
editLog={cls="richedit";left=16;top=48;right=624;bottom=396;bgcolor=0xFFFFFF;readonly=1;multiline=1;vscroll=1;autohscroll=false;anchors={left=1;top=1;right=1;bottom=1};font=LOGFONT(name='Consolas';h=-12);z=1};
btnClear={cls="plus";text="清空";left=16;top=408;right=88;bottom=438;anchors={left=1;bottom=1};font=LOGFONT(name='Microsoft YaHei';h=-12);z=2};
btnPack={cls="plus";text="打包日志";left=96;top=408;right=216;bottom=438;anchors={left=1;bottom=1};font=LOGFONT(name='Microsoft YaHei';h=-12);z=4};
btnClose={cls="plus";text="关闭";left=536;top=408;right=624;bottom=438;anchors={right=1;bottom=1};font=LOGFONT(name='Microsoft YaHei';h=-12);z=3};
chkAuto={cls="checkbox";text="自动滚动";left=232;top=412;right=340;bottom=434;anchors={left=1;bottom=1};font=LOGFONT(name='Microsoft YaHei';h=-12);z=5};
)
/*}}*/

//级别配色：错误用红（这是唯一例外，因为必须一眼看见），其余靠深浅与加粗区分
var C_FATAL = m3theme.C_RED;
var C_ERROR = m3theme.C_RED;
var C_WARN = 0x000000;   // 纯黑 + 加粗
var C_INFO = 0x333333;
var C_DEBUG = 0x8C8C8C;

function level_style(lv) {
	if (lv == "fatal" or lv == "error") return { textColor = C_ERROR; bold = true };
	if (lv == "warn") return { textColor = C_WARN; bold = true };
	if (lv == "debug") return { textColor = C_DEBUG };

	return { textColor = C_INFO };
}

winform.editLog.color = C_INFO;

m3theme.button(winform.btnClear);
m3theme.button(winform.btnPack);
m3theme.button(winform.btnClose);

for i, b in { winform.btnAll; winform.btnError; winform.btnWarn; winform.btnDebug } {
	m3theme.button(b);
}

winform.chkAuto.bgcolor = m3theme.C_BG;

//选择记在 config.json 里，下次打开还是上次的样子
var cfg = m3config.read();
winform.chkAuto.checked = (cfg.log_autoscroll !== false);

// ---------- 数据 ----------

//每行：{ level = "fatal"/"error"/"warn"/"info"/"debug"; text = 原文 }
var lines = {};

//太长的会话只留最后这么多行，免得日志窗口越用越慢
var MAX_LINES = 5000;

var counts = { fatal = 0; error = 0; warn = 0; info = 0; debug = 0 };
var filter = "all";
var last_level = "info";   // 栈帧继承上一行的级别

//判断一行是什么级别。
//除了我们自己的 [错误] [警告] [调试] 前缀，还要认游戏/Forge 原生日志：
//  [21:22:12] [main/ERROR] [FML]: ...      → error
//  [21:22:12] [main/WARN]: ...             → warn
//      at net.minecraft...                  → 跟上一行同级（栈帧）
function level_of(line, is_error) {
	var low = string.lower(tostring(line));
	var lv = null;

	if (string.indexOf(low, "[致命]") or string.indexOf(low, "fatal")) {
		lv = "fatal";
	}
	elseif (string.indexOf(low, "[错误]")
		or string.indexOf(low, "/error]")
		or string.indexOf(low, "[error]")
		or string.indexOf(low, "error:")
		or string.indexOf(low, "exception")
		or string.indexOf(low, "caused by")) {
		lv = "error";
	}
	elseif (string.indexOf(low, "[警告]")
		or string.indexOf(low, "/warn]")
		or string.indexOf(low, "[warn]")
		or string.indexOf(low, "warning")) {
		lv = "warn";
	}
	elseif (string.indexOf(low, "[调试]")
		or string.indexOf(low, "/debug]")
		or string.indexOf(low, "[debug]")
		or string.indexOf(low, "[trace]")) {
		lv = "debug";
	}
	elseif (is_error) {
		lv = "error";
	}
	else {
		//栈帧与 "..." 续行跟着上一行走
		var t = string.trim(tostring(line));

		if (string.startsWith(t, "at ") or string.startsWith(t, "...")) lv = last_level;
		else lv = "info";
	}

	last_level = lv;

	return lv;
}

function count_text(label, n) {
	return label ++ " " ++ n;
}

function update_buttons() {
	winform.btnAll.text = count_text("全部", #lines);
	winform.btnError.text = count_text("错误", counts.fatal + counts.error);
	winform.btnWarn.text = count_text("警告", counts.warn);
	winform.btnDebug.text = count_text("调试", counts.debug);

	//选中的那个反色（和设置里的子页签一致）
	var pairs = {
		{ winform.btnAll; "all" };
		{ winform.btnError; "error" };
		{ winform.btnWarn; "warn" };
		{ winform.btnDebug; "debug" };
	};

	for i, p in pairs {
		var ctrl = p[1];
		var on = (filter == p[2]);

		if (on) {
			ctrl.skin({
				background = { default = m3theme.INK; hover = m3theme.INK; active = m3theme.INK };
				color = { default = m3theme.C_BG; hover = m3theme.C_BG; active = m3theme.C_BG };
			});
		}
		else {
			ctrl.skin({
				background = { default = m3theme.C_BG; hover = m3theme.SIDEBAR_HOVER; active = m3theme.C_BG };
				color = { default = m3theme.INK; hover = m3theme.INK; active = m3theme.INK };
			});
		}
	}
}

function scroll_bottom() {
	if (winform.chkAuto.checked) {
		::SendMessageInt(winform.editLog.hwnd, 0x0115 /*_WM_VSCROLL*/, 7 /*_SB_BOTTOM*/, 0);
	}
}

function passed(lv) {
	if (filter == "all") return true;
	if (filter == "error") return (lv == "error" or lv == "fatal");

	return (lv == filter);
}

//按当前筛选重建全部内容。
//用逐行 appendText（控件自己维护插入点），不用 setSel 手算区间：
//richedit 的位置是 UTF-16 字符数，而 aardio 的 #s 是字节数，中文行会算错。
function render_all() {
	winform.editLog.readonly = false;

	::SendMessageInt(winform.editLog.hwnd, 0x000B /*_WM_SETREDRAW*/, 0, 0);

	//清两遍：一次 text 置空，一次选中全部删除。richedit 在某些状态下只吃其中一种。
	winform.editLog.text = "";
	winform.editLog.setSel(0, -1);
	winform.editLog.selText = "";

	var shown = 0;

	for i, ln in lines {
		if (!passed(ln.level)) continue;

		winform.editLog.appendText(level_style(ln.level), ln.text ++ '\r\n');
		shown = shown + 1;
	}

	::SendMessageInt(winform.editLog.hwnd, 0x000B, 1, 0);

	winform.editLog.readonly = true;

	update_buttons();
	scroll_bottom();
}

//给会话用的接口
winform.append = function(text, is_error) {
	var line = tostring(text);
	var lv = level_of(line, is_error);

	table.push(lines, { level = lv; text = line });
	counts[lv] = (counts[lv] or 0) + 1;

	//超长会话整段裁掉最老的一批（不用 table.remove 删数组头，会留空洞）
	if (#lines > MAX_LINES) {
		var kept = {};

		for i = 501; #lines; 1 {
			table.push(kept, lines[i]);
		}

		lines = kept;
	}

	if (passed(lv)) {
		winform.editLog.readonly = false;
		winform.editLog.appendText(level_style(lv), line ++ '\r\n');
		winform.editLog.readonly = true;

		scroll_bottom();
	}

	update_buttons();
}

winform.clear_all = function() {
	lines = {};
	counts = { fatal = 0; error = 0; warn = 0; info = 0; debug = 0 };
	last_level = "info";

	winform.editLog.readonly = false;
	winform.editLog.text = "";
	winform.editLog.readonly = true;

	update_buttons();
}

// ---------- 筛选按钮 ----------

winform.btnAll.oncommand = function(id, event) {
	filter = "all";
	render_all();
}

winform.btnError.oncommand = function(id, event) {
	filter = "error";
	render_all();
}

winform.btnWarn.oncommand = function(id, event) {
	filter = "warn";
	render_all();
}

winform.btnDebug.oncommand = function(id, event) {
	filter = "debug";
	render_all();
}

var session = null;
var inst = null;

// 主窗口把会话交给这个窗口；inst 是实例表（打包日志时读路径用）
winform.bind = function(sess, owner_inst) {
	if (session) session.detach(winform);

	session = sess;
	inst = owner_inst;

	if (sess) sess.attach(winform);
}

winform.chkAuto.oncommand = function(id, event) {
	cfg.log_autoscroll = winform.chkAuto.checked;
	m3config.save_keys(cfg, {"log_autoscroll"});

	if (winform.chkAuto.checked) scroll_bottom();
}

winform.btnClear.oncommand = function(id, event) {
	if (session) session.clear();
	else winform.clear_all();
}

// 把排查用的文件打成一个 zip（游戏日志、崩溃报告、mods 列表、启动命令…）
winform.btnPack.oncommand = function(id, event) {
	var ctx = {
		info = {
			version = (inst ? inst.version : "");
			game_dir = (inst ? inst.game_dir : "");
			work_dir = (inst ? inst.work_dir : "");
			java = (inst ? inst.java : "");
			memory = (inst ? inst.memory : "");
			exit_code = "";
			seconds = 0;
		};
		session = (session ? session.text() : "");
		cmdline = (inst ? inst.cmdline : "");
		work_dir = (inst ? inst.work_dir : "");
	};

	var zip_path, err = m3pack.pack(ctx);
	if (!zip_path) {
		winform.append("打包失败：" ++ tostring(err), true);
		return;
	}

	winform.append("已打包：" ++ zip_path, false);
	process.exploreSelect(zip_path);
}

winform.btnClose.oncommand = function(id, event) {
	winform.close();
}

winform.onClose = function(hwnd, message, wParam, lParam) {
	if (session) session.detach(winform);
}

update_buttons();

winform.show();
return winform;
