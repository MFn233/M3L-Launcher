//dlg/settings2.aardio

//设置（新版）：左侧分类导航 + 右侧分组内容。
//布局全部交给 m3layout：这里只描述「哪一节、放什么」，不写坐标。
//
//顺序要紧：aardio 的 var 只从声明处往后可见，所以先建控件、再写用到这些控件的函数。
//五页一次建好，切换时用各页的 controls 数组统一显隐。

import win.ui;
import m3theme;
import m3layout;
import m3config;
import m3java;
import sys.mem;
import fsys;
import string;
import math;

/*DSG{{*/
var winform = win.form(text="设置";right=880;bottom=600;bgcolor=0xF2F2F2;border="dialog frame";max=false;min=false)
winform.add(
listNav={cls="listbox";left=16;top=16;right=200;bottom=528;bgcolor=0xFFFFFF;font=LOGFONT(name='Microsoft YaHei';h=-13);z=1};
lblHint={cls="static";left=16;top=540;right=600;bottom=568;font=LOGFONT(name='Microsoft YaHei';h=-11);z=2};
btnCancel={cls="plus";text="取消";left=700;top=540;right=780;bottom=572;font=LOGFONT(name='Microsoft YaHei';h=-13);z=3};
btnSave={cls="plus";text="保存";left=788;top=540;right=868;bottom=572;font=LOGFONT(name='Microsoft YaHei';h=-13);z=4}
)
/*}}*/

m3theme.note(winform.lblHint);
m3theme.button(winform.btnCancel);
m3theme.button(winform.btnSave);

var cfg = m3config.read();
var paths = cfg.game_paths;
var path_dirs = {};

// ---------- 第一页：启动器设置 ----------

var P1 = m3layout.create(winform, 232, 24, 620, { framed = true });

P1.section("启动器行为");
var chkLog = P1.check("启动时弹出日志窗口", cfg.log);
var chkHide = P1.check("启动后隐藏启动器", cfg.hide_after_launch);
var chkStatus = P1.check("显示主页状态栏", cfg.status_bar);
var chkDebug = P1.check("调试模式", cfg.debug);
var chkMulti = P1.check("允许同时运行多个实例", cfg.allow_multi);
var chkShot = P1.check("崩溃时提醒「请勿直接截图分享此窗口」", cfg.shot_tip);

P1.section("样式设置");
P1.text("尚未实现。（后续在这里提供主题与外观调整）");

P1.finish();

// ---------- 第二页：游戏设置 ----------

var P2 = m3layout.create(winform, 232, 24, 620, { framed = true });

P2.section("窗口大小设置");
var comboMode, btnDefault = P2.row("窗口模式", { cls = "combobox"; mode = "dropdownlist" }, "默认大小");
var editW = P2.row("宽度", { cls = "edit"; text = "854"; num = 1 });
var editH = P2.row("高度", { cls = "edit"; text = "480"; num = 1 });
P2.text("手动设置时才需要填宽度与高度；全屏与「与启动器一致」会忽略这两个值。");

P2.section("分配内存");
var editMem, btnAuto = P2.row("内存", { cls = "edit"; text = "4096"; num = 1 }, "自动配置");
P2.text("单位 MB。建议取物理内存的 1/4。");

P2.section("进程优先级");
var comboPri = P2.row("优先级", { cls = "combobox"; mode = "dropdownlist" });

P2.finish();

// ---------- 第三页：账户管理 ----------

var P3 = m3layout.create(winform, 232, 24, 620, { framed = true });

P3.section("当前账号");
var lblAccount = P3.text("尚未配置账号");

P3.section("账号列表");
P3.text("账号列表、离线 UUID、删除账号仍在「用户配置」窗口里。" ++ '\r\n'
	++ "迁移完成后这一页会直接列出所有账号，不必再开新窗口。");
var btnsAccount = P3.buttons({"用户配置"});

P3.finish();

// ---------- 第四页：JAVA 管理 ----------

var P4 = m3layout.create(winform, 232, 24, 620, { framed = true });

P4.section("Java 列表");
var editJava, btnJava = P4.row("当前", { cls = "edit"; text = "" }, "Java 管理");
P4.text("按路径检测 Java、显示厂商与版本、可加入黑名单。仍在「Java 管理」窗口里。");

P4.section("自定义 JVM 参数");
P4.text("尚未实现。（后续在这里填额外的 JVM 参数，每行一条）");

P4.finish();

// ---------- 第五页：路径与版本管理 ----------

var P5 = m3layout.create(winform, 232, 24, 620, { framed = true });

P5.section("游戏路径");
var comboPath, btnPaths = P5.row("当前路径", { cls = "combobox"; mode = "dropdownlist" }, "路径管理");
P5.text("切换路径后，若当前版本在新路径里不存在，会自动选第一个可用版本。");

P5.section("版本");
var lblVersion = P5.text("");
var btnsVersions = P5.buttons({"版本管理"});
P5.gap(4);
P5.text("切换当前版本、隔离、重命名、删除（删除进回收站）。仍在「版本管理」窗口里。");

P5.finish();

// ---------- 用得到控件的函数（必须在控件声明之后） ----------

function user_summary(c) {
	if (#c.username == 0) return "尚未配置账号";

	var acc = m3config.find_account(c, c.username);

	var type_text = "离线登录";
	if (acc and (acc.type == "msa" or acc.type == "mojang")) type_text = "正版登录";

	return type_text ++ "：" ++ c.username;
}

function mode_index(m) {
	if (m == "fullscreen") return 2;
	if (m == "match") return 3;
	return 1;
}

function priority_index(p) {
	if (p == "idle") return 1;
	if (p == "below") return 2;
	if (p == "above") return 4;
	if (p == "high") return 5;
	return 3;
}

function priority_value(i) {
	if (i == 1) return "idle";
	if (i == 2) return "below";
	if (i == 4) return "above";
	if (i == 5) return "high";
	return "normal";
}

function update_mode_ui() {
	var manual = (comboMode.selIndex == 1);
	editW.disabled = !manual;
	editH.disabled = !manual;
}

function first_version(dir) {
	if (!dir) return null;

	var vdir = io.joinpath(dir, "versions");
	if (!io.exist(vdir)) return null;

	var files, folders = fsys.list(vdir);
	if (#folders == 0) return null;

	return folders[1];
}

function has_version(dir, name) {
	var vdir = io.joinpath(dir, "versions");
	if (!io.exist(vdir)) return false;

	var files, folders = fsys.list(vdir);
	for(i = 1; #folders; 1) {
		if (folders[i] == name) return true;
	}

	return false;
}

function refresh_path_combo() {
	comboPath.clear();
	path_dirs = {};

	for i, p in paths {
		var label = p.name;
		if (!label or #label == 0) label = p.dir;

		comboPath.add(label);
		table.push(path_dirs, p.dir);

		if (p.dir == cfg.game_path) comboPath.selIndex = #path_dirs;
	}
}

function selected_path() {
	var i = comboPath.selIndex;
	if (i <= 0) return null;
	return path_dirs[i];
}

// ---------- 分页 ----------

var PAGES = { P1; P2; P3; P4; P5 };
var nav_titles = { "启动器设置"; "游戏设置"; "账户管理"; "Java 管理"; "路径与版本管理" };

function show_page(n) {
	for i, page in PAGES {
		var on = (i == n);
		for k, ctrl in page.controls {
			ctrl.visible = on;
		}
	}
}

for i, t in nav_titles {
	winform.listNav.add(t);
}

winform.listNav.onSelChange = function() {
	var i = winform.listNav.selIndex;
	if (i <= 0) return;
	show_page(i);
}

// ---------- 事件 ----------

editMem.onChange = function() {
	var v = tonumber(string.trim(editMem.text));
	if (!v) return;

	if (v < 512) v = 512;
	if (v > 16384) v = 16384;
}

comboMode.onSelChange = function() {
	update_mode_ui();
}

comboPath.onSelChange = function() {
	var dir = selected_path();
	if (!dir) return;
	if (dir == cfg.game_path) return;

	var c = m3config.read();
	c.game_path = dir;

	if (!has_version(dir, c.version)) {
		var v = first_version(dir);
		if (v) c.version = v;
		else c.version = "";
	}

	m3config.save_keys(c, {"game_path"; "version"});

	cfg = m3config.read();
	lblHint_update();
}

function lblHint_update() {
	winform.lblHint.text = "当前游戏路径已切换：" ++ (cfg.game_path or "");
	lblVersion.text = "当前版本：" ++ (cfg.version or "未选择");
}

btnDefault.oncommand = function(id, event) {
	editW.text = "854";
	editH.text = "480";
	winform.lblHint.text = "已设为默认窗口大小 854 × 480。";
}

btnAuto.oncommand = function(id, event) {
	var status = sys.mem.getStatus();
	var total_mb = math.floor(status.totalPhys / 1048576);

	var mb = math.floor(total_mb / 4 / 256) * 256;
	if (mb < 1024) mb = 1024;
	if (mb > 8192) mb = 8192;

	editMem.text = tostring(mb);
	winform.lblHint.text = "按物理内存的 1/4 建议：" ++ mb ++ " MB（本机共 " ++ total_mb ++ " MB）";
}

btnsAccount[1].oncommand = function(id, event) {
	winform.loadForm("/dlg/accounts.aardio").doModal(winform);

	cfg = m3config.read();
	lblAccount.text = user_summary(cfg);
}

btnJava.oncommand = function(id, event) {
	winform.loadForm("/dlg/java.aardio").doModal(winform);

	cfg = m3config.read();
	editJava.text = cfg.java;
}

btnPaths.oncommand = function(id, event) {
	winform.loadForm("/dlg/paths.aardio").doModal(winform);

	cfg = m3config.read();
	paths = cfg.game_paths;
	refresh_path_combo();
}

btnsVersions[1].oncommand = function(id, event) {
	winform.loadForm("/dlg/versions.aardio").doModal(winform);

	cfg = m3config.read();
	lblVersion.text = "当前版本：" ++ (cfg.version or "未选择");
}

winform.btnSave.oncommand = function(id, event) {
	var c = m3config.read();

	var mb = tonumber(string.trim(editMem.text)) or c.memory;
	if (mb < 512) mb = 512;
	if (mb > 32768) mb = 32768;
	c.memory = mb;

	var dir = selected_path();
	if (dir) c.game_path = dir;

	if (#c.game_path > 0 and !has_version(c.game_path, c.version)) {
		var v = first_version(c.game_path);
		if (v) c.version = v;
		else c.version = "";
	}

	c.java = string.trim(editJava.text);

	c.width = tonumber(string.trim(editW.text)) or 854;
	c.height = tonumber(string.trim(editH.text)) or 480;
	if (c.width < 320) c.width = 320;
	if (c.height < 240) c.height = 240;

	var mi = comboMode.selIndex;
	if (mi == 2) c.window_mode = "fullscreen";
	elseif (mi == 3) c.window_mode = "match";
	else c.window_mode = "manual";

	c.priority = priority_value(comboPri.selIndex);

	c.log = chkLog.checked;
	c.hide_after_launch = chkHide.checked;
	c.status_bar = chkStatus.checked;
	c.debug = chkDebug.checked;
	c.allow_multi = chkMulti.checked;
	c.shot_tip = chkShot.checked;

	m3config.save(c);
	winform.endModal(true);
}

winform.btnCancel.oncommand = function(id, event) {
	winform.endModal(false);
}

winform.onOk = function() {
	winform.btnSave.oncommand();
}

winform.onCancel = function() {
	winform.btnCancel.oncommand();
}

// ---------- 初始化 ----------

lblAccount.text = user_summary(cfg);
lblVersion.text = "当前版本：" ++ (cfg.version or "未选择");

editMem.text = tostring(cfg.memory);
editJava.text = cfg.java;
editW.text = tostring(cfg.width);
editH.text = tostring(cfg.height);

comboMode.add("手动设置");
comboMode.add("全屏");
comboMode.add("与启动器一致");
comboMode.selIndex = mode_index(cfg.window_mode);
update_mode_ui();

comboPri.add("低");
comboPri.add("较低");
comboPri.add("正常");
comboPri.add("较高");
comboPri.add("高");
comboPri.selIndex = priority_index(cfg.priority);

refresh_path_combo();

show_page(1);
winform.listNav.selIndex = 1;

return winform;
