P1.section("启动器行为");
var chkLog = P1.check("启动时弹出日志窗口", cfg.log);
var chkHide = P1.check("启动后隐藏启动器", cfg.hide_after_launch);
var chkStatus = P1.check("显示主页状态栏", cfg.status_bar);
var chkDebug = P1.check("调试模式", cfg.debug);
var chkMulti = P1.check("允许同时运行多个实例", cfg.allow_multi);
var chkShot = P1.check("崩溃时提醒「请勿直接截图分享此窗口」", cfg.shot_tip);

//兼容处理默认开。关掉后 classpath 与启动参数一律照版本 JSON 原样，
//用于排查"某条兼容规则反而把某个整合包搞坏"的情况。
var chkCompat = P1.check("启动时自动兼容异常版本文件", cfg.compat_fix !== false);

//留空 = 用内置的公共客户端 ID。填自己的可以避开内置应用被限流。
var editMsClient = P1.row("微软客户端 ID", { cls = "edit" });
P1.text("留空则使用内置的公共客户端 ID；如需用自己的 Azure 应用，请填入它的客户端 ID。", true);

P1.section("样式设置", true);
P1.text("尚未实现。（后续在这里提供主题与外观调整）", true);

P1.finish();

// ---------- 第二页：游戏设置 ----------

var P2 = m3layout.create(winform, 232, 52, 504, { framed = true });

P2.section("窗口大小设置");
var comboMode, btnDefault = P2.row("窗口模式", { cls = "combobox"; mode = "dropdownlist" }, "默认大小");
var editW = P2.row("宽度", { cls = "edit"; text = "854" });
var editH = P2.row("高度", { cls = "edit"; text = "480" });

P2.section("分配内存");
var editMem, btnAuto = P2.row("内存", { cls = "edit"; text = "4096"; num = 1 }, "自动配置");

// 滑条上限取物理内存（按 256 取整），下限 1 GB、上限 32 GB：
// 允许分配超过物理内存没有意义，只会让系统疯狂换页。
var mem_status = sys.mem.getStatus();
var mem_total_mb = math.floor(mem_status.totalPhys / 1048576);

var MEM_MAX = math.floor(mem_total_mb / 256) * 256;
if (MEM_MAX < 1024) MEM_MAX = 1024;
if (MEM_MAX > 32768) MEM_MAX = 32768;

// 吸附到 128 MB 一档（直接用数值不好拖准）
var sliderMem = P2.make({
	cls = "plus";
	left = P2.left;
	top = P2.y;
	right = P2.right;
	bottom = P2.y + 22;
});

m3theme.slider(sliderMem);
sliderMem.setTrackbarRange(512, MEM_MAX);

P2.y = P2.y + 22 + 4;

var lblMemRange = P2.text("512 MB ～ " ++ string.format("%.1f GB", MEM_MAX / 1024), true);
var lblMemStats = P2.text("", true);

P2.section("进程优先级");
var comboPri = P2.row("优先级", { cls = "combobox"; mode = "dropdownlist" });

P2.finish();

