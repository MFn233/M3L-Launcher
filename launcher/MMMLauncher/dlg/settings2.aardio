//dlg/settings2.aardio

//设置（新版）：左侧分类导航 + 右侧分组内容。
//布局全部交给 m3layout：这里只描述「哪一节、放什么」，不写坐标。
//
//顺序要紧：aardio 的 var 只从声明处往后可见，所以先建控件、再写用到这些控件的函数。
//五页一次建好，切换时用各页的 controls 数组统一显隐。

import win.ui;
import m3theme;
import m3layout;
import m3config;
import m3java;
import MMMLC;
import process;
import fsys.dlg;
import win.ui.tooltip;
import m3list;
import m3opts;
import m3mod;
import m3version;
import json;
import crypt;
import sys.mem;
import fsys;
import fsys.version;
import m3app;
import m3auth;
import m3credits;
import string;
import math;
import time;
/*DSG{{*/
var winform = win.form(text="设置";right=759;bottom=567;bgcolor=0xF2F2F2;border="dialog frame";max=false;min=false)
winform.add(
btnCancel={cls="plus";text="取消";left=576;top=518;right=656;bottom=550;font=LOGFONT(h=-13;name='Microsoft YaHei');z=3};
btnSave={cls="plus";text="保存";left=664;top=518;right=744;bottom=550;font=LOGFONT(h=-13;name='Microsoft YaHei');z=4};
lblHint={cls="static";left=16;top=512;right=556;bottom=548;font=LOGFONT(h=-11;name='Microsoft YaHei');z=2};
lblPageTitle={cls="static";left=232;top=14;right=680;bottom=42;font=LOGFONT(h=-16;name='Microsoft YaHei';weight=700);z=1}
)
/*}}*/

// ---------- 三区：左导航 / 右内容 / 底部条 ----------
// 背景一律用 bkplus（无句柄背景控件）画，它不会抢 Z 序。
// 注意所有灰都是等值 RGB，ARGB 与 COLORREF 之间不需要反转。

// 颜色全部来自 m3theme：以后深色模式只改主题库
var NAV_BG = m3theme.SIDEBAR;
var NAV_SEL = m3theme.SIDEBAR_SEL;
var FOOT_BG = m3theme.FOOTER;
var DIVIDE = m3theme.DIVIDE;

var FOOT_TOP = 508;   // 底部条 52px：提示可能有两行

winform.add({
	cls = "bkplus"; left = 0; top = 0; right = 200; bottom = FOOT_TOP;
	bgcolor = NAV_BG;
});

winform.add({
	cls = "bkplus"; left = 0; top = FOOT_TOP; right = 760; bottom = 560;
	bgcolor = FOOT_BG;
});

winform.add({
	cls = "bkplus"; left = 0; top = FOOT_TOP - 1; right = 760; bottom = FOOT_TOP;
	bgcolor = DIVIDE;
});

// 从这里开始到 return 之前，窗口正在被搭出来：控件、分组框、列宽都在变。
// 冻结重绘，避免屏幕上出现中间状态（看起来像窗口在变形）。
m3layout.suspend(winform);

m3theme.ink(winform.lblPageTitle);

winform.lblHint.color = m3theme.C_MUTED;
winform.lblHint.bgcolor = m3theme.C_FOOTER;

m3theme.button(winform.btnCancel);
m3theme.button(winform.btnSave);

var cfg = m3config.read();

// 上次可能没点保存就退出了（崩溃 / 强关）：把残留草稿套到工作副本上，
// 界面显示的就是"改到一半"的样子。保存会写入，取消会（确认后）丢弃。
var draft_restored = false;
var pending = m3config.load_draft();
if (pending) {
	for k, v in pending {
		cfg[k] = v;
	}
	draft_restored = true;
}

// ---------- 滚动条 ----------
// 列表与多行输入框的滚动条是 Windows 主题（UxTheme）画的，aardio 改不了颜色。
// 唯一能试的办法是换主题名："DarkMode_Explorer" 会让 Win10/11 用深色细滚动条。
//
// 实测结论（浅色界面）：深色滚动条配浅色壳体"更诡异"，浅色界面下保持 false。
// 但**深色模式**下它才是正确选择——做完深色主题后，把这里改成 true（或改成跟随主题）。
var THIN_SCROLLBAR = false;

function try_thin_scrollbar(ctrl) {
	if (!THIN_SCROLLBAR) return;
	if (!ctrl) return;

	win.setWindowTheme(ctrl.hwnd, "DarkMode_Explorer", null);
}
// ---------- 第一页：启动器设置 ----------

