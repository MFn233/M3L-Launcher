// ---------- 子页切换 ----------

var sub_current = 1;   // 1 = 路径，2 = 版本

function sub_btn_skin(ctrl, selected) {
	if (selected) {
		ctrl.skin({
			background = { default = m3theme.SIDEBAR_SEL; hover = m3theme.SIDEBAR_SEL; active = m3theme.SIDEBAR_SEL };
			color = { default = m3theme.INK; hover = m3theme.INK; active = m3theme.INK };
		});
	}
	else {
		ctrl.skin({
			background = { default = m3theme.BG; hover = m3theme.SIDEBAR_HOVER; active = m3theme.SIDEBAR_SEL };
			color = { default = m3theme.MUTED; hover = m3theme.INK; active = m3theme.INK };
		});
	}
}

function sub_apply() {
	var on_path = (sub_current == 1);

	for i, c in SP.controls {
		c.visible = on_path;
	}
	for i, c in SV.controls {
		c.visible = !on_path;
	}

	sub_btn_skin(subPathBtn, on_path);
	sub_btn_skin(subVerBtn, !on_path);
}

function sub_select(n) {
	sub_current = n;
	sub_apply();
}

subPathBtn.oncommand = function(id, event) {
	// 已经在这一页：什么都不做（重复 sub_apply 会让整页控件重画一次，看着像闪）
	if (sub_current == 1) return;

	sub_select(1);
}

subVerBtn.oncommand = function(id, event) {
	if (sub_current == 2) return;

	sub_select(2);
}

sub_apply();

