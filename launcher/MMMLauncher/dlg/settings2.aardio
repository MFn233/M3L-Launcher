// ---------- 子页切换 ----------

var sub_current = 1;   // 1 = 路径，2 = 版本

// 两个状态都常驻底色：未选中浅灰、选中深一档。
// 不做"透明、悬停才出底色"——那样看起来像两个普通文字，不像可切换的页签。
function sub_btn_skin(ctrl, selected) {
	if (selected) {
		ctrl.skin({
			background = { default = m3theme.SIDEBAR_SEL; hover = m3theme.SIDEBAR_SEL; active = m3theme.SIDEBAR_SEL };
			color = { default = m3theme.INK; hover = m3theme.INK; active = m3theme.INK };
		});
	}
	else {
		ctrl.skin({
			background = { default = m3theme.SIDEBAR; hover = m3theme.SIDEBAR_HOVER; active = m3theme.SIDEBAR_SEL };
			color = { default = m3theme.MUTED; hover = m3theme.INK; active = m3theme.INK };
		});
	}
}

function sub_apply() {
	// 两个子页加起来几十个控件，逐个改 visible 会闪；包一层重绘抑制。
	// 嵌在 select_page 的 batched 里也不会重复开关（batched 支持嵌套）。
	m3layout.batched(winform, function() {
		var on_path = (sub_current == 1);

		for i, c in SP.controls {
			c.visible = on_path;
		}
		for i, c in SV.controls {
			c.visible = !on_path;
		}

		sub_btn_skin(subPathBtn, on_path);
		sub_btn_skin(subVerBtn, !on_path);
	});
}

function sub_select(n) {
	sub_current = n;
	sub_apply();
}

subPathBtn.oncommand = function(id, event) {
	// 已经在这一页：什么都不做（重复 sub_apply 会让整页控件重画一次，看着像闪）
	if (sub_current == 1) return;

	sub_select(1);
}

subVerBtn.oncommand = function(id, event) {
	if (sub_current == 2) return;

	sub_select(2);
}

sub_apply();

// ---------- 第五页之二：版本独立设置（设置 / Mod 两个子页） ----------
//
// 这两个子页都属于"某个版本"：设置只存与全局不同的项（versions\<版本名>\.m3l.options.json），
// Mod 是该版本 mods 目录里的文件。所以共用顶部同一个版本下拉。
//
// 设置：勾上的项才写文件；改动先攒在 ver_pending 里，点「保存」才落盘。
// Mod：启用/禁用就是给文件名加/去掉 .disabled，立即生效（不需要保存）。

var PV = m3layout.create(winform, 232, 52, 504, { framed = false });
