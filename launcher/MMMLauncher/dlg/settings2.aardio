btnSave={cls="plus";text="保存";left=684;top=528;right=784;bottom=560;font=LOGFONT(name='Microsoft YaHei';h=-13);z=50}
)
/*}}*/

// ---------- 主题 ----------

// 分组框：1px 边框 + 窗口底色，标题压在框线上
function frame(ctrl) {
	ctrl.skin({
		background = { default = m3theme.BG };
		border = { color = 0xFFDCDCDC; width = 1; radius = 0 };
	});
}

var frames = { winform.frameAcc; winform.frameMem; winform.frameWin; winform.frameJava; winform.framePath;
	winform.frameBehave; winform.framePri; winform.frameManage };
for i, c in frames { frame(c); }

var caps = { winform.capAcc; winform.capMem; winform.capWin; winform.capJava; winform.capPath;
	winform.capBehave; winform.capPri; winform.capManage };
for i, c in caps { m3theme.ink(c); }

m3theme.note(winform.lblUser);
m3theme.note(winform.lblLogin);
m3theme.note(winform.lblMB);
m3theme.note(winform.lblWin);
m3theme.note(winform.lblX);
m3theme.note(winform.lblJava);
m3theme.note(winform.lblPath);
m3theme.note(winform.lblPri);
m3theme.note(winform.lblManageNote);
m3theme.note(winform.lblHint);

m3theme.field(winform.editMem);
m3theme.field(winform.editW);
m3theme.field(winform.editH);
m3theme.field(winform.editJava);

m3theme.slider(winform.slider);
winform.slider.setTrackbarRange(512, 16384);

m3theme.button(winform.btnUser);
m3theme.button(winform.btnAuto);
m3theme.button(winform.btnDefault);
m3theme.button(winform.btnJavaM);
m3theme.button(winform.btnPathsM);
m3theme.button(winform.btnVersionsM);
m3theme.button(winform.btnAccountsM);
m3theme.button(winform.btnSave);
m3theme.button(winform.btnCancel);

// ---------- 数据 ----------

var cfg = null;
var paths = {};
var path_dirs = {};
var syncing = false;

function user_summary(c) {
	if (#c.username == 0) return "尚未配置账号";

	var acc = m3config.find_account(c, c.username);

	var type_text = "离线登录";
	if (acc and (acc.type == "msa" or acc.type == "mojang")) type_text = "正版登录";

	return type_text ++ "：" ++ c.username;
}

function mode_index(m) {
	if (m == "fullscreen") return 2;
	if (m == "match") return 3;
	return 1;
}

function priority_index(p) {
	if (p == "idle") return 1;
	if (p == "below") return 2;
	if (p == "above") return 4;
	if (p == "high") return 5;
	return 3;
}

function priority_value(i) {
	if (i == 1) return "idle";
	if (i == 2) return "below";
	if (i == 4) return "above";
	if (i == 5) return "high";
	return "normal";
}

function update_mode_ui() {
	var manual = (winform.comboMode.selIndex == 1);
	winform.editW.disabled = !manual;
	winform.editH.disabled = !manual;
}

function first_version(dir) {
	if (!dir) return null;

	var vdir = io.joinpath(dir, "versions");
	if (!io.exist(vdir)) return null;

	var files, folders = fsys.list(vdir);
	if (#folders == 0) return null;

	return folders[1];
}

function has_version(dir, name) {
	var vdir = io.joinpath(dir, "versions");
	if (!io.exist(vdir)) return false;

	var files, folders = fsys.list(vdir);
	for(i = 1; #folders; 1) {
		if (folders[i] == name) return true;
	}

	return false;
}

// combobox 的 add 不返回索引，用平行数组记住每项对应的路径
function refresh_path_combo() {
	winform.comboPath.clear();
	path_dirs = {};

	for i, p in paths {
		var label = p.name;
		if (!label or #label == 0) label = p.dir;

		winform.comboPath.add(label);
		table.push(path_dirs, p.dir);

		if (p.dir == cfg.game_path) winform.comboPath.selIndex = #path_dirs;
	}
}

function selected_path() {
	var i = winform.comboPath.selIndex;
	if (i <= 0) return null;
	return path_dirs[i];
}

// ---------- 分页 ----------

// 每一页包含的控件：分组框、标题、以及页内控件
var PAGES = {
	{
		winform.frameAcc; winform.capAcc; winform.lblUser; winform.btnUser; winform.lblLogin;
		winform.frameMem; winform.capMem; winform.slider; winform.editMem; winform.lblMB; winform.btnAuto;
		winform.frameWin; winform.capWin; winform.lblWin; winform.comboMode; winform.editW;
		winform.lblX; winform.editH; winform.btnDefault;
		winform.frameJava; winform.capJava; winform.lblJava; winform.editJava;
		winform.framePath; winform.capPath; winform.lblPath; winform.comboPath;
	};
	{
		winform.frameBehave; winform.capBehave; winform.chkLog; winform.chkHide;
		winform.chkStatus; winform.chkDebug; winform.chkMulti; winform.chkShot;
		winform.framePri; winform.capPri; winform.lblPri; winform.comboPri;
	};
	{
		winform.frameManage; winform.capManage; winform.btnJavaM; winform.btnPathsM;
		winform.btnVersionsM; winform.btnAccountsM; winform.lblManageNote;
	};
};

function show_page(n) {
	for i, page in PAGES {
		for k, ctrl in page {
			ctrl.visible = (i == n);
		}
	}
}

winform.listNav.add("游戏");
winform.listNav.add("启动器");
winform.listNav.add("管理");
winform.listNav.selIndex = 1;
show_page(1);

winform.listNav.onSelChange = function() {
	var i = winform.listNav.selIndex;
	if (i <= 0) return;
	show_page(i);
}

// ---------- 事件 ----------

winform.slider.onPosChanged = function(pos, triggeredByUser) {
	if (!triggeredByUser) return;
	if (syncing) return;

	syncing = true;
	winform.editMem.text = tostring(pos);
	syncing = false;
}

winform.editMem.onChange = function() {
	if (syncing) return;

	var v = tonumber(string.trim(winform.editMem.text));
	if (!v) return;

	if (v < 512) v = 512;
	if (v > 16384) v = 16384;

	syncing = true;
	winform.slider.progressPos = v;
	syncing = false;
}

winform.comboMode.onSelChange = function() {
	update_mode_ui();
}

winform.comboPath.onSelChange = function() {
	var dir = selected_path();
	if (!dir) return;
	if (dir == cfg.game_path) return;

	var c = m3config.read();
	c.game_path = dir;

	if (!has_version(dir, c.version)) {
		var v = first_version(dir);
		if (v) c.version = v;
		else c.version = "";
	}

	m3config.save_keys(c, {"game_path"; "version"});

	cfg = m3config.read();
	winform.lblHint.text = "当前游戏路径已切换：" ++ dir;
}

winform.btnAuto.oncommand = function(id, event) {
	var status = sys.mem.getStatus();
	var total_mb = math.floor(status.totalPhys / 1048576);

	var mb = math.floor(total_mb / 4 / 256) * 256;
	if (mb < 1024) mb = 1024;
	if (mb > 8192) mb = 8192;

	winform.editMem.text = tostring(mb);
	winform.slider.progressPos = mb;
	winform.lblHint.text = "按物理内存的 1/4 建议：" ++ mb ++ " MB（本机共 " ++ total_mb ++ " MB）";
}

winform.btnDefault.oncommand = function(id, event) {
	winform.editW.text = "854";
	winform.editH.text = "480";
	winform.lblHint.text = "已设为默认窗口大小 854 × 480。";
}

// 三个管理入口都在独立窗口里，回来后重读配置
winform.btnJavaM.oncommand = function(id, event) {
	winform.loadForm("/dlg/java.aardio").doModal(winform);

	cfg = m3config.read();
	winform.editJava.text = cfg.java;
}

winform.btnPathsM.oncommand = function(id, event) {
	winform.loadForm("/dlg/paths.aardio").doModal(winform);

	cfg = m3config.read();
	paths = cfg.game_paths;
	refresh_path_combo();
}

winform.btnVersionsM.oncommand = function(id, event) {
	winform.loadForm("/dlg/versions.aardio").doModal(winform);

	cfg = m3config.read();
	paths = cfg.game_paths;
}

winform.btnAccountsM.oncommand = function(id, event) {
	winform.loadForm("/dlg/accounts.aardio").doModal(winform);

	cfg = m3config.read();
	winform.lblLogin.text = user_summary(cfg);
}

// 游戏页的「用户配置」和「管理」页的那个是同一个窗口
winform.btnUser.oncommand = function(id, event) {
	winform.loadForm("/dlg/accounts.aardio").doModal(winform);

	cfg = m3config.read();
	winform.lblLogin.text = user_summary(cfg);
}

winform.btnSave.oncommand = function(id, event) {
	var c = m3config.read();

	var mb = tonumber(string.trim(winform.editMem.text)) or c.memory;
	if (mb < 512) mb = 512;
	if (mb > 32768) mb = 32768;
	c.memory = mb;

	var dir = selected_path();
	if (dir) c.game_path = dir;

	if (#c.game_path > 0 and !has_version(c.game_path, c.version)) {
		var v = first_version(c.game_path);
		if (v) c.version = v;
		else c.version = "";
	}

	c.java = string.trim(winform.editJava.text);

	c.width = tonumber(string.trim(winform.editW.text)) or 854;
	c.height = tonumber(string.trim(winform.editH.text)) or 480;
	if (c.width < 320) c.width = 320;
	if (c.height < 240) c.height = 240;

	var mi = winform.comboMode.selIndex;
	if (mi == 2) c.window_mode = "fullscreen";
	elseif (mi == 3) c.window_mode = "match";
	else c.window_mode = "manual";

	c.priority = priority_value(winform.comboPri.selIndex);

	c.log = winform.chkLog.checked;
	c.hide_after_launch = winform.chkHide.checked;
	c.status_bar = winform.chkStatus.checked;
	c.debug = winform.chkDebug.checked;
	c.allow_multi = winform.chkMulti.checked;
	c.shot_tip = winform.chkShot.checked;

	m3config.save(c);
	winform.endModal(true);
}

winform.btnCancel.oncommand = function(id, event) {
	winform.endModal(false);
}

winform.onOk = function() {
	winform.btnSave.oncommand();
}

winform.onCancel = function() {
	winform.btnCancel.oncommand();
}

// ---------- 初始化 ----------

cfg = m3config.read();
paths = cfg.game_paths;

winform.lblLogin.text = user_summary(cfg);

winform.editMem.text = tostring(cfg.memory);
winform.editJava.text = cfg.java;
winform.editW.text = tostring(cfg.width);
winform.editH.text = tostring(cfg.height);

winform.chkLog.checked = cfg.log;
winform.chkHide.checked = cfg.hide_after_launch;
winform.chkStatus.checked = cfg.status_bar;
winform.chkDebug.checked = cfg.debug;
winform.chkMulti.checked = cfg.allow_multi;
winform.chkShot.checked = cfg.shot_tip;

winform.comboMode.add("手动设置");
winform.comboMode.add("全屏");
winform.comboMode.add("与启动器一致");
winform.comboMode.selIndex = mode_index(cfg.window_mode);
update_mode_ui();

winform.comboPri.add("低");
winform.comboPri.add("较低");
winform.comboPri.add("正常");
winform.comboPri.add("较高");
winform.comboPri.add("高");
winform.comboPri.selIndex = priority_index(cfg.priority);

refresh_path_combo();

var mb = cfg.memory;
if (mb < 512) mb = 512;
if (mb > 16384) mb = 16384;
winform.slider.progressPos = mb;

winform.lblManageNote.text = "Java 管理：检测与选择 Java、加入黑名单。" ++ '\r\n'
	++ "路径管理：添加多个 .minecraft 路径、命名、删除。" ++ '\r\n'
	++ "版本管理：切换当前版本、隔离、重命名、删除。" ++ '\r\n'
	++ "用户配置：离线账号与 UUID。";

return winform;
