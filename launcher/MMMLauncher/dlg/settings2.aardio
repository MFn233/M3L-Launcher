tipPvJava.add(comboPvJava, "跟随全局：使用「Java 管理」里选定的 Java。手动指定：只对这个版本生效。");
tipPvJava.add(lblPvJava, "可写相对路径，以版本文件夹为起点（例如 jre/bin/java.exe），也可以只写 jre。");
tipPvJava.add(editPvJava, "可写相对路径，以版本文件夹为起点（例如 jre/bin/java.exe），也可以只写 jre。");

PVA.y = PVA.y + PVA.row_step;

//「跟随全局」到底跟哪个：直接把全局 Java 写出来，省得再猜
var lblPvJavaHint = PVA.text("", true);

var chkJvm = PVA.make({
	cls = "checkbox";
	text = "JVM 参数（每行一条）";
	left = PVA.left;
	top = PVA.y;
	right = PVA.left + 240;
	bottom = PVA.y + 20;
});

chkJvm.bgcolor = m3theme.C_BG;
PVA.y = PVA.y + PVA.row_step;

var editPvJvm = PVA.make({
	cls = "edit";
	multiline = 1;
	vscroll = 1;
	autohscroll = false;
	left = PVA.left;
	top = PVA.y;
	right = PVA.right;
	bottom = PVA.y + 56;
});

editPvJvm.color = m3theme.C_INK;
editPvJvm.bgcolor = m3theme.C_FIELD;

PVA.y = PVA.y + 56 + 8;

// 版本级开关（没有全局对应项）：勾上就写进这个版本的覆盖文件
var chkSkip = PVA.check("关闭文件校验（跳过「缺少库文件」的检查）", false);

PVA.text("勾选的设置项将覆盖全局设置。", true);
var lblPvHint = PVA.text("", true);

PVA.finish();

// ---------- 子页二：Mod ----------

var PM = m3layout.create(winform, 232, SUB2_BODY_TOP, 504, { framed = true });
PM.btn_w = 76;

PM.section("");

var listMods = PM.make({
	cls = "listview";
	left = 232;
	top = PM.y;
	right = 736;
	bottom = PM.y + 236;
});

listMods.fullRow = true;

// # 由 m3list.setup 补在最前面；这四列 468 + 36 = 504，正好占满
var mod_cols = {
	{ "名字"; 200 };
	{ "版本"; 90 };
	{ "文件名"; 130 };
	{ "状态"; 48 };
};

m3list.setup(listMods, mod_cols, true);
m3list.fit(listMods);
try_thin_scrollbar(listMods);

PM.y = PM.y + 236 + 8;

var mod_tools = PM.tool_row({"启用"; "删除"; "刷新"}, {"打开目录"});

// 扫描进度：轨道 + 填充两根 static。
// 不用 plus 的 trackbar——它自带滑块、用户能拖；static 没有交互，拖不动。
// 读取已经压到毫秒级，这里只是给"逐条补全"一个可见的进度。
var PROG_H = 4;
var PROG_GAP = 8;

var progTrack = PM.make({
	cls = "static";
	left = PM.left;
	top = PM.y;
	right = PM.right;
	bottom = PM.y + PROG_H;
	bgcolor = m3theme.C_LINE;
});

var progFill = PM.make({
	cls = "static";
	left = PM.left;
	top = PM.y;
	right = PM.left + 1;
	bottom = PM.y + PROG_H;
	bgcolor = m3theme.C_INK;
});

progTrack.visible = false;
progFill.visible = false;

PM.y = PM.y + PROG_H + PROG_GAP;

var lblModHint = PM.text("", true);

PM.finish();

// 两个子页的控件都要进 PV 的清单，切页时才跟着显隐
for k, c in { PVA } {
	for n, ctrl in c.controls {
		table.push(PV.controls, ctrl);
	}
}
for k, c in { PM } {
	for n, ctrl in c.controls {
		table.push(PV.controls, ctrl);
	}
}

// ---------- 子页切换 ----------

var pv_sub = 1;   // 1 = 设置，2 = Mod

function pv_sub_apply() {
	var on_cfg = (pv_sub == 1);

	m3layout.batched(winform, function() {
		for i, c in PVA.controls {
			c.visible = on_cfg;
		}
		for i, c in PM.controls {
			c.visible = !on_cfg;
		}

		sub_btn_skin(subCfgBtn, on_cfg);
		sub_btn_skin(subModBtn, !on_cfg);
	});
}

function pv_sub_select(n) {
	if (pv_sub == n) return;

	pv_sub = n;
	pv_sub_apply();

	if (n == 2) mods_render();
}

subCfgBtn.oncommand = function(id, event) {
	pv_sub_select(1);
}

subModBtn.oncommand = function(id, event) {
	pv_sub_select(2);
}

// ---------- 版本独立设置：数据 ----------

var pv_current = null;     // 页面上正在显示哪个版本
var pv_versions = {};      // 下拉里各项对应的版本名
var ver_pending = {};      // 版本名 -> 待保存的覆盖表（点保存才落盘）

function pv_mode_value(i) {
	if (i == 2) return "fullscreen";
	if (i == 3) return "match";
	return "manual";
}

function pv_sync_enabled() {
	editPvMem.disabled = !chkMem.checked;
	comboPvMode.disabled = !chkMode.checked;
	editPvW.disabled = !chkW.checked;
	editPvH.disabled = !chkH.checked;
	comboPvPri.disabled = !chkPri.checked;
	editPvJvm.disabled = !chkJvm.checked;

	var manual = (comboPvJava.selIndex == 2);
	editPvJava.disabled = !manual;
	btnPvJava.disabled = !manual;

	lblPvJavaHint.text = "跟随全局时使用：" ++ (cfg.java or "由启动器按版本自动选择");
}

function pv_fill_versions() {
	var names = list_version_names();

	// 当前版本排最前：下拉列表展开时会自动滚到"选中项"，
	// 它要是在中间，前面那些版本就被滚出视野了（用户以为"版本不见了"）。
	var ordered = {};
	if (cfg.version and has_version(cfg.game_path, cfg.version)) {
		table.push(ordered, cfg.version);
	}
	for i, name in names {
		if (name != cfg.version) table.push(ordered, name);
	}

	comboOptVer.clear();
	pv_versions = {};

	for i, name in ordered {
		comboOptVer.add(name);
		table.push(pv_versions, name);
	}

	return ordered;
}

// 填表期间不要标脏：程序设置控件也会触发 change 通知
var pv_filling = false;

// 把某个版本的值填进控件（先看有没有待保存的覆盖，再看磁盘上的文件）
function pv_load(name) {
	pv_filling = true;
	pv_current = name;

	var ov = ver_pending[name];
	if (!ov) ov = m3opts.read(cfg.game_path, name);

	var has_mem = (ov.memory !== null);
	chkMem.checked = has_mem;
	editPvMem.text = tostring(has_mem ? ov.memory : cfg.memory);

	var has_mode = (ov.window_mode !== null);
	chkMode.checked = has_mode;
	var mode_text = has_mode ? ov.window_mode : cfg.window_mode;
	comboPvMode.selIndex = mode_index(mode_text);

	var has_w = (ov.width !== null);
	chkW.checked = has_w;
	editPvW.text = tostring(has_w ? ov.width : cfg.width);

	var has_h = (ov.height !== null);
	chkH.checked = has_h;
	editPvH.text = tostring(has_h ? ov.height : cfg.height);

	var has_pri = (ov.priority !== null);
	chkPri.checked = has_pri;
	comboPvPri.selIndex = priority_index(has_pri ? ov.priority : cfg.priority);

	var has_java = (ov.java !== null);
	comboPvJava.selIndex = has_java ? 2 : 1;
	editPvJava.text = has_java ? ov.java : "";

	var has_jvm = (ov.jvm_args !== null);
	chkJvm.checked = has_jvm;
	editPvJvm.text = has_jvm ? ov.jvm_args : (cfg.jvm_args or "");

	chkSkip.checked = (ov.skip_check === true);

	pv_sync_enabled();

	var n = 0;
	for k, v in ov {
		if (v !== null) n = n + 1;
	}

	if (n == 0) {
		lblPvHint.text = "此版本没有独立设置。";
	}
	else {
		lblPvHint.text = "这个版本有 " ++ n ++ " 项独立设置。";
	}

	pv_filling = false;
}

// 从控件收集成覆盖表（没勾的键不写 = 跟随全局）
function pv_collect() {
	var t = {};

	if (chkMem.checked) {
		var mb = tonumber(string.trim(editPvMem.text)) or cfg.memory;
		if (mb < 512) mb = 512;
		if (mb > 32768) mb = 32768;
		t.memory = mb;
	}

	if (chkMode.checked) t.window_mode = pv_mode_value(comboPvMode.selIndex);

	if (chkW.checked) {
		var w = tonumber(string.trim(editPvW.text)) or cfg.width;
		if (w < 320) w = 320;
		t.width = w;
	}

	if (chkH.checked) {
		var h = tonumber(string.trim(editPvH.text)) or cfg.height;
		if (h < 240) h = 240;
		t.height = h;
	}

	if (chkPri.checked) t.priority = priority_value(comboPvPri.selIndex);

	if (comboPvJava.selIndex == 2) {
		var jp = string.trim(editPvJava.text);
		if (#jp > 0) t.java = jp;
	}

	if (chkJvm.checked) t.jvm_args = editPvJvm.text;

	if (chkSkip.checked) t.skip_check = true;

	return t;
}

// 切走之前先把当前版本的值收进待保存表
function pv_stash() {
	if (pv_current) ver_pending[pv_current] = pv_collect();
}

// 切版本：先收当前，再按新版本填（Mod 列表也跟着换）
function pv_switch_to(name) {
	if (!name) return;
	if (name == pv_current) return;

	pv_stash();
	pv_load(name);

	if (pv_sub == 2) mods_render();
}

// 重新读一遍版本列表（切路径、增删版本、打开这一页时用）
function pv_refresh() {
	var names = pv_fill_versions();

	if (#names == 0) {
		pv_current = null;
		lblPvHint.text = "当前游戏目录下没有版本。";
		lblModHint.text = "当前游戏目录下没有版本。";
		return;
	}

	// 尽量保持当前选择；不在列表里就退回当前版本，再不行用第一个
	var want = pv_current;
	if (!want or !has_version(cfg.game_path, want)) {
		if (cfg.version and has_version(cfg.game_path, cfg.version)) want = cfg.version;
		else want = names[1];
	}

	var at = 0;
	for i, v in pv_versions {
		if (v == want) {
			at = i;
			break;
		}
	}

	if (at > 0) comboOptVer.selIndex = at;

	var changed = (want != pv_current);
	pv_load(want);

	if (changed and pv_sub == 2) mods_render();
}

comboOptVer.onSelChange = function() {
	var i = comboOptVer.selIndex;
	if (i <= 0 or i > #pv_versions) return;

	pv_switch_to(pv_versions[i]);
}

for i, c in { chkMem; chkMode; chkW; chkH; chkPri; chkJvm } {
	c.oncommand = function(id, event) {
		pv_sync_enabled();
		mark_dirty();
	};
}

comboPvJava.oncommand = function(id, event) {
	pv_sync_enabled();

	if (!pv_filling) mark_dirty();
}

//选择 java.exe：以版本文件夹为起点打开，选中的若是版本目录内的文件，就存成相对路径
btnPvJava.oncommand = function(id, event) {
	var start = cfg.game_path;
	if (pv_current) start = io.joinpath(cfg.game_path, "versions", pv_current);

	var f = fsys.dlg.open("可执行文件|*.exe|所有文件|*.*|", "选择 java.exe", start, winform, , "java.exe");
	if (!f) return;

	var vdir = (pv_current ? io.joinpath(cfg.game_path, "versions", pv_current) : null);

	//在版本目录里就写相对路径（方便整个版本文件夹搬家），否则写绝对路径
	var rel = null;
	if (vdir) rel = string.replace(f, vdir ++ '\\', "");

	if (rel and #rel < #f and string.slice(rel, 2, 2) != ":") {
		editPvJava.text = rel;
	}
	else {
		editPvJava.text = f;
	}

	comboPvJava.selIndex = 2;
	pv_sync_enabled();
	mark_dirty();
}

editPvJava.onFocusLost = function() {
	if (!pv_filling) mark_dirty();
}

chkSkip.oncommand = function(id, event) {
	mark_dirty();
};

comboPvMode.add("手动设置");
comboPvMode.add("全屏");
comboPvMode.add("与启动器一致");

comboPvPri.add("低");
comboPvPri.add("较低");
comboPvPri.add("正常");
comboPvPri.add("较高");
comboPvPri.add("高");

// ---------- Mod 列表 ----------

var mod_rows = {};        // 与列表顺序一致：scan() 出来的条目
var mod_dup_rows = {};    // 重复安装的行号（1 基），自定义绘制时标红
var mod_todo = {};        // 这一轮需要读的行号
var mod_meta_reasons = {}; // 读不到元数据的原因统计
var mod_scan_got = false; // 后台线程有没有回过话（看门狗用）
var mod_scan_error = "";  // 后台线程报的错
var mod_scan_syncing = false;
var mod_jobs_left = 0;    // 还有几个 worker 没干完
var mod_selected = null;  // 选中的条目（按 path 记）

// 只有选中"已禁用"的 Mod 时，按钮才叫「启用」；否则叫「禁用」
function mod_btn_update() {
	var btn = mod_tools.left[1];
	if (!btn) return;

	var hit = null;
	if (mod_selected) {
		for i, m in mod_rows {
			if (m.path == mod_selected) {
				hit = m;
				break;
			}
		}
	}

	if (hit and !hit.enabled) btn.text = "启用";
	else btn.text = "禁用";
}

// ---------- Mod 元数据：先出列表，再后台分批补 ----------
//
// 一次读完几百个 jar 的元数据会卡住界面，所以：
//   1) 先按文件名把列表铺出来（立刻可见）；
//   2) 每 20ms 读 4 个，就地刷新那两列，进度条同步走；
//   3) 读完后走一次 mods_render_final()（缓存已热，瞬间完成），
//      这一次才做"按名字排序"和"重复标红"。
// 切换版本/页签会让 mod_scan_gen +1，正在跑的任务下次 tick 自己退出。

var mod_scan_gen = 0;     // 每次重画 +1，用来作废旧任务
var mod_scan_done = 0;    // 已完成数（进度条被误拖时用它复位）

function mod_scan_cancel() {
	mod_scan_gen = mod_scan_gen + 1;
}

// 把某行的元数据填进列表
function mod_fill_row(idx, meta) {
	if (!mod_rows[idx]) return;

	var m = mod_rows[idx];

	// 诊断信息挂到行上（读不到元数据时落盘用）
	m.err = meta.err or "";
	m.tried = meta.tried or "";

	// 失败原因计数（底部提示用）
	if (meta.err) {
		var tag = "解析不出名字";
		if (string.indexOf(meta.err, "打不开")) tag = "打不开压缩包";
		elseif (string.indexOf(meta.err, "没有元数据")) tag = "没有元数据条目";

		mod_meta_reasons[tag] = (mod_meta_reasons[tag] or 0) + 1;
	}

	m.modid = meta.modid or "";
	m.title = meta.name or "";
	m.mver = meta.version or "";

	// 缓存存**原始**值：回退成文件名只用于显示，别写进缓存（否则以后没法判断真假）
	m3mod.cache_put(m.path, {
		modid = m.modid;
		name = meta.name or "";
		version = meta.version or "";
		loader = meta.loader or "";
	});

	if (#m.title == 0) m.title = m.name;
	if (#m.mver == 0) m.mver = "-";

	// 就地只改两格（不重排）：先铺文件名、再逐条补全真名就是这个效果
	listMods.setItemText(m.title, idx, 2);
	listMods.setItemText(m.mver, idx, 3);
}

// 进度条：显示 / 更新 / 收起
function mod_prog_show(total) {
	progFill.width = 1;
	progTrack.visible = true;
	progFill.visible = true;
}

function mod_prog_update(done, total) {
	if (total <= 0) return;

	var full = progTrack.width;
	var w = ..math.floor(full * done / total);
	if (w < 1) w = 1;
	if (w > full) w = full;

	progFill.width = w;
}

function mod_prog_hide() {
	progTrack.visible = false;
	progFill.visible = false;
}

// 扫描结果先落盘（mod-scan.txt），再读回来一次性显示。
// 为什么这样做：listview 每改一格都会整表重绘，扫描期间边读边填实测是分钟级的元凶；
// 落盘还能顺便把耗时统计留下来，排查时直接看文件。
var mod_scan_stats = null;
var mod_scan_file_path = null;

function mod_scan_file() {
	if (!mod_scan_file_path) mod_scan_file_path = ..io.fullpath("/mod-scan.txt");

	return mod_scan_file_path;
}

function mods_render() {
	mod_scan_cancel();
	var gen = mod_scan_gen;

	listMods.clear();
	mod_rows = {};
	mod_dup_rows = {};
	mod_todo = {};
	mod_scan_stats = null;

	mod_scan_done = 0;
	mod_meta_reasons = {};

	if (!pv_current) {
		lblModHint.text = "请先在设置窗口里选择游戏路径。";
		m3list.renumber(listMods);
		mod_btn_update();
		return;
	}

	var dir = m3mod.dir_of(cfg, pv_current);

	if (!dir or !io.exist(dir)) {
		lblModHint.text = "此版本没有 mods 文件夹：" ++ tostring(dir);
		m3list.renumber(listMods);
		mod_btn_update();
		return;
	}

	m3mod.cache_load();

	var list = m3mod.scan(dir);

	// 先把列表铺出来（名字先用文件名），再逐条补全真名。
	// 一次性 addItem 比"边读边插行"稳，且不会让行号乱跳。
	m3layout.batched(winform, function() {
		for i, m in list {
			m.modid = "";
			m.title = m.name;
			m.mver = "-";
			m.err = "";
			m.tried = "";

			var status = "启用";
			if (!m.enabled) status = "禁用";

			listMods.addItem({ ""; m.title; m.mver; m.file; status });
			table.push(mod_rows, m);
		}

		m3list.renumber(listMods);
	});

	if (#mod_rows == 0) {
		lblModHint.text = "此版本未安装 Mod。";
		mod_btn_update();
		return;
	}

	// 缓存里有的先填上（第二次进页面基本全命中），剩下的排队
	for i, m in mod_rows {
		var meta = m3mod.cache_peek(m.path);

		if (meta) {
			mod_fill_row(i, meta);
			mod_scan_done = mod_scan_done + 1;
		}
		else {
			table.push(mod_todo, i);
		}
	}

	mod_prog_show(#mod_rows);
	mod_prog_update(mod_scan_done, #mod_rows);

	if (#mod_todo == 0) {
		mod_prog_hide();
		mod_write_scan_file(dir);
		mods_render_final();
		return;
	}

	lblModHint.text = "正在读取 Mod 信息… " ++ mod_scan_done ++ "/" ++ #mod_rows;

	var at = 1;
	var t_start = ..time.tick();
	var t_meta = 0;
	var slow = {};      // 每条 >=30ms 的记一行，最后取最慢的 5 个

	m3mod.stats_reset();

	var step;
	step = function() {
		if (gen != mod_scan_gen) return;

		// 时间片：一次最多占 40ms，剩下的下一拍继续
		var deadline = ..time.tick() + 40;

		while (at <= #mod_todo and ..time.tick() < deadline) {
			var idx = mod_todo[at];
			var t1 = ..time.tick();

			var meta = m3mod.meta_of(mod_rows[idx].path);

			var ms = ..time.tick() - t1;
			t_meta = t_meta + ms;

			if (ms >= 30) {
				// 存成表，别拼字符串再解析回来（拼了又要 indexOf 找分隔符，容易踩空）
				table.push(slow, { ms = ms; file = mod_rows[idx].file });
			}

			m3mod.cache_put(mod_rows[idx].path, meta);
			mod_fill_row(idx, meta);

			mod_scan_done = mod_scan_done + 1;
			at = at + 1;
		}

		mod_prog_update(mod_scan_done, #mod_rows);
		lblModHint.text = "正在读取 Mod 信息… " ++ mod_scan_done ++ "/" ++ #mod_rows;

		if (at <= #mod_todo) {
			winform.setTimeout(step, 1);
			return;
		}

		m3mod.cache_save();

		// 取最慢的 5 个：造"零填充毫秒 + 序号"的排序键，再按 key 取回表
		var keyed = {};
		var keys = {};

		for i, r in slow {
			var k = string.format("%08d", r.ms) ++ "\t" ++ i;
			keyed[k] = r;
			table.push(keys, k);
		}

		table.sort(keys);

		var top = {};

		//递减要写 end 值，不能写条件：aardio 是 for(起, 止, 步)
		for i = #keys; 1; -1 {
			if (#top >= 5) break;

			var r = keyed[keys[i]];
			if (!r) break;

			table.push(top, string.format("%6dms  %s", r.ms, r.file));
		}

		mod_scan_stats = {
			total = ..time.tick() - t_start;
			meta = t_meta;
			slow = top;
			st = m3mod.stats_get();
		};

		mod_prog_hide();
		mod_write_scan_file(dir);
		mods_render_final();
	};

	step();
}

// 写成一行一条，行首 # 是统计信息（读回来时跳过）
function mod_write_scan_file(dir) {
	var lines = {};

	table.push(lines, "#dir=" ++ tostring(dir));
	table.push(lines, "#rows=" ++ #mod_rows);

	if (mod_scan_stats) {
		table.push(lines, "#ms_total=" ++ mod_scan_stats.total ++ "  #ms_meta=" ++ mod_scan_stats.meta);

		var st = mod_scan_stats.st;
		if (st) {
			// scan = m3zip 读中央目录的总耗时；fallback = 退回 zlib.unzip 的包数（应为 0）
			table.push(lines, "#ms_breakdown: scan=" ++ (st.scan - st.open) ++ "  parse=" ++ st.parse
				++ "  fallback_ms=" ++ st.open ++ "  fallback_n=" ++ st.fallback);
		}

		for i, s in mod_scan_stats.slow {
			table.push(lines, "#slow=" ++ s);
		}
	}

	for i, m in mod_rows {
		var en = "0";
		if (m.enabled) en = "1";

		table.push(lines, table.concat({
			m.path or "";
			m.file or "";
			m.name or "";
			m.title or "";
			m.mver or "-";
			m.modid or "";
			en;
		}, '\t'));
	}

	try {
		string.save(mod_scan_file(), table.concat(lines, '\r\n'));
	}
	catch(e) {
	}
}

function mods_render_final() {

	if (#mod_rows == 0) {
		listMods.clear();

		if (!pv_current) lblModHint.text = "请先在设置窗口里选择游戏路径。";
		else lblModHint.text = "此版本未安装 Mod。";

		m3list.renumber(listMods);
		mod_btn_update();
		return;
	}

	// 这里**不再**重扫目录、不再重读元数据：
	// mod_rows 里已经是"名字 / 版本 / modid 都填好"的了，只是顺序还是文件名顺序。
	var rows = mod_rows;

	// 同一个 modid 出现多次 = 重复安装
	var seen = {};

	for i, m in rows {
		if (#m.modid == 0) continue;
		seen[m.modid] = (seen[m.modid] or 0) + 1;
	}

	// 排序：启用在前，组内按名字升序（造字符串键，不用 table.sort 的比较函数）
	var keyed = {};
	var keys = {};

	for i, m in rows {
		var prefix = "1";          // 1 = 禁用，排在后面
		if (m.enabled) prefix = "0";

		var k = prefix ++ string.lower(m.title) ++ '\t' ++ tostring(i);
		keyed[k] = m;
		table.push(keys, k);
	}

	table.sort(keys);

	// 一次性重建列表（关掉中间重绘，最后只画一次）
	var off = 0;

	m3layout.batched(winform, function() {
		listMods.clear();
		mod_rows = {};
		mod_dup_rows = {};

		for i, k in keys {
			var m = keyed[k];

			var status = "启用";
			if (!m.enabled) {
				status = "禁用";
				off = off + 1;
			}

			var dup = (#m.modid > 0 and seen[m.modid] > 1);
			if (dup) {
				status = status ++ " 重复";
				mod_dup_rows[i] = true;
			}

			listMods.addItem({ ""; m.title; m.mver; m.file; status });
			table.push(mod_rows, m);
		}

		m3list.renumber(listMods);
	});

	// 选中项按 path 找回
	if (mod_selected) {
		var at = 0;
		for i, m in mod_rows {
			if (m.path == mod_selected) {
				at = i;
				break;
			}
		}

		if (at > 0) listMods.selIndex = at;
		else mod_selected = null;
	}

	var total = #mod_rows;

	if (total == 0) {
		lblModHint.text = "此版本未安装 Mod。";
	}
	else {
		var dups = 0;
		for k, v in mod_dup_rows {
			if (v) dups = dups + 1;
		}

		var tip = "共 " ++ total ++ " 个 Mod，禁用 " ++ off ++ " 个。";
		if (dups > 0) tip = tip ++ "有 " ++ dups ++ " 个是重复安装（同一个 modid），已标红。";

		var reasons = "";
		var reason_n = 0;

		for k, v in mod_meta_reasons {
			reason_n = reason_n + 1;

			if (#reasons > 0) reasons = reasons ++ " / ";
			reasons = reasons ++ k ++ " " ++ v;
		}

		if (#reasons > 0) tip = tip ++ "读不到元数据：" ++ reasons ++ "。";

		lblModHint.text = tip;

		// 有读不到的就把细节写到 exe 旁边的 mod-diag.txt
		if (reason_n > 0) mod_dump_diag();
	}

	mod_btn_update();
}

// 把"读不到元数据"的细节写到 mod-diag.txt：文件名 / 原因 / 试过哪些条目
function mod_dump_diag() {
	var lines = {};

	table.push(lines, "rows=" ++ #mod_rows);
	table.push(lines, "--- 读不到元数据的行（最多 15 条） ---");

	var n = 0;

	for i, m in mod_rows {
		if (#m.err == 0) continue;

		n = n + 1;
		if (n > 15) continue;

		table.push(lines, m.file ++ "  | err=" ++ m.err ++ " | tried=" ++ tostring(m.tried));
	}

	table.push(lines, "--- 共 " ++ n ++ " 条 ---");

	try {
		string.save(io.fullpath("/mod-diag.txt"), table.concat(lines, '\r\n'));
	}
	catch(e) {
	}
}

// 重复安装的行标红。
// 协议：PREPAINT 先要求 ITEMDRAW，ITEM 阶段再要求 SUBITEMDRAW，
// 到 SUBITEM 阶段改 clrText 并 update() 写回。
listMods.onnotify = function(id, code, ptr) {
	if (code != 0xFFFFFFF4/*_NM_CUSTOMDRAW*/) return;

	var lvcd = listMods.getNotifyCustomDraw(code, ptr);
	if (!lvcd) return;

	var stage = lvcd.nmcd.dwDrawStage;

	if (stage == 1/*_CDDS_PREPAINT*/) {
		return 0x20/*_CDRF_NOTIFYITEMDRAW*/;
	}

	if (stage == 0x10001/*_CDDS_ITEMPREPAINT*/) {
		// 快速通道：不是重复行就直接按默认画，
		// 不要求逐子项绘制（157 行 × 5 列都走子项绘制会很拖）
		if (!mod_dup_rows[lvcd.nmcd.dwItemSpec + 1]) return 0/*_CDRF_DODEFAULT*/;

		return 0x20/*_CDRF_NOTIFYSUBITEMDRAW*/;
	}

	if (stage == (0x10001/*_CDDS_ITEMPREPAINT*/ | 0x20000/*_CDDS_SUBITEM*/)) {
		// dwItemSpec 从 0 开始，标红表按 1 基记，所以 +1
		if (mod_dup_rows[lvcd.nmcd.dwItemSpec + 1]) {
			lvcd.clrText = 0x0000FF;   // COLORREF：红
			lvcd.update();
		}

		return 0/*_CDRF_DODEFAULT*/;
	}
}

// 当前选中的那一行对应的 Mod（没选中返回 null）
function mod_current() {
	var sel = listMods.selIndex;
	var at = 0;

	if (type(sel) == "table") at = sel[1] or 0;
	elseif (type(sel) == "number") at = sel;

	if (at < 1) return null;

	return mod_rows[at] or null;
}

listMods.onSelChanged = function(sel, item, subItem, nm) {
	var m = mod_current();
	if (m) mod_selected = m.path;

	mod_btn_update();
}

// 启用 / 禁用
mod_tools.left[1].oncommand = function(id, event) {
	var m = mod_current();
	if (!m) {
		lblModHint.text = "请先选择一个 Mod。";
		return;
	}

	var want = !m.enabled;
	var ok, err = m3mod.set_enabled(m.path, want);

	if (!ok) {
		lblModHint.text = "改名失败：" ++ tostring(err);
		return;
	}

	mod_selected = null;
	mods_render();

	if (want) lblModHint.text = "已启用：" ++ m.file;
	else lblModHint.text = "已禁用：" ++ m.file;
}

// 删除（回收站）
mod_tools.left[2].oncommand = function(id, event) {
	var m = mod_current();
	if (!m) {
		lblModHint.text = "请先选择一个 Mod。";
		return;
	}

	var frm = winform.loadForm("/dlg/confirm.aardio");
	frm.lblMsg.text = "确定删除 Mod「" ++ m.file ++ "」吗？" ++ '\r\n\r\n'
		++ "（文件将被移至回收站，可恢复）";

	if (!frm.doModal(winform)) return;

	if (!fsys.delete(m.path, true)) {
		lblModHint.text = "删除失败，游戏可能正在运行。";
		return;
	}

	mod_selected = null;
	mods_render();

	lblModHint.text = "已删除：" ++ m.file;
}

// 刷新
mod_tools.left[3].oncommand = function(id, event) {
	mods_render();
	lblModHint.text = "已刷新。" ++ lblModHint.text;
}

// 打开 mods 目录
mod_tools.right[1].oncommand = function(id, event) {
	if (!pv_current) return;

	var dir = m3mod.dir_of(cfg, pv_current);
	if (!dir or !io.exist(dir)) {
		lblModHint.text = "目录不存在：" ++ tostring(dir);
		return;
	}

	process.explore(dir);
}

pv_sync_enabled();
mod_btn_update();

// ---------- 第六页：关于 ----------

var P6 = m3layout.create(winform, 232, 92, 504, { framed = false });

var lblAboutName = winform.add({
	cls = "static";
	text = "MFn's Minimalism Mclauncher";
	left = 232; top = 52; right = 736; bottom = 82;
	font = LOGFONT(name='Microsoft YaHei'; h=-16; weight=700);
});
m3theme.ink(lblAboutName);
table.push(P6.controls, lblAboutName);

P6.text("—— 一个妄图写出完美代码的程序爱好者。", true);
P6.gap(12);
P6.text("作者：MFn。本项目遵循 GPL-3.0 协议开源。", true);
var lblAboutVer = P6.text("版本 " ++ m3app.version_text(), true);

P6.finish();

// ---------- 第七页：鸣谢 ----------

var P7 = m3layout.create(winform, 232, 52, 504, { framed = false });

// 正文用 richedit：测试者名单会变长，必须能滚动
var editCredits = winform.add({
	cls = "richedit";
	readonly = 1;
	multiline = 1;
	vscroll = 1;
	autohscroll = false;
	left = 232; top = 52; right = 736; bottom = 508;
	font = LOGFONT(name='Microsoft YaHei'; h=-12);
});
editCredits.color = m3theme.C_INK;
editCredits.bgcolor = m3theme.C_FIELD;
table.push(P7.controls, editCredits);

// 追加一行：小标题近黑，条目次要灰
function credit(text, is_heading) {
	editCredits.readonly = false;

	if (is_heading) editCredits.appendText({ textColor = m3theme.C_INK }, text ++ '\r\n');
	else editCredits.appendText({ textColor = m3theme.C_MUTED }, text ++ '\r\n');

	editCredits.readonly = true;
}

function credits_fill() {
	//正文在 lib/m3credits.aardio 里，改名单只改那个文件
	var sections = m3credits.SECTIONS;

	for i, s in sections {
		credit(s.title, true);

		for j, line in s.items {
			credit(line);
		}

		credit("");
	}

	var notes = m3credits.NOTES;

	for i, line in notes {
		credit(line, true);
	}
}

P7.finish();

// ---------- 用得到控件的函数（必须在控件声明之后） ----------

function user_summary(c) {
	if (#c.username == 0) return "尚未配置账号";

	var acc = m3config.find_account(c, c.username);

	var type_text = "离线登录";
	if (acc and (acc.type == "msa" or acc.type == "mojang")) type_text = "正版登录";

	return type_text ++ "：" ++ c.username;
}

function mode_index(m) {
	if (m == "fullscreen") return 2;
	if (m == "match") return 3;
	return 1;
}

function priority_index(p) {
	if (p == "idle") return 1;
	if (p == "below") return 2;
	if (p == "above") return 4;
	if (p == "high") return 5;
	return 3;
}

function priority_value(i) {
	if (i == 1) return "idle";
	if (i == 2) return "below";
	if (i == 4) return "above";
	if (i == 5) return "high";
	return "normal";
}

function update_mode_ui() {
	var manual = (comboMode.selIndex == 1);
	editW.disabled = !manual;
	editH.disabled = !manual;
}

function first_version(dir) {
	if (!dir) return null;

	var vdir = io.joinpath(dir, "versions");
	if (!io.exist(vdir)) return null;

	var files, folders = fsys.list(vdir);
	if (#folders == 0) return null;

	return folders[1];
}

function has_version(dir, name) {
	var vdir = io.joinpath(dir, "versions");
	if (!io.exist(vdir)) return false;

	var files, folders = fsys.list(vdir);
	for(i = 1; #folders; 1) {
		if (folders[i] == name) return true;
	}

	return false;
}

// ---------- 分页 ----------

var PAGES = { P1; P2; P3; P4; P5; PV; P6; P7 };
var nav_titles = { "启动器设置"; "游戏设置"; "账户管理"; "Java 管理"; "路径与版本管理"; "版本独立设置"; "关于"; "鸣谢" };

function show_page(n) {
	for i, page in PAGES {
		var on = (i == n);
		for k, ctrl in page.controls {
			ctrl.visible = on;
		}
	}

	// 第五页、第六页里都有两个子页：上面刚把整页置为可见，
	// 这里必须再收一次，否则两组会同时显示。
	if (n == 5) sub_apply();
	if (n == 6) pv_sub_apply();
}

// 页面数据第一次进入时才准备：账户/Java/路径/版本都要读磁盘，
// 打开设置时一次性全做会让窗口"加载一下才出来"。
var page_ready = {};

function ensure_page(n) {
	if (page_ready[n]) return;
	page_ready[n] = true;

	if (n == 3) acc_render();
	elseif (n == 4) java_render();
	elseif (n == 5) {
		paths_render();
		vers_render();
	}
	elseif (n == 8) credits_fill();
}

// 导航用一排 plus 自绘项，不用 listbox：
// listbox 的选中是系统蓝条，和黑白灰主题冲突，而且行高、内缩都改不动。
var nav_items = {};
var nav_current = 0;


function nav_skin(i, selected) {
	var c = nav_items[i];
	if (!c) return;

	if (selected) {
		c.skin({
			background = { default = NAV_SEL; hover = NAV_SEL; active = NAV_SEL };
			color = { default = m3theme.INK; hover = m3theme.INK; active = m3theme.INK };
		});
	}
	else {
		c.skin({
			background = { default = NAV_BG; hover = m3theme.SIDEBAR_HOVER; active = NAV_SEL };
			color = { default = m3theme.MUTED; hover = m3theme.INK; active = m3theme.INK };
		});
	}
}

// 把每个列表的列宽重新压回可视宽度（拖过列头之后"回正"）
function fit_all_lists() {
	m3list.fit(listAcc);
	m3list.fit(listJava);
	m3list.fit(listPaths);
	m3list.fit(listVers);
	m3list.fit(listMods);
}

function select_page(n) {
	if (n < 1 or n > #PAGES) return;

	// 已经在这一页：不再重排一遍（show_page 要遍历整页控件），
	// 只把导航样式刷一次，顺手清掉可能卡住的悬停态。
	if (n == nav_current) {
		for i, c in nav_items {
			nav_skin(i, i == n);
		}
		return;
	}

	// 整段（切显隐 + 换标题 + 刷导航样式）放在一次重绘抑制里，避免闪
	m3layout.batched(winform, function() {
		nav_current = n;
		show_page(n);
		ensure_page(n);

		// 离开 Mod 页就别再扫了
		if (n != 6) mod_scan_cancel();

		// 版本独立设置：每次进来都重读版本列表（可能刚在上一页增删改过）
		if (n == 6) pv_refresh();

		// 切页时把各列表的列宽重新压回可视宽度：
		// 用户拖过列头之后总宽会超出，回来时应该"回正"
		fit_all_lists();

		winform.lblPageTitle.text = nav_titles[n];

		for i, c in nav_items {
			nav_skin(i, i == n);
		}
	});
}

for i, t in nav_titles {
	var y = 20 + (i - 1) * 32;
	var idx = i;

	// 整行宽度（0..200）+ 左内边距，选中/悬停的底色自然通到两边，
	// 不需要额外的"选中条"控件，也就不会有残留。
	var item = winform.add({
		cls = "plus";
		text = t;
		align = "left";
		paddingLeft = 16;
		left = 0;
		top = y;
		right = 200;
		bottom = y + 30;
		font = LOGFONT(name='Microsoft YaHei'; h=-13);
	});

	table.push(nav_items, item);

	item.oncommand = function(id, event) {
		select_page(idx);
	}
}

select_page(1);

// ---------- 设置草稿 ----------
// 值类设置先写进 config.pending.json；点「保存」时合并进 config.json，
// 点「取消」时若发现有草稿，先确认再丢弃。
// 列表类操作（账号 / Java / 路径 / 版本）本身就是提交动作，仍然立即写盘。

// 从控件收当前值（含范围钳制）
function collect_draft() {
	var c = m3config.read();

	var mb = tonumber(string.trim(editMem.text)) or c.memory;
	if (mb < 512) mb = 512;
	if (mb > MEM_MAX) mb = MEM_MAX;

	var w = tonumber(string.trim(editW.text)) or c.width;
	var h = tonumber(string.trim(editH.text)) or c.height;
	if (w < 320) w = 320;
	if (h < 240) h = 240;

	var mi = comboMode.selIndex;
	var mode = "manual";
	if (mi == 2) mode = "fullscreen";
	elseif (mi == 3) mode = "match";

	return {
		memory = mb;
		width = w;
		height = h;
		window_mode = mode;
		priority = priority_value(comboPri.selIndex);
		log = chkLog.checked;
		hide_after_launch = chkHide.checked;
		status_bar = chkStatus.checked;
		debug = chkDebug.checked;
		allow_multi = chkMulti.checked;
		shot_tip = chkShot.checked;
		compat_fix = chkCompat.checked;
		ms_client_id = string.trim(editMsClient.text);
		jvm_args = editJvm.text;
	};
}

// 初始化期间程序化设置下拉框也会触发 onSelChange，
// 那时不该写草稿——否则用户什么都没改，点取消却会看到"有未保存的修改"。
var loading = true;

function mark_dirty() {
	if (loading) return;

	m3config.save_draft(collect_draft());
}

// ---------- 事件 ----------

editMem.onChange = function() {
	var v = tonumber(string.trim(editMem.text));
	if (!v) return;

	if (v < 512) v = 512;
	if (v > MEM_MAX) v = MEM_MAX;

	mem_refresh_stats();
}

// 滑条吸附到 128 MB 一档；用户拖动时同步到数值框
var mem_slider_busy = false;

sliderMem.onPosChanged = function(pos, triggeredByUser) {
	if (mem_slider_busy) return;

	var v = math.floor(pos / 128) * 128;
	if (v < 512) v = 512;

	if (v != pos) {
		mem_slider_busy = true;
		sliderMem.progressPos = v;
		mem_slider_busy = false;
	}

	if (triggeredByUser) {
		editMem.text = tostring(v);
		mem_refresh_stats();
		mem_slider_debounce();
	}
}

comboMode.onSelChange = function() {
	update_mode_ui();
	mark_dirty();
}

btnDefault.oncommand = function(id, event) {
	editW.text = "854";
	editH.text = "480";
	mark_dirty();
	winform.lblHint.text = "已设为默认窗口大小 854 × 480。";
}

btnAuto.oncommand = function(id, event) {
	var r = memory_suggest();

	editMem.text = tostring(r.memory);
	sliderMem.progressPos = r.memory;

	mem_refresh_stats();
	mark_dirty();

	var why = "按内存 1/4 + " ++ r.mods ++ " 个 Mod 估算：" ++ r.memory ++ " MB"
		++ "（本机 " ++ r.total ++ " MB，可用 " ++ r.avail ++ " MB）。";

	if (r.capped) why = why ++ "受可用内存限制，已下调。";

	winform.lblHint.text = why;
}

// ---------- 内存估算 ----------

// 当前版本实际使用的 mods 目录（隔离时在版本目录里）
function mods_dir() {
	return m3mod.dir_of(cfg, cfg.version);
}

// 数一遍 Mod：只数启用的（禁用的不会被加载，不该算进内存估算）
function count_mods() {
	return m3mod.count_enabled(mods_dir());
}

// 估算规则：
//   基础 = 物理内存的 1/4（1024 ~ 8192，按 256 取整）
//   加成 = Mod 数 × 32 MB（最多 4096）
//   上限 = 当前可用内存减 1 GB（给系统留余量）
function memory_suggest() {
	var st = sys.mem.getStatus();
	var total_mb = math.floor(st.totalPhys / 1048576);
	var avail_mb = math.floor(st.availPhys / 1048576);

	var base = math.floor(total_mb / 4 / 256) * 256;
	if (base < 1024) base = 1024;
	if (base > 8192) base = 8192;

	var mods = count_mods();
	var bonus = mods * 32;
	if (bonus > 4096) bonus = 4096;

	var want = base + bonus;

	var cap = math.floor((avail_mb - 1024) / 256) * 256;
	if (cap < 1024) cap = 1024;

	var mb = want;
	if (mb > cap) mb = cap;
	if (mb < 512) mb = 512;
	if (mb > 32768) mb = 32768;

	return {
		memory = mb;
		total = total_mb;
		avail = avail_mb;
		mods = mods;
		base = base;
		bonus = bonus;
		capped = (want > cap);
	};
}

// 底下的百分比说明：已用 / 游戏占用 / 剩余，都按物理内存总量算
function mem_stats_text() {
	var st = sys.mem.getStatus();

	var total = math.floor(st.totalPhys / 1048576);
	var avail = math.floor(st.availPhys / 1048576);
	if (total <= 0) return "";

	var v = tonumber(string.trim(editMem.text)) or cfg.memory;

	var used_pct = (total - avail) / total * 100;
	var game_pct = v / total * 100;
	var left_pct = (avail - v) / total * 100;

	return string.format("已用 %.0f%%　游戏占用 %.0f%%　剩余 %.0f%%", used_pct, game_pct, left_pct);
}

function mem_refresh_stats() {
	if (lblMemStats) lblMemStats.text = mem_stats_text();
}

// 数值写回滑条（不触发"用户拖动"那条路径）
function mem_to_slider() {
	var v = tonumber(string.trim(editMem.text));
	if (!v) return;

	if (v < 512) v = 512;
	if (v > MEM_MAX) v = MEM_MAX;

	editMem.text = tostring(v);
	sliderMem.progressPos = v;

	mem_refresh_stats();
}

// 拖滑条时别每动一像素就写一次草稿：停手 250ms 再写
var mem_tick = 0;

function mem_slider_debounce() {
	mem_tick = mem_tick + 1;
	var mine = mem_tick;

	winform.setTimeout(function() {
		if (mine == mem_tick) mark_dirty();
	}, 250);
}

// ---------- 账户管理 ----------

var acc_rows = {};
var acc_selected = null;

// 32 位十六进制
function is_hex32(s) {
	if (#s != 32) return false;

	for i = 1; 32; 1 {
		var c = string.slice(s, i, i);
		if (!string.indexOf('0123456789abcdefABCDEF', c)) return false;
	}

	return true;
}

function acc_render() {
	listAcc.clear();
	acc_rows = {};

	for i, a in cfg.accounts {
		var mark = "";
		if (a.name == cfg.account) mark = "[当前] ";

		var type_text = "离线";
		if (a.type == "msa" or a.type == "mojang") type_text = "正版";
		elseif (a.type == "authlib") type_text = "外置";

		var uuid_text = a.uuid or "";
		if (#uuid_text == 0) {
			// 留空 = 按用户名自动生成，列表里直接显示实际会用的值
			uuid_text = crypt.md5("OfflinePlayer:" ++ (a.name or ""));
		}

		listAcc.addItem({ mark ++ a.name; type_text; uuid_text });
		table.push(acc_rows, i);
	}

	// 按名字找回选中项
	if (acc_selected) {
		var at = 0;
		for i, idx in acc_rows {
			var a = cfg.accounts[idx];
			if (a and a.name == acc_selected) {
				at = i;
				break;
			}
		}

		if (at > 0) listAcc.selIndex = at;
		else acc_selected = null;
	}

	if (#acc_rows == 0) {
		lblAccHint.text = "还没有账号。请点击「添加账号」创建一个。";
	}
	else {
		lblAccHint.text = "共 " ++ #acc_rows ++ " 个账号。当前：" ++ user_summary(cfg);
	}
}

// 选中项对应的 cfg.accounts 下标
function acc_index() {
	var i = listAcc.selIndex;
	if (i > 0 and i <= #acc_rows) return acc_rows[i];

	if (!acc_selected) return 0;

	for i, a in cfg.accounts {
		if (a.name == acc_selected) return i;
	}

	return 0;
}

listAcc.onSelChanged = function(sel, item, subItem, nm) {
	var i = listAcc.selIndex;
	if (i <= 0 or i > #acc_rows) return;

	var a = cfg.accounts[acc_rows[i]];
	if (!a) return;

	acc_selected = a.name;
	editName.text = a.name or "";
	editUuid.text = a.uuid or "";
}

acc_btns[1].oncommand = function(id, event) {
	cfg.accounts = cfg.accounts or {};

	// 起一个不重名的默认名字：player / player2 / player3 ...
	var name = "player";
	var n = 1;
	while (m3config.find_account(cfg, name)) {
		n = n + 1;
		name = "player" ++ n;
	}

	table.push(cfg.accounts, { name = name; type = "offline"; uuid = "" });

	acc_selected = name;
	m3config.save_keys(cfg, {"accounts"; "account"});
	acc_render();
	lblAccHint.text = "已添加离线账号：" ++ name ++ "，可在上方修改用户名。";
}

acc_btns[2].oncommand = function(id, event) {
	var i = acc_index();
	if (i == 0) {
		lblAccHint.text = "请先选择一个账号。";
		return;
	}

	var name = cfg.accounts[i].name;

	// 先确认：自定义的 UUID 删掉就没了
	var show_name = name;
	if (#show_name > 20) show_name = string.slice(show_name, 1, 20) ++ "…";

	var frm = winform.loadForm("/dlg/confirm.aardio");
	frm.lblMsg.text = "确定删除账号「" ++ show_name ++ "」吗？" ++ '\r\n\r\n' ++ "自定义的 UUID 也会删除，不可恢复。";
	if (!frm.doModal(winform)) return;

	// 重建数组，避免 table.remove 之后留下空洞
	var list = {};
	for k, a in cfg.accounts {
		if (k != i) table.push(list, a);
	}
	cfg.accounts = list;

	if (cfg.account == name) {
		if (#cfg.accounts > 0) cfg.account = cfg.accounts[1].name;
		else cfg.account = "";
	}

	acc_selected = null;
	m3config.save_keys(cfg, {"accounts"; "account"});
	acc_render();
	lblAccHint.text = "已删除账号：" ++ name;
}

acc_btns[3].oncommand = function(id, event) {
	var i = acc_index();
	if (i == 0) {
		lblAccHint.text = "请先选择一个账号。";
		return;
	}

	var name = string.trim(editName.text);
	if (#name == 0) {
		lblAccHint.text = "用户名不能为空。";
		return;
	}

	// 重名检查（跳过自己）
	for k, a in cfg.accounts {
		if (k != i and a.name == name) {
			lblAccHint.text = "已有同名账号。";
			return;
		}
	}

	// UUID：留空 = 自动生成；填了就必须是 32 位十六进制
	var uuid = string.trim(editUuid.text);
	uuid = string.replace(uuid, "-", "");
	if (#uuid > 0 and !is_hex32(uuid)) {
		lblAccHint.text = "UUID 必须是 32 位十六进制（可带横线），留空则自动生成。";
		return;
	}

	var old_name = cfg.accounts[i].name;

	cfg.accounts[i].name = name;
	cfg.accounts[i].uuid = uuid;

	if (cfg.account == old_name) cfg.account = name;

	acc_selected = name;
	m3config.save_keys(cfg, {"accounts"; "account"});
	acc_render();
	lblAccHint.text = "已保存账号：" ++ name;
}

acc_btns[4].oncommand = function(id, event) {
	var i = acc_index();
	if (i == 0) {
		lblAccHint.text = "请先选择一个账号。";
		return;
	}

	cfg.account = cfg.accounts[i].name;
	acc_selected = cfg.account;

	m3config.save_keys(cfg, {"accounts"; "account"});
	acc_render();
	lblAccHint.text = "当前账号：" ++ cfg.account;
}

// 登录成功后的落库：同一个 UUID 就更新，否则新增
function acc_upsert(res, kind) {
	var idx = 0;

	for i, a in cfg.accounts {
		if (res.uuid and a.uuid == res.uuid) {
			idx = i;
			break;
		}
	}

	if (idx == 0) {
		table.push(cfg.accounts, { name = res.name; type = kind; uuid = res.uuid });
		idx = #cfg.accounts;
	}

	var a = cfg.accounts[idx];

	a.name = res.name;
	a.type = kind;
	a.uuid = res.uuid;
	a.access_token = res.access_token;

	if (res.refresh_token) a.refresh_token = res.refresh_token;
	if (res.expires_at) a.expires_at = res.expires_at;
	if (res.server) a.authlib_server = res.server;

	cfg.account = a.name;
	cfg.username = a.name;   // 主页的"玩家"跟着走

	acc_selected = a.name;

	m3config.save_keys(cfg, {"accounts"; "account"; "username"; "authlib_server"});
	acc_render();

	lblAccHint.text = "已登录：" ++ a.name ++ "（" ++ (kind == "authlib" ? "外置登录" : "正版") ++ "）";
}

acc_login_btns[1].oncommand = function(id, event) {
	//客户端 ID：用户填了自己的就用，否则内置默认
	var cid = string.trim(cfg.ms_client_id or "");
	if (#cid == 0) cid = m3app.MS_CLIENT_DEFAULT;
	m3auth.set_client(cid);

	var frm = winform.loadForm("/dlg/ms_login.aardio");
	var res = frm.doModal(winform);

	if (!res) return;

	acc_upsert(res, "msa");
}

acc_login_btns[2].oncommand = function(id, event) {
	var frm = winform.loadForm("/dlg/authlib_login.aardio");

	// 已选账号时把名字填进去，省得再打
	var i = acc_index();
	if (i > 0) frm.editUser.text = cfg.accounts[i].name or "";

	var res = frm.doModal(winform);

	if (!res) return;

	acc_upsert(res, "authlib");
}

// ---------- Java 管理 ----------

var java_rows = {};
var java_selected = null;

// 排序：版本号大的在前 → 同版本路径短的在前 → 再按路径字典序（只影响显示）
function java_before(a, b) {
	var ma = a.major or 0;
	var mb = b.major or 0;
	if (ma != mb) return ma > mb;

	var la = #(a.path or "");
	var lb = #(b.path or "");
	if (la != lb) return la < lb;

	return (a.path or "") < (b.path or "");
}

function sort_javas(list) {
	var out = {};

	for i, item in list {
		var at = #out + 1;

		for k, v in out {
			if (java_before(item, v)) {
				at = k;
				break;
			}
		}

		// aardio 的签名是 table.insert(表, 值, 位置)
		table.insert(out, item, at);
	}

	return out;
}

function java_render() {
	listJava.clear();
	java_rows = {};

	var sorted = sort_javas(cfg.javas);

	// 顺序：收藏的在最前（组内保持原有排序），再其余
	var order = {};
	for i, j in sorted {
		if (java_faved(j.path)) table.push(order, j);
	}
	for i, j in sorted {
		if (!java_faved(j.path)) table.push(order, j);
	}

	for i, j in order {
		var major_text = "?";
		if (j.major and j.major > 0) major_text = "Java " ++ j.major;

		if (j.version and #j.version > 0) major_text = major_text ++ " (" ++ j.version ++ ")";

		var vendor_text = j.vendor;
		if (!vendor_text or #vendor_text == 0) vendor_text = m3java.vendor_of(j.path, j.version);

		var mark = "";
		if (java_faved(j.path)) mark = mark ++ "★ ";
		if (j.black) mark = mark ++ "[黑名单] ";
		if (cfg.java == j.path) mark = mark ++ "[当前] ";

		listJava.addItem({ ""; mark ++ major_text; vendor_text; j.path });
		table.push(java_rows, j.path);
	}

	m3list.renumber(listJava);

	// 按路径找回选中项
	if (java_selected) {
		var at = 0;
		for i, p in java_rows {
			if (p == java_selected) {
				at = i;
				break;
			}
		}

		if (at > 0) listJava.selIndex = at;
		else java_selected = null;
	}

	lblJavaHint.text = "共 " ++ #cfg.javas ++ " 个。黑名单里的 Java 不会被自动选中。";

	java_black_btn_update();
	java_fav_btn_update();
}

// Java 收藏：键用小写 exe 路径（Java 是全局的，不像版本要带目录）
function java_faved(path) {
	if (!cfg.fav_javas or !path) return false;
	return cfg.fav_javas[string.lower(path)] == true;
}

function java_set_fav(path, on) {
	cfg.fav_javas = cfg.fav_javas or {};

	var k = string.lower(path);
	if (on) cfg.fav_javas[k] = true;
	else cfg.fav_javas[k] = null;
}

function java_fav_btn_update() {
	var btn = java_item_tools.left[1];
	if (!btn) return;

	var path = java_current();
	if (path and java_faved(path)) btn.text = "取消收藏";
	else btn.text = "收藏";
}

function java_current() {
	var i = listJava.selIndex;
	if (i > 0 and i <= #java_rows) return java_rows[i];

	return java_selected;
}

// 黑名单按钮的文字跟着选中项走：
// 已经在黑名单里就显示「移出黑名单」，否则「加入黑名单」（没选中时也用后者）。
function java_black_btn_update() {
	var btn = java_item_tools.left[2];
	if (!btn) return;

	var path = java_current();
	var in_black = false;

	if (path) {
		for i, j in cfg.javas {
			if (j.path == path) {
				if (j.black) in_black = true;
				break;
			}
		}
	}

	if (in_black) btn.text = "移出黑名单";
	else btn.text = "加入黑名单";
}

listJava.onSelChanged = function(sel, item, subItem, nm) {
	var i = listJava.selIndex;
	if (i > 0 and i <= #java_rows) java_selected = java_rows[i];

	java_black_btn_update();
	java_fav_btn_update();
}

// 重新检测
java_tools.left[1].oncommand = function(id, event) {
	lblJavaHint.text = "检测中…";

	winform.setTimeout(function() {
		var found_paths = m3java.scan_paths(cfg.game_path);

		// 已经问过版本的直接复用，只有第一次需要逐个起进程
		var cache = {};
		for i, j in cfg.javas {
			var major = j.major or 0;
			if (j.path and major > 0) cache[string.lower(j.path)] = major;
		}

		for i, p in found_paths {
			var major = cache[string.lower(p)];
			if (!major) major = MMMLC.get_java_version(p) or 0;

			var found = false;
			for k, j in cfg.javas {
				if (string.lower(j.path or "") == string.lower(p)) {
					j.major = major;
					found = true;
				}
			}

			if (!found) {
				table.push(cfg.javas, { path = p; major = major; black = false });
			}
		}

		m3config.save_keys(cfg, {"javas"; "java"});
		java_render();
		lblJavaHint.text = "检测完成，共 " ++ #found_paths ++ " 个 Java。";
	}, 50);
}

// 手动添加
java_tools.left[2].oncommand = function(id, event) {
	var f = fsys.dlg.open("可执行文件|*.exe|所有文件|*.*|", "选择 java.exe", "", winform, , "java.exe");
	if (!f) return;

	for i, j in cfg.javas {
		if (j.path == f) {
			lblJavaHint.text = "该 Java 已在列表当中。";
			return;
		}
	}

	var major = MMMLC.get_java_version(f);
	table.push(cfg.javas, { path = f; major = major or 0; black = false });

	m3config.save_keys(cfg, {"javas"; "java"});
	java_render();
}

// 移除记录
java_tools.left[3].oncommand = function(id, event) {
	var path = java_current();
	if (!path) {
		lblJavaHint.text = "请先选择一个 Java。";
		return;
	}

	// 重建数组，避免 table.remove 之后留下空洞
	var list = {};
	for i, j in cfg.javas {
		if (j.path != path) table.push(list, j);
	}
	cfg.javas = list;

	if (cfg.java == path) cfg.java = "";
	java_selected = null;

	m3config.save_keys(cfg, {"javas"; "java"});
	java_render();
}

// 加入 / 移出黑名单
java_item_tools.left[2].oncommand = function(id, event) {
	var path = java_current();
	if (!path) {
		lblJavaHint.text = "请先选择一个 Java。";
		return;
	}

	var hit = null;
	for i, j in cfg.javas {
		if (j.path == path) {
			hit = j;
			break;
		}
	}

	if (!hit) {
		lblJavaHint.text = "列表里找不到此记录，请点击「重新检测」。";
		return;
	}

	if (hit.black) hit.black = false;
	else hit.black = true;

	java_selected = path;

	m3config.save_keys(cfg, {"javas"; "java"});
	java_render();

	// 全都拉黑了就没有能自动选的，得提醒
	var usable = 0;
	for i, j in cfg.javas {
		if (j.path and !j.black) usable++;
	}

	if (hit.black) {
		if (usable == 0) {
			lblJavaHint.text = "已加入黑名单：" ++ path ++ "　—— 所有 Java 都在黑名单中，启动时将无法自动选择。";
		}
		else {
			lblJavaHint.text = "已加入黑名单：" ++ path;
		}
	}
	else {
		lblJavaHint.text = "已移出黑名单：" ++ path;
	}
}

// 设为当前
java_item_tools.left[3].oncommand = function(id, event) {
	var path = java_current();
	if (!path) {
		lblJavaHint.text = "请先选择一个 Java。";
		return;
	}

	cfg.java = path;
	java_selected = path;

	m3config.save_keys(cfg, {"javas"; "java"});
	java_render();
}

// 在资源管理器里选中这条 Java
java_item_tools.left[4].oncommand = function(id, event) {
	var path = java_current();
	if (!path) {
		lblJavaHint.text = "请先选择一个 Java。";
		return;
	}

	if (!io.exist(path)) {
		lblJavaHint.text = "此 Java 已被删除或迁移。";
		return;
	}

	process.exploreSelect(path);
}

// 收藏 / 取消收藏
java_item_tools.left[1].oncommand = function(id, event) {
	var path = java_current();
	if (!path) {
		lblJavaHint.text = "请先选择一个 Java。";
		return;
	}

	var on = !java_faved(path);
	java_set_fav(path, on);

	java_selected = path;

	m3config.save_keys(cfg, {"fav_javas"});
	java_render();

	if (on) lblJavaHint.text = "已收藏：" ++ path;
	else lblJavaHint.text = "已取消收藏：" ++ path;
}

// ---------- 收藏 ----------
// 路径按小写目录记；版本按「目录 + 版本名」记——只用版本名的话，
// 不同目录下的同名版本会共用收藏（和隔离那个 bug 同一类）。

function path_faved(dir) {
	if (!cfg.fav_paths or !dir) return false;
	return cfg.fav_paths[string.lower(dir)] == true;
}

function path_set_fav(dir, on) {
	cfg.fav_paths = cfg.fav_paths or {};

	var k = string.lower(dir);
	if (on) cfg.fav_paths[k] = true;
	else cfg.fav_paths[k] = null;
}

function ver_faved(name) {
	if (!cfg.fav_versions or !name) return false;
	return cfg.fav_versions[m3config.shared_key(cfg.game_path, name)] == true;
}

function ver_set_fav(name, on) {
	cfg.fav_versions = cfg.fav_versions or {};

	var k = m3config.shared_key(cfg.game_path, name);
	if (on) cfg.fav_versions[k] = true;
	else cfg.fav_versions[k] = null;
}

function path_fav_btn_update() {
	var btn = path_tools.right[3];
	if (!btn) return;

	var i = path_index();
	if (i > 0 and path_faved(cfg.game_paths[i].dir)) btn.text = "取消收藏";
	else btn.text = "收藏";
}

function ver_fav_btn_update() {
	var btn = ver_tools.right[3];
	if (!btn) return;

	var name = ver_current();
	if (name and ver_faved(name)) btn.text = "取消收藏";
	else btn.text = "收藏";
}

// ---------- 游戏路径 ----------

var path_rows = {};
var path_selected = null;

function paths_render() {
	listPaths.clear();
	path_rows = {};

	// 顺序：收藏的在最前，两组内部都保持配置里的原顺序
	var order = {};
	for i, p in cfg.game_paths {
		if (path_faved(p.dir)) table.push(order, i);
	}
	for i, p in cfg.game_paths {
		if (!path_faved(p.dir)) table.push(order, i);
	}

	for n, i in order {
		var p = cfg.game_paths[i];

		var name = p.name;
		if (!name or #name == 0) name = io.splitpath(p.dir).name;

		var mark = "";
		if (path_faved(p.dir)) mark = mark ++ "★ ";
		if (p.official) mark = mark ++ "[官方] ";
		if (cfg.game_path == p.dir) mark = mark ++ "[当前] ";

		listPaths.addItem({ ""; mark ++ name; p.dir });
		table.push(path_rows, i);
	}

	m3list.renumber(listPaths);

	// 按目录找回选中项，重建列表不会把选中状态弄丢
	if (path_selected) {
		var at = 0;
		for i, idx in path_rows {
			var p = cfg.game_paths[idx];
			if (p and p.dir == path_selected) {
				at = i;
				break;
			}
		}

		if (at > 0) listPaths.selIndex = at;
		else path_selected = null;
	}

	lblPathHint.text = "游戏路径共 " ++ #cfg.game_paths ++ " 条。官方目录不能删除。";

	path_fav_btn_update();
}

function path_index() {
	var i = listPaths.selIndex;
	if (i > 0 and i <= #path_rows) {
		var p = cfg.game_paths[path_rows[i]];
		if (p) return path_rows[i];
	}

	if (!path_selected) return 0;

	for i, p in cfg.game_paths {
		if (p.dir == path_selected) return i;
	}

	return 0;
}

listPaths.onSelChanged = function(sel, item, subItem, nm) {
	var i = listPaths.selIndex;
	if (i <= 0 or i > #path_rows) return;

	path_fav_btn_update();

	var p = cfg.game_paths[path_rows[i]];
	if (!p) return;

	path_selected = p.dir;
	editPathName.text = p.name or "";
}

// 添加路径
path_tools.left[1].oncommand = function(id, event) {
	var dir = fsys.dlg.openDir("", winform, "选择 .minecraft 目录");
	if (!dir) return;

	for i, p in cfg.game_paths {
		if (p.dir == dir) {
			lblPathHint.text = "此游戏路径已在列表当中。";
			return;
		}
	}

	table.push(cfg.game_paths, { name = io.splitpath(dir).name; dir = dir; official = false });

	path_selected = dir;

	m3config.save_keys(cfg, {"game_paths"; "game_path"});
	paths_render();
	lblPathHint.text = "已添加路径：" ++ dir;
}

// 删除路径
path_tools.left[2].oncommand = function(id, event) {
	var i = path_index();
	if (i == 0) {
		lblPathHint.text = "请先选择一条游戏路径。";
		return;
	}

	var p = cfg.game_paths[i];
	if (p.official) {
		lblPathHint.text = "官方目录不允许删除。";
		return;
	}

	var show_name = p.name or p.dir;
	if (#show_name > 20) show_name = string.slice(show_name, 1, 20) ++ "…";

	var frm = winform.loadForm("/dlg/confirm.aardio");
	frm.lblMsg.text = "确定删除路径「" ++ show_name ++ "」吗？" ++ '\r\n\r\n' ++ "只从列表里移除，不会删除磁盘上的文件夹。";
	if (!frm.doModal(winform)) return;

	// 重建数组，避免 table.remove 之后留下空洞
	var list = {};
	for k, item in cfg.game_paths {
		if (k != i) table.push(list, item);
	}
	cfg.game_paths = list;

	path_selected = null;

	// 删掉的正好是当前路径，就切回第一条
	if (cfg.game_path == p.dir) {
		if (cfg.game_paths[1]) cfg.game_path = cfg.game_paths[1].dir;
		else cfg.game_path = "";
	}

	m3config.save_keys(cfg, {"game_paths"; "game_path"});
	paths_render();
	vers_render();
	lblPathHint.text = "已删除路径：" ++ show_name;
}

// 重命名路径
btnPathRename.oncommand = function(id, event) {
	var i = path_index();
	if (i == 0) {
		lblPathHint.text = "请先选择一条游戏路径。";
		return;
	}

	var name = string.trim(editPathName.text);
	if (#name == 0) {
		lblPathHint.text = "请先填写名称。";
		return;
	}

	cfg.game_paths[i].name = name;
	m3config.save_keys(cfg, {"game_paths"; "game_path"});
	paths_render();
	lblPathHint.text = "已重命名为：" ++ name;
}

// 设为当前路径
path_tools.right[1].oncommand = function(id, event) {
	var i = path_index();
	if (i == 0) {
		lblPathHint.text = "请先选择一条游戏路径。";
		return;
	}

	cfg.game_path = cfg.game_paths[i].dir;

	// 换了目录，当前版本可能不存在，自动选第一个可用版本
	if (!has_version(cfg.game_path, cfg.version)) {
		var v = first_version(cfg.game_path);
		if (v) cfg.version = v;
		else cfg.version = "";
	}

	m3config.save_keys(cfg, {"game_path"; "version"});
	paths_render();
	vers_render();
	lblPathHint.text = "当前游戏路径：" ++ cfg.game_path;
}

// 刷新：重读配置再重画（外部改过 config 或磁盘上的版本目录时用）
path_tools.left[3].oncommand = function(id, event) {
	cfg = m3config.read();
	paths_render();
	lblPathHint.text = "已刷新。游戏路径共 " ++ #cfg.game_paths ++ " 条。";
}

// 打开所选路径
path_tools.right[2].oncommand = function(id, event) {
	var i = path_index();
	if (i == 0) {
		lblPathHint.text = "请先选择一条游戏路径。";
		return;
	}

	var dir = cfg.game_paths[i].dir;
	if (!io.exist(dir)) {
		lblPathHint.text = "该目录已被删除或迁移：" ++ dir;
		return;
	}

	process.explore(dir);
}

// 收藏 / 取消收藏
path_tools.right[3].oncommand = function(id, event) {
	var i = path_index();
	if (i == 0) {
		lblPathHint.text = "请先选择一条游戏路径。";
		return;
	}

	var p = cfg.game_paths[i];
	var on = !path_faved(p.dir);
	path_set_fav(p.dir, on);

	path_selected = p.dir;

	m3config.save_keys(cfg, {"fav_paths"});
	paths_render();

	if (on) lblPathHint.text = "已收藏：" ++ (p.name or p.dir);
	else lblPathHint.text = "已取消收藏：" ++ (p.name or p.dir);
}

// ---------- 版本 ----------

var ver_rows = {};
var ver_selected = null;

// 没记录过的默认隔离（每个版本用自己的目录）。
// 键是「游戏目录 + 版本名」，不同目录下的同名版本互不影响。
function is_isolated(name) {
	return m3config.is_isolated(cfg, cfg.game_path, name);
}

// 提示行里显示用的短名字（太长的版本名会把提示撑爆）
function short_name(name) {
	if (#name <= 16) return name;
	return string.slice(name, 1, 16) ++ "…";
}

// 版本名排序（简单插入排序，版本数量很少）
function sort_names(list) {
	var out = {};

	for i, item in list {
		var at = #out + 1;

		for k, v in out {
			if (item < v) {
				at = k;
				break;
			}
		}

		table.insert(out, item, at);
	}

	return out;
}

function list_version_names() {
	var names = {};

	var vdir = io.joinpath(cfg.game_path, "versions");
	if (!vdir) return names;
	if (!io.exist(vdir)) return names;

	var files, folders = fsys.list(vdir);
	for(i = 1; #folders; 1) {
		if (folders[i]) table.push(names, folders[i]);
	}

	// 这里不做 m3version.repair()：它是"读 JSON + 可能写回"的磁盘操作，
	// 版本一多就会明显卡一下。启动前 main 已经对当前版本做过自愈，
	// 没必要每次列列表都全量扫一遍。

	return sort_names(names);
}

function vers_render() {
	listVers.clear();
	ver_rows = {};

	var names = list_version_names();

	// 顺序：收藏的在最前；两组内部都保持原有的排序结果
	var order = {};
	for i, name in names {
		if (ver_faved(name)) table.push(order, name);
	}
	for i, name in names {
		if (!ver_faved(name)) table.push(order, name);
	}

	for i, name in order {
		var mark = "";
		if (ver_faved(name)) mark = mark ++ "★ ";
		if (name == cfg.version) mark = mark ++ "[当前] ";

		// 文案要短：这一列只有 60px，写「共用根目录」会被截成「共用根…」
		var isolate_text = "隔离";
		if (!is_isolated(name)) isolate_text = "共用";

		// 真正的游戏版本 + 加载器：读版本 JSON 判断，不靠文件夹名
		var info = m3version.describe(cfg.game_path, name);

		listVers.addItem({ ""; mark ++ name; info.game; info.loader; isolate_text });
		table.push(ver_rows, name);
	}

	m3list.renumber(listVers);

	// 按名字找回选中项
	if (ver_selected) {
		var at = 0;
		for i, name in ver_rows {
			if (name == ver_selected) {
				at = i;
				break;
			}
		}

		if (at > 0) listVers.selIndex = at;
		else ver_selected = null;
	}

	lblVerHint.text = ver_hint_text();

	ver_fav_btn_update();
}

// 版本页的提示文字（子页按钮也要用，所以做成全局函数：
// 只能这样——先定义的闭包看不到后面 var 的局部变量）
function ver_hint_text() {
	if (#ver_rows == 0) return "该游戏目录下还没有游戏版本：" ++ cfg.game_path;

	return "共 " ++ #ver_rows ++ " 个版本。（删除的版本将移至回收站，可恢复）";
}

function ver_current() {
	var i = listVers.selIndex;
	if (i > 0 and i <= #ver_rows) return ver_rows[i];

	return ver_selected;
}

listVers.onSelChanged = function(sel, item, subItem, nm) {
	var i = listVers.selIndex;
	if (i <= 0 or i > #ver_rows) return;

	ver_selected = ver_rows[i];
	editVerNew.text = ver_selected;

	ver_fav_btn_update();
}

// 设为当前版本
ver_tools.right[1].oncommand = function(id, event) {
	var name = ver_current();
	if (!name) {
		lblVerHint.text = "请先选择一个版本。";
		return;
	}

	cfg.version = name;
	m3config.save_keys(cfg, {"version"});
	vers_render();
	lblVerHint.text = "已设为当前版本：" ++ short_name(name);
}

// 切换隔离
ver_tools.left[1].oncommand = function(id, event) {
	var name = ver_current();
	if (!name) {
		lblVerHint.text = "请先选择一个版本。";
		return;
	}

	// 取反：当前隔离 → 关闭隔离；当前共用 → 恢复隔离。
	// 具体写法（只写 true / 删键）收在 m3config.set_isolated 里
	var now_isolated = is_isolated(name);
	m3config.set_isolated(cfg, cfg.game_path, name, !now_isolated);

	m3config.save_keys(cfg, {"shared"});
	vers_render();

	if (is_isolated(name)) {
		lblVerHint.text = short_name(name) ++ "：开启隔离（用 versions" ++ '\\' ++ short_name(name) ++ " 作为游戏目录）";
	}
	else {
		lblVerHint.text = short_name(name) ++ "：关闭隔离（与其它版本共用 .minecraft 根目录）";
	}
}

// 当前游戏目录下版本名最多能有多长：
// 完整路径是 <versions>\<名字>\<名字>.json，要压在 250 字符以内
function max_name_length() {
	var vdir = io.joinpath(cfg.game_path, "versions");
	if (!vdir) return 0;

	var room = 250 - #vdir - 7;   // 两个反斜杠 + ".json"
	if (room < 2) return 0;

	return math.floor(room / 2);
}

// 重命名：改目录名、json/jar 文件名，并更新 json 里的 id。
// Windows 路径上限 260，版本名在路径里出现两次，长名字会把完整路径顶爆，
// 而 io.joinpath 会静默截断——所以先把所有路径算出来，任何一个不对劲就放弃。
function rename_version(old, new) {
	var vdir = io.joinpath(cfg.game_path, "versions");
	if (!vdir) return false, "游戏目录路径无效。";

	var src = io.joinpath(vdir, old);
	var dst = io.joinpath(vdir, new);
	if (!src or !dst) return false, "新名称太长，超出限制。";

	if (!io.exist(src)) return false, "版本目录不存在。";
	if (io.exist(dst)) return false, "已存在同名版本。";

	var old_json = io.joinpath(dst, old ++ ".json");
	var new_json = io.joinpath(dst, new ++ ".json");
	var old_jar = io.joinpath(dst, old ++ ".jar");
	var new_jar = io.joinpath(dst, new ++ ".jar");

	if (!old_json or !new_json or !old_jar or !new_jar) return false, "新名称太长，超出限制。";
	if (#new_json >= 250 or #new_jar >= 250) return false, "新名称太长，超出限制。";

	if (!fsys.rename(src, dst)) return false, "无法进行重命名操作，游戏可能正在运行。";

	// json：先改名，再更新里面的 id；任何一步失败都整体回滚
	if (io.exist(old_json)) {
		if (!fsys.rename(old_json, new_json)) {
			fsys.rename(dst, src);
			return false, "json 文件重命名失败";
		}

		var data = json.load(new_json);
		if (data) {
			data.id = new;
			if (data.jar == old) data.jar = new;
			json.save(new_json, data);
		}
	}

	// 客户端 jar
	if (io.exist(old_jar)) {
		if (!fsys.rename(old_jar, new_jar)) {
			if (io.exist(new_json)) fsys.rename(new_json, old_json);
			fsys.rename(dst, src);
			return false, "客户端 jar 重命名失败";
		}
	}

	return true;
}

// 重命名版本
btnVerRename.oncommand = function(id, event) {
	var name = ver_current();
	if (!name) {
		lblVerHint.text = "请先选择一个版本。";
		return;
	}

	var new_name = string.trim(editVerNew.text);
	if (#new_name == 0 or new_name == name) {
		lblVerHint.text = "请输入一个新名字。";
		return;
	}

	// 文件名非法字符
	var bad_chars = '\\/:*?"<>|';
	for i = 1; #bad_chars; 1 {
		if (string.indexOf(new_name, string.slice(bad_chars, i, i))) {
			lblVerHint.text = '版本名里不可包含 \\ / : * ? " < > | 。';
			return;
		}
	}

	var limit = max_name_length();
	if (limit <= 0) {
		lblVerHint.text = "游戏目录路径太长，无法重命名版本。";
		return;
	}
	if (#new_name > limit) {
		lblVerHint.text = "名称过长：当前游戏目录下最多 " ++ limit ++ " 字符（Windows 路径上限 260）。";
		return;
	}

	var ok, err = rename_version(name, new_name);
	if (!ok) {
		lblVerHint.text = "重命名失败：" ++ err;
		return;
	}

	// 当前版本 / 隔离设置跟着改
	if (cfg.version == name) cfg.version = new_name;

	// 隔离设置跟着改名走（同一个游戏目录下）
	if (!is_isolated(name)) {
		m3config.set_isolated(cfg, cfg.game_path, new_name, false);
		m3config.set_isolated(cfg, cfg.game_path, name, true);
	}

	// 收藏跟着改名走（同一个游戏目录下）
	if (ver_faved(name)) {
		ver_set_fav(new_name, true);
		ver_set_fav(name, false);
	}

	ver_selected = new_name;

	m3config.save_keys(cfg, {"version"; "shared"; "fav_versions"});
	vers_render();
	lblVerHint.text = "已重命名为：" ++ short_name(new_name);
}

// 删除版本（移到回收站）
ver_tools.left[2].oncommand = function(id, event) {
	var name = ver_current();
	if (!name) {
		lblVerHint.text = "请先选择一个版本。";
		return;
	}

	var frm = winform.loadForm("/dlg/confirm.aardio");
	frm.lblMsg.text = "确定删除版本「" ++ short_name(name) ++ "」吗？" ++ '\r\n\r\n' ++ "（版本目录将被移至回收站，可恢复）";
	if (!frm.doModal(winform)) return;

	var dir = io.joinpath(cfg.game_path, "versions", name);
	if (!dir) {
		lblVerHint.text = "路径太长，无法删除该版本。";
		return;
	}

	if (!fsys.delete(dir, true)) {
		lblVerHint.text = "删除失败，游戏可能正在运行。";
		return;
	}

	if (cfg.version == name) cfg.version = "";

	m3config.set_isolated(cfg, cfg.game_path, name, true);
	ver_set_fav(name, false);
	ver_selected = null;

	m3config.save_keys(cfg, {"version"; "shared"; "fav_versions"});
	vers_render();
	lblVerHint.text = "已删除版本：" ++ short_name(name);
}

// 刷新：重读配置与磁盘上的版本目录
ver_tools.left[3].oncommand = function(id, event) {
	cfg = m3config.read();
	vers_render();
	lblVerHint.text = "已刷新。" ++ ver_hint_text();
}

// 打开所选版本的文件夹
ver_tools.right[2].oncommand = function(id, event) {
	var name = ver_current();
	if (!name) {
		lblVerHint.text = "请先选择一个版本。";
		return;
	}

	var dir = io.joinpath(cfg.game_path, "versions", name);
	if (!io.exist(dir)) {
		lblVerHint.text = "此版本目录已被删除或迁移。";
		return;
	}

	process.explore(dir);
}

// 收藏 / 取消收藏
ver_tools.right[3].oncommand = function(id, event) {
	var name = ver_current();
	if (!name) {
		lblVerHint.text = "请先选择一个版本。";
		return;
	}

	var on = !ver_faved(name);
	ver_set_fav(name, on);

	ver_selected = name;

	m3config.save_keys(cfg, {"fav_versions"});
	vers_render();

	if (on) lblVerHint.text = "已收藏版本：" ++ short_name(name);
	else lblVerHint.text = "已取消收藏版本：" ++ short_name(name);
}

winform.btnSave.oncommand = function(id, event) {
	// 先重读，再把草稿里的值覆盖上去：这一会儿别处（账号 / Java / 路径 / 版本）可能改过列表数据
	var c = m3config.read();

	var vals = collect_draft();
	for k, v in vals {
		c[k] = v;
	}

	if (#c.game_path > 0 and !has_version(c.game_path, c.version)) {
		var v = first_version(c.game_path);
		if (v) c.version = v;
		else c.version = "";
	}

	// 列宽不是"值类设置"（拖列头改的），单独带上
	c.java_columns = listJava.columns;
	c.paths_columns = listPaths.columns;
	c.version_columns = listVers.columns;

	m3config.save(c);

	// 版本独立设置：先把这一页当前显示的值收进待保存表，再逐版本落盘
	if (pv_current) pv_stash();

	for name, ov in ver_pending {
		m3opts.write(c.game_path, name, ov);
	}

	ver_pending = {};

	m3config.clear_draft();
	winform.endModal(true);
}

winform.btnCancel.oncommand = function(id, event) {
	// 有未保存的修改时先问一句，避免改了半天被一次误点丢掉
	if (m3config.load_draft()) {
		var frm_cancel = winform.loadForm("/dlg/confirm.aardio");
		frm_cancel.lblMsg.text = "有未保存的设置修改，确定放弃吗？";
		if (!frm_cancel.doModal(winform)) return;
	}

	m3config.clear_draft();
	winform.endModal(false);
}

winform.onOk = function() {
	winform.btnSave.oncommand();
}

winform.onCancel = function() {
	winform.btnCancel.oncommand();
}

// ---------- 初始化 ----------

editMem.text = tostring(cfg.memory);
sliderMem.progressPos = cfg.memory;      // 滑条跟着数值走
mem_refresh_stats();
editJvm.text = cfg.jvm_args or "";
editMsClient.text = cfg.ms_client_id or "";
editW.text = tostring(cfg.width);
editH.text = tostring(cfg.height);

comboMode.add("手动设置");
comboMode.add("全屏");
comboMode.add("与启动器一致");
comboMode.selIndex = mode_index(cfg.window_mode);
update_mode_ui();

comboPri.add("低");
comboPri.add("较低");
comboPri.add("正常");
comboPri.add("较高");
comboPri.add("高");
comboPri.selIndex = priority_index(cfg.priority);

// 允许调用方指定打开时停在哪一页（全局变量在 loadForm 之前设置，进去后立刻清掉）
var start_page = 1;
if (g_settings_start_page) {
	start_page = g_settings_start_page;
	g_settings_start_page = null;
}

// 值类控件一改动就写草稿（不直接写 config.json）
for i, c in { chkLog; chkHide; chkStatus; chkDebug; chkMulti; chkShot } {
	c.oncommand = function(id, event) {
		mark_dirty();
	};
}

comboPri.onSelChange = function() {
	mark_dirty();
}

editMem.onFocusLost = function() { mem_to_slider(); mark_dirty(); }
editMem.onOk = function() { mem_to_slider(); mark_dirty(); }
editW.onFocusLost = function() { mark_dirty(); }
editW.onOk = function() { mark_dirty(); }
editH.onFocusLost = function() { mark_dirty(); }
editH.onOk = function() { mark_dirty(); }
editJvm.onFocusLost = function() { mark_dirty(); }

if (draft_restored) {
	winform.lblHint.text = "已恢复上次未保存的设置修改。点「保存」生效，点「取消」丢弃。";
}

loading = false;

select_page(start_page);

// 先不解冻：窗口显示后系统会按实际 DPI 缩放（125% 时 766x603 -> 956x745），
// 等那次 WM_SIZE 过去再解冻，第一帧就是最终尺寸，看不到跳变。
var resumed = false;

function resume_after_scale() {
	if (resumed) return;
	resumed = true;

	m3layout.resume(winform);
}

winform.onSize = function(width, height, wParam) {
	resume_after_scale();
}

// 兜底：100% 缩放下可能不会有尺寸变化，30ms 后直接解冻，别让窗口一直冻着
winform.setTimeout(function() {
	resume_after_scale();
}, 30);

return winform;
