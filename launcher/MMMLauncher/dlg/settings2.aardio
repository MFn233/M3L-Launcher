});

table.push(PV.controls, subCfgBtn);
table.push(PV.controls, subModBtn);

var SUB2_BODY_TOP = SUB2_TOP + 28 + 8;

// ---------- 子页一：设置 ----------

var PVA = m3layout.create(winform, 232, SUB2_BODY_TOP, 504, { framed = true });
PVA.btn_w = 76;

PVA.section("");

// 一行：左边勾「使用独立设置」，右边控件。勾选框本身就是"有没有覆盖"的开关。
function pv_row(label, ctrl_opt) {
	var y = PVA.y;

	var chk = PVA.make({
		cls = "checkbox";
		text = label;
		left = PVA.left;
		top = y;
		right = PVA.left + 104;
		bottom = y + 20;
	});

	chk.bgcolor = m3theme.C_BG;

	var ctrl = PVA.make(table.assign({}, ctrl_opt, {
		left = PVA.left + 112;
		top = y;
		right = PVA.right;
		bottom = y + PVA.row_h;
	}));

	if (ctrl_opt.cls == "edit") m3theme.field(ctrl);

	PVA.y = y + PVA.row_step;

	return ctrl, chk;
}

var editPvMem, chkMem = pv_row("内存", { cls = "edit"; text = "" });
var comboPvMode, chkMode = pv_row("窗口模式", { cls = "combobox"; mode = "dropdownlist" });
var editPvW, chkW = pv_row("宽度", { cls = "edit"; text = "" });
var editPvH, chkH = pv_row("高度", { cls = "edit"; text = "" });
var comboPvPri, chkPri = pv_row("进程优先级", { cls = "combobox"; mode = "dropdownlist" });

