//dlg/crash_test.aardio

//崩溃窗口的测试台（开发用）。
//崩溃场景很难人为制造，所以这里内置几份真实的崩溃报告片段：
//  - 选一个样本 → 看 m3crash 分析出什么原因、疑似哪个模组；
//  - 「打开崩溃窗口」→ 用样本写一个临时目录，走完整的崩溃窗口流程。
// 入口：主窗口标题右键 → 调试菜单 →「崩溃窗口测试台」。

import win.ui;
import m3theme;
import m3crash;
import process;
import fsys;
import string;

/*DSG{{*/
var winform = win.form(text="崩溃窗口测试台";right=600;bottom=520;bgcolor=0xF2F2F2;border="dialog frame";max=false;min=false)
winform.add(
lblCase={cls="static";text="样本";left=24;top=18;right=80;bottom=40;font=LOGFONT(name='Microsoft YaHei';h=-12);z=1};
comboCase={cls="combobox";left=88;top=14;right=400;bottom=214;mode="dropdownlist";font=LOGFONT(name='Microsoft YaHei';h=-12);z=2};
editSample={cls="richedit";left=24;top=48;right=576;bottom=248;bgcolor=0xFFFFFF;readonly=1;multiline=1;vscroll=1;font=LOGFONT(name='Consolas';h=-12);z=3};
lblResult={cls="static";text="分析结果";left=24;top=258;right=120;bottom=280;font=LOGFONT(name='Microsoft YaHei';h=-12);z=4};
editResult={cls="richedit";left=24;top=284;right=576;bottom=428;bgcolor=0xFFFFFF;readonly=1;multiline=1;vscroll=1;font=LOGFONT(name='Microsoft YaHei';h=-12);z=5};
btnAnalyze={cls="plus";text="分析";left=24;top=440;right=120;bottom=472;font=LOGFONT(name='Microsoft YaHei';h=-12);z=6};
btnOpen={cls="plus";text="打开崩溃窗口";left=128;top=440;right=272;bottom=472;font=LOGFONT(name='Microsoft YaHei';h=-12);z=7};
btnMulti={cls="plus";text="连开 3 个";left=280;top=440;right=404;bottom=472;font=LOGFONT(name='Microsoft YaHei';h=-12);z=9};
btnClose={cls="plus";text="关闭";left=476;top=440;right=576;bottom=472;font=LOGFONT(name='Microsoft YaHei';h=-13);z=8};
)
/*}}*/

m3theme.window(winform);

m3theme.note(winform.lblCase);
m3theme.note(winform.lblResult);

m3theme.button(winform.btnAnalyze);
m3theme.button(winform.btnOpen);
m3theme.button(winform.btnMulti);
m3theme.button(winform.btnClose);

// ---------- 内置样本 ----------
// 都是真实报告/日志里能见到的片段，故意写短，够规则匹配就行。
// 用行表拼文本，比一串 ++ '\r\n' ++ 好改：加一行样本就多一行。
function lines_to_text(lines) {
	return table.concat(lines, '\r\n');
}

var SAMPLES = {
	{
		title = "Java 版本过低（class file 61 = Java 17）";
		text = lines_to_text({
			'---- Minecraft Crash Report ----';
			'// Oh dear. Looks like a problem occurred.';
			'';
			'Description: Initializing game';
			'';
			'java.lang.UnsupportedClassVersionError: net/fabricmc/loader/impl/launch/knot/KnotClient has been compiled by a more recent version of the Java Runtime (class file version 61.0), this version of the Java Runtime only recognizes class file versions up to 52.0';
			'\tat java.base/java.lang.ClassLoader.defineClass1(Native Method)';
			'\tat net.fabricmc.loader.impl.launch.knot.Knot.init(Knot.java:139)';
		});
	};

	{
		title = "模组 Mixin 注入失败";
		text = lines_to_text({
			'---- Minecraft Crash Report ----';
			'// Daisy, daisy...';
			'';
			'Description: Rendering overlay';
			'';
			'org.spongepowered.asm.mixin.injection.throwables.InjectionError: Critical injection failure: Redirector onTick()V in examplemod.mixins.json:GameRendererMixin failed injection check, (0/1) succeeded.';
			'\tat org.spongepowered.asm.mixin.injection.struct.InjectionInfo.postInject(InjectionInfo.java:468)';
			'\tat com.example.examplemod.mixin.GameRendererMixin.render(GameRendererMixin.java:42)';
		});
	};

	{
		title = "内存不足";
		text = lines_to_text({
			'---- Minecraft Crash Report ----';
			'// This does not make any sense!';
			'';
			'Description: Ticking entity';
			'';
			'java.lang.OutOfMemoryError: Java heap space';
			'\tat java.base/java.util.Arrays.copyOf(Arrays.java:3512)';
			'\tat net.minecraft.world.level.chunk.LevelChunk.<init>(LevelChunk.java:120)';
		});
	};

	{
		title = "Fabric 模组依赖冲突";
		text = lines_to_text({
			'---- Minecraft Crash Report ----';
			'// Uh... Did I do that?';
			'';
			'Description: Initializing game';
			'';
			'net.fabricmc.loader.impl.FormattedException: Mod resolution encountered an incompatible mod set!';
			'A potential solution has been determined:';
			'\t- Replace mod sodium (any) with version 0.5.8 or later.';
			'Unmet dependency listing:';
			'\t- Mod sodium requires any version of minecraft, which is missing!';
			'\tat net.fabricmc.loader.impl.launch.knot.Knot.init(Knot.java:139)';
		});
	};

	// 下面四个是 2026-11 那几次真实事故，专门用来看规则有没有命中
	{
		title = "版本 jar 带了签名但被改过";
		text = lines_to_text({
			'---- Minecraft Crash Report ----';
			'// I bet Cylons would not have this problem.';
			'';
			'Description: Initializing game';
			'';
			'java.lang.SecurityException: class bkf signer information does not match signer information of other classes in the same package';
			'\tat java.base/java.lang.ClassLoader.checkCerts(ClassLoader.java:1121)';
			'\tat java.base/java.lang.ClassLoader.preDefineClass(ClassLoader.java:890)';
		});
	};

	{
		title = "Forge 自校验下载失败（下载源已失效）";
		text = lines_to_text({
			'[main/INFO] [FML]: Downloading deobfuscation_data_1.5.2.zip from http://files.minecraftforge.net/maven/deobfuscation_data_1.5.2.zip';
			'[main/ERROR] [FML]: Failed to download file.';
			'[main/ERROR] [FML]: invalid checksum. Expected: 4a1b8c0e, got: 9f3c77aa';
			'[main/ERROR] [FML]: There was a problem downloading the deobfuscation data.';
			'java.lang.RuntimeException: invalid checksum for deobfuscation_data_1.5.2.zip';
		});
	};

	{
		title = "JVM 参数里的 jar 无法加载（-javaagent）";
		text = lines_to_text({
			'Error occurred during initialization of VM';
			'agent library failed Agent_OnLoad: instrument';
			'Error opening zip file or JAR manifest missing : authlib-injector-1.2.8.jar';
		});
	};

	{
		title = "微软应用未进允许名单（403）";
		text = lines_to_text({
			'[错误] Minecraft 认证失败：Invalid app registration, see https://aka.ms/AppRegInfo for more information';
			'HTTP 403 - POST https://api.minecraftservices.com/authentication/login_with_xbox';
		});
	};
};

var current = 1;

function refresh_sample() {
	var sample = SAMPLES[current];
	if (!sample) return;

	winform.editSample.text = sample.text;
}

function refresh_result() {
	var sample = SAMPLES[current];
	if (!sample) return;

	var reasons = m3crash.analyze_text(sample.text);
	var suspects = m3crash.suspected_mods(sample.text);

	var out = {};

	if (#reasons == 0) {
		table.push(out, "（没有命中任何规则）");
	}
	else {
		for i, r in reasons {
			var line = "· " ++ r.title;
			if (#r.detail > 0) line = line ++ "　" ++ r.detail;
			table.push(out, line);
		}
	}

	table.push(out, "");
	if (#suspects == 0) {
		table.push(out, "疑似相关模组：（无）");
	}
	else {
		table.push(out, "疑似相关模组：" ++ table.concat(suspects, "、"));
	}

	winform.editResult.text = table.concat(out, '\r\n');
}

// 下拉项从 SAMPLES 生成：加样本只改上面那一处
for i, sample in SAMPLES {
	winform.comboCase.add(tostring(sample.title));
}
winform.comboCase.selIndex = 1;

winform.comboCase.onSelChange = function() {
	var i = winform.comboCase.selIndex;
	if (i <= 0) return;

	current = i;
	refresh_sample();
	refresh_result();
}

winform.btnAnalyze.oncommand = function(id, event) {
	refresh_result();
}

// 用样本写一个临时目录，造出（但先不显示）一个崩溃窗口
function build_crash_form(sample, idx) {
	var base = string.getenv("TEMP") ++ "\m3l-crash-test" ++ tostring(idx or 1);
	fsys.createDir(base ++ "\logs");
	fsys.createDir(base ++ "\mods");

	string.save(base ++ "\logs\latest.log", sample.text);
	string.save(base ++ "\mods\example-mod-1.0.0.jar", "");

	var frm = winform.loadForm("/dlg/crash.aardio");
	frm.bind({
		info = {
			version = "测试版本（" ++ sample.title ++ "）";
			game_dir = base;
			work_dir = base;
			java = "C:\Java\jre1.8.0_401\bin\javaw.exe";
			memory = 4096;
			exit_code = 1;
			seconds = 42;
		};
		logs = m3crash.collect(base);
		session = sample.text;
		cmdline = "javaw.exe -Xmx4096M -cp ... net.minecraft.client.main.Main";
		show_tip = false;
	});

	return frm;
}

// 用样本写一个临时目录，走进完整的崩溃窗口（模态，一次一个）
winform.btnOpen.oncommand = function(id, event) {
	var sample = SAMPLES[current];
	if (!sample) return;

	build_crash_form(sample, 1).doModal(winform);
}

// 多实例崩溃窗口：三个样本各开一个，非模态，验证它们能同时存在
winform.btnMulti.oncommand = function(id, event) {
	for i = 1; #SAMPLES; 1 {
		var sample = SAMPLES[i];
		if (!sample) continue;

		var frm = build_crash_form(sample, i);
		frm.center(winform);

		if (i > 1) {
			var rc = frm.getRect(true);
			var off = (i - 1) * 28;
			frm.setPos(rc.left + off, rc.top + off);
		}

		frm.show();
	}
}

winform.btnClose.oncommand = function(id, event) {
	winform.close();
}

// ---------- 初始化 ----------

refresh_sample();
refresh_result();

return winform;
