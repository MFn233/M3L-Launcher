//dlg/credits.aardio

//鸣谢。从关于窗口打开。
//只写「用了谁的什么」和「谁帮着测过」，不写客套话。
//正文用 richedit：内容会随测试者名单变长，必须能滚动。

import win.ui;
import m3theme;

/*DSG{{*/
var winform = win.form(text="鸣谢";right=520;bottom=420;bgcolor=0xF2F2F2;border="dialog frame";max=false;min=false)
winform.add(
lblTitle={cls="static";text="鸣谢";left=24;top=18;right=400;bottom=48;font=LOGFONT(name='Microsoft YaHei';h=-16;weight=700);z=1};
editCredits={cls="richedit";left=24;top=56;right=496;bottom=352;bgcolor=0xFFFFFF;readonly=1;multiline=1;vscroll=1;autohscroll=false;font=LOGFONT(name='Microsoft YaHei';h=-12);z=2};
btnClose={cls="plus";text="关闭";left=404;top=366;right=496;bottom=398;font=LOGFONT(name='Microsoft YaHei';h=-13);z=3};
)
/*}}*/

m3theme.ink(winform.lblTitle);
m3theme.ghost(winform.btnClose);

winform.editCredits.color = m3theme.C_INK;

// 往正文里追加一行：小标题用近黑，条目用次要灰
function line(text, is_heading) {
	winform.editCredits.readonly = false;

	if (is_heading) {
		winform.editCredits.appendText({ textColor = m3theme.C_INK }, text ++ '\r\n');
	}
	else {
		winform.editCredits.appendText({ textColor = m3theme.C_MUTED }, text ++ '\r\n');
	}

	winform.editCredits.readonly = true;
}

// ---------- 正文 ----------

line("第三方", true);
line("aardio · 开发工具与运行时");
line("Mojang · Minecraft 本体与版本清单格式");
line("HMCL · 崩溃原因分析规则的参考实现（GPL-3.0）");
line("");

line("实现协作", true);
line("DeepSeek · 代码实现、文档整理与测试");
line("");

line("参与测试", true);
line("（名单待补充）");
line("");

line("本项目为个人非营利项目，与上述公司、项目无隶属关系。", true);
line("「Minecraft」是 Mojang Studios 的商标，本项目与 Mojang 无关联。", true);

winform.btnClose.oncommand = function(id, event) {
	winform.close();
}

winform.onCancel = function() {
	winform.close();
}

return winform;
