//dlg/theme_test.aardio

//控件样式测试台：把所有控件样式摆一屏，改主题时对着一看就知道有没有跑偏。
//打开方式：右键主页标题「M³ Launcher」。

import win.ui;
import m3theme;

/*DSG{{*/
var winform = win.form(text="控件样式测试台";right=620;bottom=620;bgcolor=0xF2F2F2;border="dialog frame";max=false;min=false)
winform.add(
lblTitle={cls="static";text="控件样式测试台";left=24;top=16;right=400;bottom=42;font=LOGFONT(name='Microsoft YaHei';h=-14;weight=700);z=1};
line1={cls="plus";text="";left=24;top=50;right=596;bottom=51;z=2};
lblNote={cls="static";text="鼠标移上去看 hover / active；改 m3theme 之后对着这屏看有没有跑偏。";left=24;top=58;right=596;bottom=78;font=LOGFONT(name='Microsoft YaHei';h=-11);z=3};
lblSec1={cls="static";text="按钮";left=24;top=90;right=200;bottom=110;font=LOGFONT(name='Microsoft YaHei';h=-11);z=4};
btnPrimary={cls="plus";text="主要按钮";left=24;top=116;right=164;bottom=148;font=LOGFONT(name='Microsoft YaHei';h=-12);z=5};
btnGhost={cls="plus";text="次要按钮";left=172;top=116;right=312;bottom=148;font=LOGFONT(name='Microsoft YaHei';h=-12);z=6};
btnDisabled={cls="plus";text="禁用按钮";left=320;top=116;right=460;bottom=148;font=LOGFONT(name='Microsoft YaHei';h=-12);z=7};
btnDanger={cls="plus";text="危险按钮";left=468;top=116;right=596;bottom=148;font=LOGFONT(name='Microsoft YaHei';h=-12);z=29};
lblSec2={cls="static";text="分隔线 / 文字";left=24;top=162;right=300;bottom=182;font=LOGFONT(name='Microsoft YaHei';h=-11);z=8};
line2={cls="plus";text="";left=24;top=188;right=596;bottom=189;z=9};
lblInk={cls="static";text="主要文字";left=24;top=196;right=200;bottom=216;font=LOGFONT(name='Microsoft YaHei';h=-12);z=10};
lblMuted={cls="static";text="次要文字";left=208;top=196;right=400;bottom=216;font=LOGFONT(name='Microsoft YaHei';h=-12);z=11};
lblErr={cls="static";text="错误文字";left=408;top=196;right=596;bottom=216;font=LOGFONT(name='Microsoft YaHei';h=-12);z=12};
lblSec3={cls="static";text="输入";left=24;top=226;right=300;bottom=246;font=LOGFONT(name='Microsoft YaHei';h=-11);z=13};
edit1={cls="edit";text="正常输入框";left=24;top=252;right=300;bottom=278;bgcolor=0xFFFFFF;font=LOGFONT(name='Microsoft YaHei';h=-12);z=14};
edit2={cls="edit";text="禁用输入框";left=308;top=252;right=596;bottom=278;bgcolor=0xFFFFFF;font=LOGFONT(name='Microsoft YaHei';h=-12);z=15};
combo1={cls="combobox";left=24;top=288;right=300;bottom=378;mode="dropdownlist";font=LOGFONT(name='Microsoft YaHei';h=-12);z=16};
combo2={cls="combobox";left=308;top=288;right=596;bottom=378;mode="dropdownlist";font=LOGFONT(name='Microsoft YaHei';h=-12);z=17};
chk1={cls="checkbox";text="已选中";left=24;top=326;right=200;bottom=348;checked=1;bgcolor=0xF2F2F2;font=LOGFONT(name='Microsoft YaHei';h=-12);z=18};
chk2={cls="checkbox";text="未选中";left=208;top=326;right=384;bottom=348;bgcolor=0xF2F2F2;font=LOGFONT(name='Microsoft YaHei';h=-12);z=19};
chk3={cls="checkbox";text="禁用";left=392;top=326;right=596;bottom=348;bgcolor=0xF2F2F2;font=LOGFONT(name='Microsoft YaHei';h=-12);z=20};
lblSec4={cls="static";text="滑条";left=24;top=362;right=200;bottom=382;font=LOGFONT(name='Microsoft YaHei';h=-11);z=21};
slider={cls="plus";left=24;top=388;right=360;bottom=410;z=22};
lblSlider={cls="static";text="4096 MB";left=368;top=388;right=596;bottom=410;font=LOGFONT(name='Microsoft YaHei';h=-12);z=23};
lblSec5={cls="static";text="列表";left=24;top=422;right=200;bottom=442;font=LOGFONT(name='Microsoft YaHei';h=-11);z=24};
listDemo={cls="listview";mode="report";left=24;top=448;right=596;bottom=548;bgcolor=0xFFFFFF;font=LOGFONT(name='Microsoft YaHei';h=-12);z=25};
btnClose={cls="plus";text="关闭";left=496;top=566;right=596;bottom=598;font=LOGFONT(name='Microsoft YaHei';h=-13);z=26};
btnCrashTest={cls="plus";text="崩溃窗口测试台";left=24;top=566;right=196;bottom=598;font=LOGFONT(name='Microsoft YaHei';h=-12);z=27};
lblDpi={cls="static";text="";left=204;top=566;right=488;bottom=598;font=LOGFONT(name='Microsoft YaHei';h=-11);z=28};
)
/*}}*/

// 全部样式从主题库来，这里同时也是 m3theme 的展示页
m3theme.primary(winform.btnPrimary);
m3theme.ghost(winform.btnGhost);
m3theme.button(winform.btnDisabled);
m3theme.danger(winform.btnDanger);
m3theme.button(winform.btnCrashTest);
m3theme.ghost(winform.btnClose);

m3theme.rule(winform.line1);
m3theme.rule(winform.line2);

m3theme.ink(winform.lblTitle);
m3theme.ink(winform.lblInk);
m3theme.note(winform.lblNote);
m3theme.note(winform.lblMuted);
m3theme.note(winform.lblSec1);
m3theme.note(winform.lblSec2);
m3theme.note(winform.lblSec3);
m3theme.note(winform.lblSec4);
m3theme.note(winform.lblSec5);
m3theme.alert(winform.lblErr);

m3theme.field(winform.edit1);
m3theme.field(winform.edit2);
m3theme.ink(winform.lblSlider);

// 禁用态：按钮看 disabled 皮肤，输入框看系统灰化
winform.btnDisabled.disabled = true;
winform.edit2.disabled = true;
winform.chk3.disabled = true;

// 下拉框
winform.combo1.add("下拉框A");
winform.combo1.add("下拉框B");
winform.combo1.add("下拉框C");
winform.combo1.selIndex = 1;

winform.combo2.add("可编辑下拉框（其实是 dropdownlist）");
winform.combo2.selIndex = 1;

// 滑条
m3theme.slider(winform.slider);
winform.slider.setTrackbarRange(512, 16384);
winform.slider.progressPos = 4096;

// 列表
winform.listDemo.fullRow = true;
winform.listDemo.columns = {
	{ "名称"; 240 };
	{ "说明"; 300 };
};
winform.listDemo.addItem({ "第一行"; "普通文本" });
winform.listDemo.addItem({ "第二行"; "选中试试整行高亮" });
winform.listDemo.addItem({ "第三行"; "表头也能拖动宽度" });
winform.listDemo.selIndex = 1;

// 崩溃场景不好人为制造，用这个测试台看崩溃窗口和原因分析
winform.btnCrashTest.oncommand = function(id, event) {
	winform.loadForm("/dlg/crash_test.aardio").doModal(winform);
}

winform.btnClose.oncommand = function(id, event) {
	winform.endModal(true);
}

winform.onCancel = function() {
	winform.endModal(true);
}

// ---------- DPI 读数 ----------
// 测 DPI 时对着这一行看：缩放比例是多少、列表的设备像素宽 vs 逻辑宽。
// 列宽是按逻辑像素填的，m3list.fit 会先用 dpiScaleX 换算再比较。
function refresh_dpi() {
	var dpi = winform.dpiScaleX or 1;
	if (dpi <= 0) dpi = 1;

	var rc = winform.listDemo.getRect();
	var device_w = rc.right - rc.left;
	var logic_w = math.floor(device_w / dpi);

	winform.lblDpi.text = string.format("DPI %.2f×　列表 %d 设备px → %d 逻辑px", dpi, device_w, logic_w);
}

refresh_dpi();

winform.onSize = function(width, height, wParam) {
	refresh_dpi();
}

return winform;
