//dlg/theme_test.aardio

//控件样式测试台：把 m3theme 的每种用法摆一屏。
//改主题之后对着看：按钮三态、文字层级、输入、滑条、列表、日志着色有没有跑偏。
//打开方式：右键主页标题。

import win.ui;
import m3theme;

/*DSG{{*/
var winform = win.form(text="控件样式测试台";right=620;bottom=668;bgcolor=0xF2F2F2;border="dialog frame";max=false;min=false)
winform.add(
lblTitle={cls="static";text="控件样式测试台";left=24;top=16;right=420;bottom=44;font=LOGFONT(name='Microsoft YaHei';h=-15;weight=700);z=1};
lblNote={cls="static";text="改 m3theme 之后对着这一屏看；鼠标移上去查 hover / active。";left=24;top=48;right=596;bottom=68;font=LOGFONT(name='Microsoft YaHei';h=-11);z=2};
line1={cls="plus";text="";left=24;top=78;right=596;bottom=79;z=3};
lblSecBtn={cls="static";text="按钮";left=24;top=88;right=200;bottom=106;font=LOGFONT(name='Microsoft YaHei';h=-11);z=4};
btnPrimary={cls="plus";text="主要按钮";left=24;top=110;right=164;bottom=142;font=LOGFONT(name='Microsoft YaHei';h=-12);z=5};
btnGhost={cls="plus";text="次要按钮";left=172;top=110;right=312;bottom=142;font=LOGFONT(name='Microsoft YaHei';h=-12);z=6};
btnDisabled={cls="plus";text="禁用按钮";left=320;top=110;right=460;bottom=142;font=LOGFONT(name='Microsoft YaHei';h=-12);z=7};
lblSecText={cls="static";text="文字";left=24;top=156;right=200;bottom=174;font=LOGFONT(name='Microsoft YaHei';h=-11);z=8};
lblInk={cls="static";text="主要文字";left=24;top=178;right=140;bottom=198;font=LOGFONT(name='Microsoft YaHei';h=-12);z=9};
lblMuted={cls="static";text="次要文字";left=148;top=178;right=264;bottom=198;font=LOGFONT(name='Microsoft YaHei';h=-12);z=10};
lblErr={cls="static";text="错误文字";left=272;top=178;right=388;bottom=198;font=LOGFONT(name='Microsoft YaHei';h=-12);z=11};
lblMono={cls="static";text="C:\Program Files\Java\azul-25.0.2\bin\java.exe";left=24;top=204;right=596;bottom=224;font=LOGFONT(name='Consolas';h=-12);z=12};
lblSecInput={cls="static";text="输入";left=24;top=234;right=200;bottom=252;font=LOGFONT(name='Microsoft YaHei';h=-11);z=13};
edit1={cls="edit";text="单行输入框";left=24;top=256;right=300;bottom=284;font=LOGFONT(name='Microsoft YaHei';h=-12);z=14};
edit2={cls="edit";text="禁用输入框";left=308;top=256;right=596;bottom=284;font=LOGFONT(name='Microsoft YaHei';h=-12);z=15};
combo1={cls="combobox";left=24;top=292;right=300;bottom=352;mode="dropdownlist";font=LOGFONT(name='Microsoft YaHei';h=-12);z=16};
combo2={cls="combobox";left=308;top=292;right=596;bottom=352;mode="dropdownlist";font=LOGFONT(name='Microsoft YaHei';h=-12);z=17};
chk1={cls="checkbox";text="已选中";left=24;top=362;right=148;bottom=386;checked=1;bgcolor=0xF2F2F2;font=LOGFONT(name='Microsoft YaHei';h=-12);z=18};
chk2={cls="checkbox";text="未选中";left=156;top=362;right=280;bottom=386;bgcolor=0xF2F2F2;font=LOGFONT(name='Microsoft YaHei';h=-12);z=19};
chk3={cls="checkbox";text="禁用";left=288;top=362;right=380;bottom=386;bgcolor=0xF2F2F2;font=LOGFONT(name='Microsoft YaHei';h=-12);z=20};
lblSecSlider={cls="static";text="滑条";left=24;top=396;right=200;bottom=414;font=LOGFONT(name='Microsoft YaHei';h=-11);z=21};
slider={cls="plus";left=24;top=418;right=420;bottom=440;z=22};
lblSlider={cls="static";text="4096 MB";left=430;top=418;right=596;bottom=440;font=LOGFONT(name='Microsoft YaHei';h=-12);z=23};
lblSecList={cls="static";text="列表";left=24;top=450;right=200;bottom=468;font=LOGFONT(name='Microsoft YaHei';h=-11);z=24};
listDemo={cls="listview";mode="report";left=24;top=472;right=596;bottom=560;font=LOGFONT(name='Microsoft YaHei';h=-12);z=25};
lblSecLog={cls="static";text="日志着色";left=24;top=570;right=200;bottom=588;font=LOGFONT(name='Microsoft YaHei';h=-11);z=26};
editLog={cls="richedit";readonly=1;multiline=1;vscroll=1;autohscroll=false;left=24;top=592;right=596;bottom=628;font=LOGFONT(name='Consolas';h=-12);z=27};
btnClose={cls="plus";text="关闭";left=496;top=634;right=596;bottom=666;font=LOGFONT(name='Microsoft YaHei';h=-13);z=28}
)
/*}}*/

// ---------- 样式：全部来自主题库 ----------

m3theme.button(winform.btnPrimary);
m3theme.ghost(winform.btnGhost);
m3theme.button(winform.btnDisabled);
m3theme.button(winform.btnClose);

m3theme.rule(winform.line1);

m3theme.ink(winform.lblTitle);
m3theme.note(winform.lblNote);
m3theme.note(winform.lblSecBtn);
m3theme.note(winform.lblSecText);
m3theme.note(winform.lblSecInput);
m3theme.note(winform.lblSecSlider);
m3theme.note(winform.lblSecList);
m3theme.note(winform.lblSecLog);

m3theme.ink(winform.lblInk);
m3theme.note(winform.lblMuted);
m3theme.danger(winform.lblErr);
m3theme.ink(winform.lblMono);

m3theme.field(winform.edit1);
m3theme.field(winform.edit2);

m3theme.ink(winform.lblSlider);

// ---------- 禁用态 ----------

winform.btnDisabled.disabled = true;
winform.edit2.disabled = true;
winform.chk3.disabled = true;

// ---------- 下拉框 ----------

winform.combo1.add("下拉框 A");
winform.combo1.add("下拉框 B");
winform.combo1.add("下拉框 C");
winform.combo1.selIndex = 1;

winform.combo2.add("第二条下拉框");
winform.combo2.selIndex = 1;

// ---------- 滑条 ----------
// 三个状态的滑块形状只看 border.radius，所以这里放一条就能看出方形/圆角/圆

m3theme.slider(winform.slider);
winform.slider.setTrackbarRange(512, 16384);
winform.slider.progressPos = 4096;

// ---------- 列表 ----------

winform.listDemo.fullRow = true;
winform.listDemo.columns = {
	{ "名称"; 220 };
	{ "说明"; 320 };
};

winform.listDemo.addItem({ "第一行"; "普通行" });
winform.listDemo.addItem({ "第二行"; "选中行（整行高亮）" });
winform.listDemo.addItem({ "第三行"; "表头可拖动列宽" });
winform.listDemo.selIndex = 2;

// ---------- 日志着色 ----------
// 和日志窗口同一套：错误红加粗、警告黑加粗、信息近黑、调试灰

winform.editLog.color = m3theme.C_INK;
winform.editLog.bgcolor = m3theme.C_FIELD;

function log_line(text, kind) {
	winform.editLog.readonly = false;

	if (kind == "error") {
		winform.editLog.appendText({ textColor = m3theme.C_RED; bold = true }, text ++ '\r\n');
	}
	elseif (kind == "warn") {
		winform.editLog.appendText({ textColor = m3theme.C_INK; bold = true }, text ++ '\r\n');
	}
	elseif (kind == "debug") {
		winform.editLog.appendText({ textColor = m3theme.C_MUTED }, text ++ '\r\n');
	}
	else {
		winform.editLog.appendText({ textColor = m3theme.C_INK }, text ++ '\r\n');
	}

	winform.editLog.readonly = true;
}

log_line("[错误] 找不到库文件：libraries/…", "error");
log_line("[警告] 缺少 3 个库文件。", "warn");
log_line("[提示] 已启动，PID = 1234", "info");
log_line("[调试] 启动命令：java -Xmx4096M …", "debug");

// ---------- 关闭 ----------

winform.btnClose.oncommand = function(id, event) {
	winform.endModal(true);
}

winform.onCancel = function() {
	winform.endModal(true);
}

return winform;
