//dlg/paths.aardio

//游戏路径管理：维护多个 .minecraft 路径，可重命名、删除、设为当前。
//列表和 Java 管理一样用「详细信息」视图：名称 / 路径 两列，横竖都能滚。

import win.ui;
import m3theme;
import m3list;
import m3config;
import process;
import fsys.dlg;
import string;
/*DSG{{*/
var winform = win.form(text="游戏路径管理";right=600;bottom=400;bgcolor=0xF2F2F2;border="dialog frame";max=false;min=false)
winform.add(
btnAdd={cls="plus";text="添加";left=16;top=340;right=120;bottom=372;font=LOGFONT(name='Microsoft YaHei');z=6};
btnClose={cls="plus";text="关闭";left=464;top=340;right=584;bottom=372;font=LOGFONT(name='Microsoft YaHei');z=9};
btnCurrent={cls="plus";text="设为当前";left=240;top=340;right=360;bottom=372;font=LOGFONT(name='Microsoft YaHei');z=8};
btnOpen={cls="plus";text="打开目录";left=368;top=340;right=456;bottom=372;font=LOGFONT(name='Microsoft YaHei');z=10};
btnRemove={cls="plus";text="删除";left=128;top=340;right=232;bottom=372;font=LOGFONT(name='Microsoft YaHei');z=7};
btnRename={cls="plus";text="重命名";left=400;top=300;right=584;bottom=324;font=LOGFONT(name='Microsoft YaHei');z=5};
editName={cls="edit";left=72;top=300;right=392;bottom=324;bgcolor=0xFFFFFF;font=LOGFONT(name='Microsoft YaHei');z=4};
lblHint={cls="static";text="选中一条路径后可以重命名、删除或设为当前。官方目录不能删除。";left=16;top=12;right=584;bottom=32;font=LOGFONT(h=-11;name='Microsoft YaHei');z=1};
lblName={cls="static";text="名称";left=16;top=304;right=68;bottom=324;font=LOGFONT(name='Microsoft YaHei');z=3};
listPaths={cls="listview";left=16;top=38;right=584;bottom=290;bgcolor=0xFFFFFF;font=LOGFONT(name='Microsoft YaHei');z=2}
)
/*}}*/

m3theme.note(winform.lblHint);
m3theme.note(winform.lblName);
m3theme.field(winform.editName);

m3theme.button(winform.btnRename);
m3theme.button(winform.btnAdd);
m3theme.button(winform.btnRemove);
m3theme.button(winform.btnCurrent);
m3theme.button(winform.btnOpen);
m3theme.ghost(winform.btnClose);

var cfg = null;
var rows = {};
var selected_dir = null;

function render() {
	winform.listPaths.clear();
	rows = {};

	for i, p in cfg.game_paths {
		var name = p.name;
		if (!name or #name == 0) name = io.splitpath(p.dir).name;

		// 标记按设计放在名称前面
		var mark = "";
		if (p.official) mark = mark ++ "[官方] ";
		if (cfg.game_path == p.dir) mark = mark ++ "[当前] ";

		winform.listPaths.addItem({ mark ++ name; p.dir });
		table.push(rows, i);
	}

	// 按目录找回选中项，重建列表不会把选中状态弄丢
	if (selected_dir) {
		var at = 0;
		for i, idx in rows {
			var p = cfg.game_paths[idx];
			if (p and p.dir == selected_dir) {
				at = i;
				break;
			}
		}

		if (at > 0) {
			winform.listPaths.selIndex = at;
		}
		else {
			selected_dir = null;
		}
	}
}

function current_index() {
	// 优先用控件当前的选中项
	var i = winform.listPaths.selIndex;
	if (i > 0 and i <= #rows) {
		var p = cfg.game_paths[rows[i]];
		if (p) return rows[i];
	}

	if (!selected_dir) return 0;

	for i, p in cfg.game_paths {
		if (p.dir == selected_dir) return i;
	}

	return 0;
}

winform.btnAdd.oncommand = function(id, event) {
	var dir = fsys.dlg.openDir("", winform, "选择 .minecraft 目录");
	if (!dir) return;

	for i, p in cfg.game_paths {
		if (p.dir == dir) {
			winform.lblHint.text = "此游戏路径已在列表当中。";
			return;
		}
	}

	table.push(cfg.game_paths, { name = io.splitpath(dir).name; dir = dir; official = false });

	selected_dir = dir;

	m3config.save_keys(cfg, {"game_paths"; "game_path"});
	render();
}

winform.btnRemove.oncommand = function(id, event) {
	var i = current_index();
	if (i == 0) {
		winform.lblHint.text = "请先选择一条游戏路径。";
		return;
	}

	var p = cfg.game_paths[i];
	if (p.official) {
		winform.lblHint.text = "官方目录不允许删除。";
		return;
	}

	// 先确认，避免误删（名字太长时截断，否则确认框会被撑破）
	var show_name = p.name or p.dir;
	if (#show_name > 20) show_name = string.slice(show_name, 1, 20) ++ "…";

	var frm = winform.loadForm("/dlg/confirm.aardio");
	frm.lblMsg.text = "确定删除路径「" ++ show_name ++ "」吗？" ++ '\r\n\r\n' ++ "改路径会从列表里移除。（不会删除磁盘上的文件夹）";
	if (!frm.doModal(winform)) return;

	// 重建数组，避免 table.remove 留下空洞
	var list = {};
	for k, item in cfg.game_paths {
		if (k != i) table.push(list, item);
	}
	cfg.game_paths = list;

	selected_dir = null;

	// 删掉的正好是当前路径，就切回第一条
	if (cfg.game_path == p.dir) {
		if (cfg.game_paths[1]) {
			cfg.game_path = cfg.game_paths[1].dir;
		}
		else {
			cfg.game_path = "";
		}
	}

	m3config.save_keys(cfg, {"game_paths"; "game_path"});
	render();
}

winform.btnRename.oncommand = function(id, event) {
	var i = current_index();
	if (i == 0) {
		winform.lblHint.text = "请先选择一条游戏路径。";
		return;
	}

	var name = string.trim(winform.editName.text);
	if (#name == 0) {
		winform.lblHint.text = "请先填写名称。";
		return;
	}

	cfg.game_paths[i].name = name;
	m3config.save_keys(cfg, {"game_paths"; "game_path"});
	render();
}

winform.btnCurrent.oncommand = function(id, event) {
	var i = current_index();
	if (i == 0) {
		winform.lblHint.text = "请先选择一条游戏路径。";
		return;
	}

	cfg.game_path = cfg.game_paths[i].dir;
	m3config.save_keys(cfg, {"game_paths"; "game_path"});
	render();
}

// 打开所选路径
winform.btnOpen.oncommand = function(id, event) {
	var i = current_index();
	if (i == 0) {
		winform.lblHint.text = "请先选择一条游戏路径。";
		return;
	}

	var dir = cfg.game_paths[i].dir;
	if (!io.exist(dir)) {
		winform.lblHint.text = "该目录已被删除或迁移：" ++ dir;
		return;
	}

	process.explore(dir);
}

winform.listPaths.onSelChanged = function(sel, item, subItem, nm) {
	var i = winform.listPaths.selIndex;
	if (i <= 0 or i > #rows) return;

	var p = cfg.game_paths[rows[i]];
	if (!p) return;

	selected_dir = p.dir;
	winform.editName.text = p.name or "";
}

// 列宽（拖列头调过之后）存起来
function save_columns() {
	cfg.paths_columns = winform.listPaths.columns;
}

winform.btnClose.oncommand = function(id, event) {
	save_columns();
	m3config.save_keys(cfg, {"game_paths"; "game_path"; "paths_columns"});
	winform.endModal(true);
}

winform.onCancel = function() {
	save_columns();
	m3config.save_keys(cfg, {"game_paths"; "game_path"; "paths_columns"});
	winform.endModal(true);
}

// ---------- 初始化 ----------

cfg = m3config.read();

winform.listPaths.fullRow = true;

var saved_cols = cfg.paths_columns;
if (type(saved_cols) == "table" and #saved_cols >= 2) {
	winform.listPaths.columns = saved_cols;
}
else {
	winform.listPaths.columns = {
		{ "名称"; 150 };
		{ "路径"; 700 };
	};
}

// 列宽按列表宽度自适应，路径太长就截断显示，不留横向滚动
m3list.fit(winform.listPaths);
m3list.limit_width(winform.listPaths, 56);

// 列宽只在打开窗口时规整一次；拖动不干预

render();

return winform;
