//migrate-layout.aardio

//把旧布局的运行时文件搬进 M3L\ 子目录。命令行小程序，放在启动器同目录运行。
//
//用法：
//   直接双击 / F5        → 检查启动器目录，列出将要移动的文件，确认后执行
//   M3L-migrate.exe D:\path\to\launcher        → 指定启动器目录
//   M3L-migrate.exe D:\path --dry              → 只看计划，不动文件
//
//规则与启动器内的自动迁移完全一致（都走 lib/m3paths.aardio），
//所以重复运行安全：已经搬过的不会再搬，新位置已有文件的不会覆盖。

import console;
import m3paths;
import fsys;
import string;

console.setTitle("M3L 目录迁移");

// ---------- 取启动器目录 ----------

var args = _CMDLINE or "";
var dry = false;
var base = "";

// 简单解析：去掉可能的引号，第一个非 -- 的参数当目录
var parts = string.split(args, " ");
for i, p in parts {
	p = string.trim(string.replace(p, '"', ""));

	if (#p == 0) continue;
	if (string.startsWith(p, "--")) {
		if (p == "--dry") dry = true;
		continue;
	}

	if (#base == 0) base = p;
}

// 没指定就看当前 exe 所在目录；F5 时那是 aardio 的目录，需要用户自己给
if (#base == 0) {
	var cur = io.splitpath(io._exepath).dir;
	var exe_name = string.lower(io.splitpath(io._exepath).name or "");

	if (string.indexOf(exe_name, "aardio")) {
		console.log("当前是在 IDE 里运行，程序目录是 aardio 的目录，不能当作启动器目录。");
		console.log("请输入启动器所在目录（例如 D:\\Launcher）：");
		base = string.trim(console.getText());
	}
	else {
		base = cur;
	}
}

if (#base == 0 or !io.exist(base)) {
	console.log("[错误] 目录不存在：" ++ tostring(base));
	console.pause();
	return;
}

m3paths.set_base(base);

console.log("--------------------------------------------------");
console.log("启动器目录：" ++ m3paths.dir());
console.log("目标目录  ：" ++ m3paths.root());
console.log("--------------------------------------------------");
console.log("");

// ---------- 列计划 ----------

var list = m3paths.plan();

if (#list == 0) {
	console.log("没有需要迁移的文件。");
	console.pause();
	return;
}

console.log("将要移动 " ++ #list ++ " 项：");
for i, item in list {
	console.log("  " ++ item.src);
	console.log("      → " ++ item.dst);
}

console.log("");

if (dry) {
	console.log("（--dry：只列计划，未改动任何文件）");
	console.pause();
	return;
}

console.log("确认执行？(y = 执行，其它 = 取消)");
var yes = string.lower(string.trim(console.getText()));

if (yes != "y") {
	console.log("已取消，未改动任何文件。");
	console.pause();
	return;
}

// ---------- 执行 ----------

console.log("");
var r = m3paths.migrate(function(text) { console.log("  " + text); });

console.log("");
console.log("完成：移动 " ++ r.moved ++ " 项，失败 " ++ r.failed ++ " 项。");

if (r.failed > 0) {
	console.log("失败的项仍在原位置，可以手动移动；目标目录：" ++ m3paths.root());
}

console.log("");
console.log("按任意键退出…");
console.pause();
