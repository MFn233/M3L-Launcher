//m3toml.aardio
//极简 TOML 读取器（只覆盖 Mod 的 mods.toml / neoforge.mods.toml 用到的子集）。
//
//为什么自己写：aardio 的 string.toml 是扩展库，当前环境没安装；
//而"逐行 + 正则"的做法会被这些情况骗到：
//  1. 行内注释：modId="x" # 主标识
//  2. 注释里的引号：license="MIT"   # 不是 "GPL"
//  3. 引号里的 #：description="a # b"
//  4. 多行字符串、跨行数组
//
//支持：基本字符串 "..."（识别 \ 转义）、字面字符串 '...'、多行 """...""" 与 '''...'''、
//布尔、数字、数组、内联表、表头 [a.b]、表数组 [[mods]]。

namespace m3toml {

	var CH_BACKSLASH = '\\';
	var CH_HASH = "#";
	var CH_DQUOTE = '"';
	var CH_SQUOTE = "'";

	// 去掉字符串之外的行内注释
	function strip_comment(line) {
		var out = "";
		var i = 1;
		var n = #line;
		var quote = 0;   // 0 无 / 1 双引号 / 2 单引号

		while (i <= n) {
			var ch = ..string.left(..string.slice(line, i), 1);

			if (quote == 0) {
				if (ch == CH_HASH) break;

				if (ch == CH_DQUOTE) quote = 1;
				elseif (ch == CH_SQUOTE) quote = 2;
			}
			elseif (quote == 1) {
				if (ch == CH_BACKSLASH) {
					// 转义：把下一个字符原样保留，别让它把引号收掉
					out = out ++ ch;
					i = i + 1;
					if (i <= n) out = out ++ ..string.left(..string.slice(line, i), 1);
					i = i + 1;
					continue;
				}

				if (ch == CH_DQUOTE) quote = 0;
			}
			else {
				if (ch == CH_SQUOTE) quote = 0;
			}

			out = out ++ ch;
			i = i + 1;
		}

		return out;
	}

	// 基本字符串里的转义
	function unescape(s) {
		var out = "";
		var i = 1;
		var n = #s;

		while (i <= n) {
			var ch = ..string.left(..string.slice(s, i), 1);

			if (ch != CH_BACKSLASH) {
				out = out ++ ch;
				i = i + 1;
				continue;
			}

			var nxt = "";
			if (i < n) nxt = ..string.left(..string.slice(s, i + 1), 1);

			if (nxt == "n") out = out ++ ..string.chr(10);
			elseif (nxt == "t") out = out ++ ..string.chr(9);
			elseif (nxt == "r") out = out ++ ..string.chr(13);
			elseif (nxt == '"') out = out ++ CH_DQUOTE;
			elseif (nxt == CH_BACKSLASH) out = out ++ CH_BACKSLASH;
			else out = out ++ nxt;

			i = i + 2;
		}

		return out;
	}

	// 按分隔符切分，但跳过括号/引号内部（用于数组与内联表）
	function split_top(s, sep) {
		var parts = {};
		var buf = "";
		var depth = 0;
		var quote = 0;
		var i = 1;
		var n = #s;

		while (i <= n) {
			var ch = ..string.left(..string.slice(s, i), 1);

			if (quote == 0) {
				if (ch == CH_DQUOTE or ch == CH_SQUOTE) {
					if (ch == CH_DQUOTE) quote = 1;
					else quote = 2;
				}
				elseif (ch == "[") depth = depth + 1;
				elseif (ch == "]") depth = depth - 1;
				elseif (ch == "{") depth = depth + 1;
				elseif (ch == "}") depth = depth - 1;
				elseif (ch == sep and depth == 0) {
					..table.push(parts, buf);
					buf = "";
					i = i + 1;
					continue;
				}
			}
			elseif (quote == 1) {
				if (ch == CH_BACKSLASH) {
					buf = buf ++ ch;
					i = i + 1;
					if (i <= n) buf = buf ++ ..string.left(..string.slice(s, i), 1);
					i = i + 1;
					continue;
				}

				if (ch == CH_DQUOTE) quote = 0;
			}
			else {
				if (ch == CH_SQUOTE) quote = 0;
			}

			buf = buf ++ ch;
			i = i + 1;
		}

		..table.push(parts, buf);

		return parts;
	}

	// 找最外层（不在引号里）的等号位置
	function find_top_eq(s) {
		var quote = 0;
		var i = 1;
		var n = #s;

		while (i <= n) {
			var ch = ..string.left(..string.slice(s, i), 1);

			if (quote == 0) {
				if (ch == "=") return i;

				if (ch == CH_DQUOTE) quote = 1;
				elseif (ch == CH_SQUOTE) quote = 2;
			}
			elseif (quote == 1) {
				if (ch == CH_BACKSLASH) {
					i = i + 2;
					continue;
				}

				if (ch == CH_DQUOTE) quote = 0;
			}
			else {
				if (ch == CH_SQUOTE) quote = 0;
			}

			i = i + 1;
		}

		return null;
	}

	// 值是否还没写完（跨行数组 / 内联表 / 多行字符串）
	function incomplete(s) {
		var v = ..string.trim(s);

		if (#v == 0) return false;

		// 多行字符串
		if (#v >= 3 and ..string.left(v, 3) == '"""') {
			if (#v >= 6 and ..string.slice(v, #v - 2) == '"""') return false;

			return true;
		}

		if (#v >= 3 and ..string.left(v, 3) == "'''") {
			if (#v >= 6 and ..string.slice(v, #v - 2) == "'''") return false;

			return true;
		}

		var depth = 0;
		var quote = 0;
		var i = 1;
		var n = #v;

		while (i <= n) {
			var ch = ..string.left(..string.slice(v, i), 1);

			if (quote == 0) {
				if (ch == CH_DQUOTE) quote = 1;
				elseif (ch == CH_SQUOTE) quote = 2;
				elseif (ch == "[") depth = depth + 1;
				elseif (ch == "]") depth = depth - 1;
				elseif (ch == "{") depth = depth + 1;
				elseif (ch == "}") depth = depth - 1;
			}
			elseif (quote == 1) {
				if (ch == CH_BACKSLASH) {
					i = i + 2;
					continue;
				}

				if (ch == CH_DQUOTE) quote = 0;
			}
			else {
				if (ch == CH_SQUOTE) quote = 0;
			}

			i = i + 1;
		}

		return (depth > 0 or quote > 0);
	}

	// 解析一个值
	function parse_value(s) {
		var v = ..string.trim(s);

		if (#v == 0) return "";

		var first = ..string.left(v, 1);

		// 多行字符串
		if (#v >= 3 and ..string.left(v, 3) == '"""') {
			var body = ..string.slice(v, 4);
			if (#body >= 3 and ..string.slice(body, #body - 2) == '"""') {
				body = ..string.left(body, #body - 3);
			}

			return unescape(body);
		}

		if (#v >= 3 and ..string.left(v, 3) == "'''") {
			var body = ..string.slice(v, 4);
			if (#body >= 3 and ..string.slice(body, #body - 2) == "'''") {
				body = ..string.left(body, #body - 3);
			}

			return body;
		}

		// 普通字符串
		if (first == CH_DQUOTE or first == CH_SQUOTE) {
			var body = ..string.slice(v, 2);

			if (#body > 0 and ..string.slice(body, #body) == first) {
				body = ..string.left(body, #body - 1);
			}

			if (first == CH_SQUOTE) return body;   // 字面字符串：不处理转义

			return unescape(body);
		}

		if (v == "true") return true;
		if (v == "false") return false;

		// 数组
		if (first == "[") {
			var body = ..string.trim(..string.slice(v, 2));
			if (#body > 0 and ..string.slice(body, #body) == "]") {
				body = ..string.left(body, #body - 1);
			}

			var list = {};
			var parts = split_top(body, ",");

			for i, p in parts {
				if (#..string.trim(p) > 0) ..table.push(list, parse_value(p));
			}

			return list;
		}

		// 内联表
		if (first == "{") {
			var body = ..string.trim(..string.slice(v, 2));
			if (#body > 0 and ..string.slice(body, #body) == "}") {
				body = ..string.left(body, #body - 1);
			}

			var t = {};
			var parts = split_top(body, ",");

			for i, p in parts {
				var at = find_top_eq(p);
				if (!at) continue;

				var k = unescape(..string.trim(..string.left(p, at - 1)));
				t[k] = parse_value(..string.slice(p, at + 1));
			}

			return t;
		}

		// 数字、日期等：原样保留字符串
		return v;
	}

	// 取（或建）子表：按 a.b.c 路径
	function ensure_table(root, path) {
		var cur = root;
		var parts = ..string.split(path, ".");

		for i, p in parts {
			var k = unescape(..string.trim(p));
			if (#k == 0) continue;

			if (type(cur[k]) != "table") cur[k] = {};
			cur = cur[k];
		}

		return cur;
	}

	// 解析 TOML 文本 → table
	function parse(text) {
		var root = {};
		var cur = root;

		if (type(text) != "string") return root;

		// 统一换行后按行处理（跨行值会被合并到一行）
		var body = ..string.replace(text, ..string.chr(13), "");
		var lines = ..string.split(body, ..string.chr(10));

		var i = 1;
		var n = #lines;

		while (i <= n) {
			var line = ..string.trim(strip_comment(lines[i]));

			if (#line == 0) {
				i = i + 1;
				continue;
			}

			// 表数组 [[mods]]
			if (#line >= 4 and ..string.left(line, 2) == "[[") {
				var name = ..string.trim(..string.slice(line, 3));
				var tail = ..string.slice(name, #name - 1);
				if (tail == "]]") name = ..string.left(name, #name - 2);

				var key = unescape(..string.trim(name));
				var parent = root;
				var dot = ..string.lastIndexOf(key, ".");

				if (dot) {
					parent = ensure_table(root, ..string.left(key, dot - 1));
					key = ..string.slice(key, dot + 1);
				}

				if (type(parent[key]) != "table") parent[key] = {};

				var item = {};
				..table.push(parent[key], item);

				cur = item;
				i = i + 1;
				continue;
			}

			// 表头 [a.b]
			if (..string.left(line, 1) == "[") {
				var name = ..string.trim(..string.slice(line, 2));
				if (#name > 0 and ..string.slice(name, #name) == "]") {
					name = ..string.left(name, #name - 1);
				}

				cur = ensure_table(root, unescape(..string.trim(name)));
				i = i + 1;
				continue;
			}

			// key = value
			var at = find_top_eq(line);
			if (!at) {
				i = i + 1;
				continue;   // 不认识的写法，跳过
			}

			var key = unescape(..string.trim(..string.left(line, at - 1)));
			var val = ..string.slice(line, at + 1);

			// 跨行值：数组 / 内联表 / 多行字符串
			while (incomplete(val) and i < n) {
				i = i + 1;
				val = val ++ " " ++ ..string.trim(strip_comment(lines[i]));
			}

			if (#key == 0) {
				i = i + 1;
				continue;
			}

			var dot2 = ..string.lastIndexOf(key, ".");
			if (dot2) {
				var parent = ensure_table(cur, ..string.left(key, dot2 - 1));
				parent[..string.slice(key, dot2 + 1)] = parse_value(val);
			}
			else {
				cur[key] = parse_value(val);
			}

			i = i + 1;
		}

		return root;
	}
}
