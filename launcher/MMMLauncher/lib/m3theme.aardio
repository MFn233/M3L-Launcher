//m3theme.aardio

//控件主题：黑/白/灰三色的唯一定义处，外加 plus 控件的 skin 套用函数。
//窗口里不要再写死颜色，统一 m3theme.button(...) / m3theme.note(...) 这样调用。

namespace m3theme {

	// ---------- 颜色 ----------
	// 这里的颜色是**唯一的定义处**：以后做深色模式或自定义主题，只改这一段。
	// 名字按用途取（BG / SIDEBAR / FOOTER / FIELD …），不要按色值取（GREY1 / LIGHT2）。
	//
	// 注意：所有灰都写成等值 RGB（如 0xE9E9E9），这样 ARGB 与 COLORREF 两种格式
	// 数值相同，省掉一次转换，也不会写反。

	// plus 的 skin、argbColor 用 ARGB（0xAARRGGBB）
	INK   = 0xFF1A1A1A;   // 近黑，主文字/边框
	WHITE = 0xFFFFFFFF;
	BG    = 0xFFF2F2F2;   // 窗口 / 内容区背景
	MUTED = 0xFF8C8C8C;   // 次要文字
	LINE  = 0xFFD8D8D8;   // 分隔线
	TRACK = 0xFFE2E2E2;   // 滑条轨道
	DIS   = 0xFFEDEDED;   // 禁用底
	DISFG = 0xFF9C9C9C;   // 禁用字
	RED   = 0xFFD03030;   // 错误

	// 分区用色（设置窗口的三区）
	SIDEBAR    = 0xFFE9E9E9;   // 左侧导航面板
	SIDEBAR_HOVER = 0xFFE2E2E2; // 导航悬停
	SIDEBAR_SEL = 0xFFDCDCDC;  // 导航选中项
	FOOTER     = 0xFFECECEC;   // 底部条
	DIVIDE     = 0xFFD8D8D8;   // 分区之间的 1px 线

	// 控件用色
	FRAME   = 0xFFDCDCDC;   // 分组框边框
	FIELD   = 0xFFFFFFFF;   // 输入框 / 列表底
	CARD    = 0xFFFFFFFF;   // 卡片、次级按钮底

	// static / edit 的 color 属性用 COLORREF（0xBBGGRR，和 ARGB 分量顺序相反）
	// 上面的灰都是等值 RGB，所以下面直接照抄数值即可
	C_INK   = 0x1A1A1A;
	C_MUTED = 0x8C8C8C;
	C_BG    = 0xF2F2F2;   // 窗口背景的 COLORREF：静态文本要和它一致，否则会露出一块浅灰
	C_RED   = 0x3030D0;   // #D03030 的 COLORREF
	C_SIDEBAR = 0xE9E9E9;
	C_FOOTER  = 0xECECEC;
	C_FIELD   = 0xFFFFFF;
	C_FRAME   = 0xDCDCDC;

	// ARGB → COLORREF
	// ARGB 是 0xAARRGGBB（低字节是 BB），COLORREF 是 0x00BBGGRR（低字节是 RR），
	// 所以 R 和 B 要互换。另外不要对大于 2^31 的值做 >>，这里用除法逐字节取。
	function toRef(argb) {
		var r = ..math.floor(argb / 0x10000) % 0x100;   // 0xAARRGGBB 里的 RR
		var g = ..math.floor(argb / 0x100) % 0x100;
		var b = argb % 0x100;                            // 0xAARRGGBB 里的 BB
		return r | (g << 8) | (b << 16);
	}

	// ---------- skin ----------

	// 主要按钮：白底、1px 黑框，悬停整块反色
	function button(ctrl) {
		if (!ctrl) return;

		ctrl.skin({
			background = { default = WHITE; hover = INK; disabled = DIS };
			color = { default = INK; hover = WHITE; disabled = DISFG };
			border = { color = INK; width = 1; radius = 0 };
		});
	}

	// 次要按钮：无框灰字，悬停变黑（关闭 / 取消那种）
	function ghost(ctrl) {
		if (!ctrl) return;

		ctrl.skin({
			background = { default = BG; hover = BG };
			color = { default = MUTED; hover = INK };
		});
	}

	// 无框无底：主页标题那种
	function plain(ctrl) {
		if (!ctrl) return;

		ctrl.skin({
			background = { default = BG; hover = BG };
			color = { default = INK; hover = INK };
		});
	}

	// 分隔线：1px 高的 plus，只填色
	function rule(ctrl) {
		if (!ctrl) return;

		ctrl.skin({
			background = { default = LINE };
		});
	}

	// 滑条。plus 的滑块形状只看 border.radius：
	//   <0 画正圆、>0 画圆角矩形、没有就画方块。
	// 三个状态必须都写死，否则鼠标移入移出后形状会变不回来。
	function slider(ctrl) {
		if (!ctrl) return;

		ctrl.skin({
			background = { default = TRACK };
			foreground = { default = INK };
			color = { default = INK; hover = INK; active = INK };
			border = {
				default = { radius = -1 };
				hover = { radius = -1 };
				active = { radius = -1 };
			};
		});
	}

	// ---------- 文字颜色 ----------

	// 输入框：文字色 + 底色都走主题（深色模式下要一起换）
	function field(ctrl) {
		if (!ctrl) return;
		ctrl.color = C_INK;
		ctrl.bgcolor = C_FIELD;
	}

	// 静态文本：主要文字
	function ink(ctrl) {
		if (!ctrl) return;
		ctrl.color = C_INK;
		ctrl.bgcolor = C_BG;
	}

	// 静态文本：说明 / 标签
	function note(ctrl) {
		if (!ctrl) return;
		ctrl.color = C_MUTED;
		ctrl.bgcolor = C_BG;
	}

	// 静态文本：错误（不能叫 error：那是 aardio 的内置保留函数，会报
	// Can't modify the constant: 'error'）
	function danger(ctrl) {
		if (!ctrl) return;
		ctrl.color = C_RED;
		ctrl.bgcolor = C_BG;
	}

	// 窗口底色统一：DSG 里的 bgcolor 是设计器写死的，这里运行时覆盖一次，
	// 以后改主题只改 C_BG 一处（12 个对话框都不再各自为准）。
	function window(f) {
		if (!f) return;

		f.bgcolor = C_BG;

		return f;
	}
}

/**intellisense(m3theme)
// 颜色 token：按用途命名，深色模式只改这一段
INK = 近黑 #1A1A1A（ARGB，plus 的 skin 用）
WHITE = 纯白
BG = 窗口 / 内容区背景 #F2F2F2
MUTED = 次要文字 #8C8C8C
LINE = 分隔线 #D8D8D8
TRACK = 滑条轨道 #E2E2E2
DIS = 禁用状态底色
DISFG = 禁用状态文字
RED = 错误红 #D03030
SIDEBAR = 左侧导航面板底 #E9E9E9
SIDEBAR_HOVER = 导航项悬停底 #E2E2E2
SIDEBAR_SEL = 导航项选中底 #DCDCDC
FOOTER = 底部条底 #ECECEC
DIVIDE = 分区之间的 1px 线 #D8D8D8
FRAME = 分组框边框 #DCDCDC
FIELD = 输入框 / 列表底 #FFFFFF
CARD = 卡片 / 次级按钮底 #FFFFFF
C_INK / C_MUTED / C_BG / C_RED = 对应的 COLORREF（static / edit 的 color、bgcolor 用）
C_SIDEBAR / C_FOOTER / C_FIELD / C_FRAME = 分区色的 COLORREF
toRef(__/*argb*/) = ARGB 转 COLORREF
button(__/*控件*/) = 主要按钮：白底、1px 黑框，悬停整块反色
ghost(__/*控件*/) = 次要按钮：无框灰字，悬停变黑
plain(__/*控件*/) = 无框无底，主页标题那种
rule(__/*控件*/) = 分隔线：1px 高的 plus，只填色
slider(__/*控件*/) = 滑条：圆形滑块，三个状态形状一致
field(__/*控件*/) = 输入框：文字色 + 底色
window(__/*窗口*/) = 窗口底色统一（DSG 里的 bgcolor 会被它覆盖）
ink(__/*控件*/) = 静态文本：主要文字
note(__/*控件*/) = 静态文本：说明 / 标签
danger(__/*控件*/) = 静态文本：错误红（不能叫 error，和内置函数冲突）
end intellisense**/
