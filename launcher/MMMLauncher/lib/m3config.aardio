//m3config.aardio

//启动器配置：单文件 config.json，跟程序放一起（portable）。
//core 不读这个文件，只接收参数。

namespace m3config{
	import io;
	import fsys;
	import json;
	import string;
	import table;
	import m3paths;
	import m3secret;

	//运行时文件都在 M3L\ 下（见 lib/m3paths.aardio）
	function file_path() {
		return m3paths.config();
	}

	function old_file_path() {
		return io.fullpath("/config.txt");
	}

	// 设置窗口的草稿：改了但还没点「保存」的值先写在这里。
	// 只存"值类设置"，列表类操作（删账号/删版本等）本身是提交动作，仍然立即写 config.json。
	function draft_path() {
		return m3paths.draft();
	}

	function load_draft() {
		var f = draft_path();
		if (!io.exist(f)) return null;

		var data = json.load(f);
		if (type(data) != "table") return null;

		return data;
	}

	function save_draft(t) {
		json.save(draft_path(), t);
	}

	function clear_draft() {
		var f = draft_path();
		if (io.exist(f)) fsys.delete(f);
	}


	// ---------- 版本隔离 ----------
	//
	// 键必须是「游戏目录 + 版本名」：只用版本名的话，
	// 不同 .minecraft 里同名版本的隔离状态会互相干扰（踩过）。
	// 表里只记「关掉隔离」的版本（值恒为 true），没有记录 = 隔离。

	function shared_key(minecraft_dir, name) {
		return string.lower(minecraft_dir or "") ++ "|" ++ (name or "");
	}

	function is_isolated(cfg, minecraft_dir, name) {
		if (!cfg.shared) return true;
		if (cfg.shared[shared_key(minecraft_dir, name)]) return false;
		return true;
	}

	function set_isolated(cfg, minecraft_dir, name, boolIsolated) {
		cfg.shared = cfg.shared or {};

		var k = shared_key(minecraft_dir, name);
		if (boolIsolated) cfg.shared[k] = null;
		else cfg.shared[k] = true;
	}

	// 旧配置里 shared 的键是裸版本名，迁到当前游戏目录上
	function normalize_shared(cfg) {
		cfg.shared = cfg.shared or {};

		var out = {};
		var changed = false;

		for k, v in cfg.shared {
			if (!v) continue;

			if (string.indexOf(k, "|")) {
				out[k] = true;
			}
			else {
				out[shared_key(cfg.game_path, k)] = true;
				changed = true;
			}
		}

		if (changed) cfg.shared = out;
	}

	// 官方 .minecraft 目录（不允许删除的那一个）
	function official_dir() {
		var appdata = string.getenv("APPDATA");
		if (appdata) {
			var p = appdata ++ "\.minecraft";
			if (io.exist(p)) return p;
		}
		return null;
	}

	function defaults() {
		var cfg = {
			username = "";
			memory = 4096;
			java = "";
	jvm_args = "";   // 自定义 JVM 参数，一行一条
			version = "";
			game_path = "";
			game_paths = {};
			javas = {};
			width = 854;
			height = 480;
			window_mode = "manual";
			log = true;
	log_autoscroll = true;   // 日志窗口是否自动滚到底
			hide_after_launch = false;
			status_bar = true;
			debug = false;
			allow_multi = false;
			shot_tip = true;      // 弹日志窗口时提醒「不要截图分享」，新用户默认开
			compat_fix = true;    // 启动时自动做兼容处理（关掉就照 JSON 原样）
			ms_client_id = "";   // 微软客户端 ID，留空用内置默认
			authlib_server = ""; // 上次用的外置登录服务器，用来预填
			account_key = "";    // 当前账号身份键：type:name（同名不同属性靠它区分）
			action_log = false;  // 操作日志：记录用户做了哪些动作（默认关）
			priority = "normal";
			shared = {};
	fav_paths = {};      // 收藏的游戏路径：键 = 小写目录
	fav_versions = {};   // 收藏的版本：键 = 小写游戏目录|版本名
	fav_javas = {};      // 收藏的 Java：键 = 小写 exe 路径
			accounts = {};
			account = "";
		};

		var official = official_dir();
		if (official) {
			table.push(cfg.game_paths, { name = "官方目录"; dir = official; official = true });
			cfg.game_path = official;
		}

		return cfg;
	}

	// 官方目录必须在列表里，且标记成 official（界面里禁止删除）
	function ensure_official(cfg) {
		var official = official_dir();
		if (!official) return;

		var exists = false;
		for i, p in cfg.game_paths {
			if (p.dir == official) {
				p.official = true;
				exists = true;
			}
		}

		if (!exists) {
			// 注意 aardio 的签名是 table.insert(表, 值, 位置)
			table.insert(cfg.game_paths, { name = "官方目录"; dir = official; official = true }, 1);
		}
	}

	// 从旧的 config.txt 迁移一次
	function migrate_from_txt(cfg) {
		var file = old_file_path();
		if (!io.exist(file)) return cfg;

		var text = string.load(file);
		if (!text) return cfg;

		var lines = string.split(text, '\n');
		for i, line in lines {
			line = string.trim(line);
			if (#line == 0) continue;

			var pos = string.indexOf(line, "=");
			if (!pos) continue;

			var k = string.trim(string.slice(line, 1, pos - 1));
			var v = string.trim(string.slice(line, pos + 1));

			if (k == "username") cfg.username = v;
			elseif (k == "memory") cfg.memory = tonumber(v) or cfg.memory;
			elseif (k == "version") cfg.version = v;
			elseif (k == "java") cfg.java = v;
			elseif (k == "width") cfg.width = tonumber(v) or cfg.width;
			elseif (k == "height") cfg.height = tonumber(v) or cfg.height;
			elseif (k == "game_dir") {
				if (#v > 0) {
					cfg.game_path = v;
					var has = false;
					for j, p in cfg.game_paths {
						if (p.dir == v) has = true;
					}
					if (!has) table.push(cfg.game_paths, { name = "原有目录"; dir = v; official = false });
				}
			}
		}

		return cfg;
	}

	function read() {
		var cfg = defaults();
		var file = file_path();

		if (!io.exist(file)) {
			cfg = migrate_from_txt(cfg);
			ensure_official(cfg);
			normalize_accounts(cfg);
			normalize_shared(cfg);
			save(cfg);
			return cfg;
		}

		var data = json.load(file);
		if (data) {
			if (data.username !== null) cfg.username = data.username;
			if (data.memory !== null) cfg.memory = data.memory;
			if (data.java !== null) cfg.java = data.java;
			if (data.jvm_args !== null) cfg.jvm_args = data.jvm_args;
			if (data.version !== null) cfg.version = data.version;
			if (data.game_path !== null) cfg.game_path = data.game_path;
			if (data.window_mode !== null) cfg.window_mode = data.window_mode;
			if (data.log !== null) cfg.log = data.log;
			if (data.hide_after_launch !== null) cfg.hide_after_launch = data.hide_after_launch;
			if (data.status_bar !== null) cfg.status_bar = data.status_bar;
			if (data.debug !== null) cfg.debug = data.debug;
			if (data.allow_multi !== null) cfg.allow_multi = data.allow_multi;
			if (data.shot_tip !== null) cfg.shot_tip = data.shot_tip;
			if (data.compat_fix !== null) cfg.compat_fix = data.compat_fix;
			if (data.ms_client_id !== null) cfg.ms_client_id = data.ms_client_id;
			if (data.authlib_server !== null) cfg.authlib_server = data.authlib_server;
			if (data.account_key !== null) cfg.account_key = data.account_key;
			if (data.action_log !== null) cfg.action_log = data.action_log;
		if (data.log_autoscroll !== null) cfg.log_autoscroll = data.log_autoscroll;
			if (data.priority !== null) cfg.priority = data.priority;
			if (data.shared) cfg.shared = data.shared;
		if (data.fav_paths) cfg.fav_paths = data.fav_paths;
		if (data.fav_versions) cfg.fav_versions = data.fav_versions;
		if (data.fav_javas) cfg.fav_javas = data.fav_javas;
			if (data.accounts) cfg.accounts = data.accounts;
			if (data.account !== null) cfg.account = data.account;
			if (data.width !== null) cfg.width = data.width;
			if (data.height !== null) cfg.height = data.height;
			if (data.game_paths and #data.game_paths > 0) cfg.game_paths = compact(data.game_paths);
			if (data.javas) cfg.javas = compact(data.javas);
		}

		ensure_official(cfg);

		if (#cfg.game_path == 0 and #cfg.game_paths > 0) {
			cfg.game_path = cfg.game_paths[1].dir;
		}

		normalize_accounts(cfg);

		// 令牌：优先从密文取；旧配置里还在 JSON 里的就地收进密文，下次 save 时清掉
		var sec = m3secret.load();
		var migrated = false;

		for i, a in cfg.accounts {
			var key = key_of(a);
			var t = sec[key];

			if (t) {
				if (#(a.access_token or "") == 0) a.access_token = t.access_token;
				if (#(a.refresh_token or "") == 0) a.refresh_token = t.refresh_token;
				if (!a.expires_at) a.expires_at = t.expires_at;
			}
			elseif (#(a.access_token or "") > 0) {
				// 旧式明文令牌：这一轮会随 save() 搬进密文
				migrated = true;
			}
		}

		normalize_shared(cfg);

		if (migrated) save(cfg);

		return cfg;
	}

	// 账号列表是权威来源，cfg.username 只是「当前账号名」的缓存。
	// 老配置里只有 username，这里顺手迁移成一个离线账号。
	function normalize_accounts(cfg) {
		if (!cfg.accounts) cfg.accounts = {};

		if (#cfg.accounts == 0 and #cfg.username > 0) {
			table.push(cfg.accounts, { name = cfg.username; type = "offline"; uuid = "" });
		}

		if (#cfg.accounts == 0) {
			cfg.account = "";
			cfg.username = "";
			return;
		}

		var want = cfg.account;
		if (#want == 0) want = cfg.username;

		// 优先按身份键找；旧配置（v0.2.2 之前）只有名字，就按名字找，
		// 同名时优先带登录凭据的那个。
		var found = find_by_key(cfg, cfg.account_key or "");

		if (!found) {
			found = find_account(cfg, want);
		}

		if (!found) found = cfg.accounts[1];

		cfg.account = found.name;
		cfg.username = found.name;

		// 补上身份键：否则同名账号会同时显示 [当前]
		if (#(cfg.account_key or "") == 0) cfg.account_key = key_of(found);
	}

	// 账号的身份是「类型 + 名字」：离线 / 正版 / 外置可以同名共存。
	// 只按名字找会撞车（这就是"登录了却按离线启动"的根因）。
	function key_of(a) {
		if (!a) return "";
		return tostring(a.type or "offline") ++ ":" ++ tostring(a.name or "");
	}

	function find_by_key(cfg, key) {
		if (!cfg.accounts or #key == 0) return null;

		for i, a in cfg.accounts {
			if (key_of(a) == key) return a;
		}

		return null;
	}

	// 当前账号：优先按身份键；旧配置没有键时退回按名字（并优先带凭据的）
	function current_account(cfg) {
		var a = find_by_key(cfg, cfg.account_key or "");
		if (a) return a;

		return find_account(cfg, cfg.account);
	}

	// 按名字找账号（兼容旧调用）。同名时优先返回正版/外置那个。
	function find_account(cfg, name) {
		if (!cfg.accounts) return null;

		var found = null;

		for i, a in cfg.accounts {
			if (a.name != name) continue;

			if (!found) found = a;
			if (a.type == "msa" or a.type == "authlib") return a;
		}

		return found;
	}

	// 令牌单独存（DPAPI 密文），config.json 里只留账号信息。
	// 注意：cfg 在内存里仍然带着令牌，运行时照旧用；只有写盘时摘掉。
	function save(cfg) {
		// username 跟着当前账号走，避免两个字段各说各话
		if (#(cfg.account or "") > 0) cfg.username = cfg.account;

		var sec = m3secret.load();
		var out = {};

		for k, v in cfg {
			out[k] = v;
		}

		out.accounts = {};

		for i, a in cfg.accounts {
			var key = key_of(a);

			if (#(a.access_token or "") > 0 or #(a.refresh_token or "") > 0) {
				sec[key] = {
					access_token = a.access_token;
					refresh_token = a.refresh_token;
					expires_at = a.expires_at;
				};
			}

			var b = {};

			for k, v in a {
				b[k] = v;
			}

			b.access_token = null;
			b.refresh_token = null;
			b.expires_at = null;

			table.push(out.accounts, b);
		}

		m3secret.save(sec);
		json.save(file_path(), out);
	}

	// 原子修改：读最新 → 改 → 保存，一步到位。
	// 凡是"新值要参考旧值"的改动（取反、仅在相等时清空、自增等）都该用它；
	// 用打开界面时的快照去算新值，会写出过期结果（今天踩过两次）。
	function update(fn) {
		var cfg = read();

		if (fn) fn(cfg);

		save(cfg);

		return cfg;
	}

	// 回写指定的几个键：各窗口手里的 cfg 是打开时的快照，
	// 整份写回会把别处刚改的内容（比如 Java 列表）覆盖掉。
	//
	// 两者怎么选（重要）：
	//   · 新值**要参考旧值**（取反、仅在相等时清空、自增、按旧列表删一项）
	//       → m3config.update(function(c) { ... })
	//   · 值来自界面或外部，只是"把这些键存下来"
	//       → m3config.save_keys(cfg, {"键"})
	// 反例：用快照算取反，等于每次点都从同一个旧值翻，会把开关翻回原状
	//（操作日志的开关就这么坏过一次）。
	function save_keys(cfg, keys) {
		var fresh = read();

		for i, k in keys {
			fresh[k] = cfg[k];
		}

		save(fresh);
	}

	// 数组里可能留 null（删过条目），读出来先清一遍
	function compact(t) {
		if (!t) return {};

		var out = {};
		for(i = 1; #t; 1) {
			var v = t[i];
			if (v) table.push(out, v);
		}

		return out;
	}
}
