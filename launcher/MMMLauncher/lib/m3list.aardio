//m3list.aardio

//列表小工具：所有管理窗口共用。
//
//只做一件事：打开窗口时把列宽调成「都能看见」——
//太窄的列拉回最小宽度，总宽超过可视区域的等比压缩，
//这样列数一多也不会把最后一列挤出屏幕。
//
//（「拖动时限制最小宽度」试过三次都没成：onnotify / translateCommand 收不到表头通知，
//  子类化 listview 拦 HDN_ITEMCHANGING 也无效，且诊断时会把窗口卡死。已放弃，
//  改由「每次打开窗口重新排版」保证布局不乱。）

namespace m3list {
	import math;
	import table;

	// 每列最小宽度（参数没传时用这个）
	function min_width_of(min_width) {
		if (min_width and min_width > 0) return min_width;
		return 56;
	}


	// ---------- 行号列 ----------
	//
	// 行号是"内容"而不是"外观"：列可以一键加，但每行的数字得跟着数据走。
	// 所以拆成两步——setup() 设列（用布尔参数决定要不要 #），
	// renumber() 在每次重填列表后按显示顺序重编号。
	// 只对"行数可能很多"的列表开行号；只有一两行的列表（比如账号）加了反而吵。

	ROW_NO_W = 40;

	// 记住哪些列表开了行号（用句柄做键，避免往控件上挂自定义属性）
	var row_numbered = {};

	// 设列宽。boolRowNumber 为 true 时在最前面加一列 #。
	// 传进来的 cols 如果已经带 # 就直接用，不重复插。
	function setup(list, cols, boolRowNumber) {
		if (!list) return;

		var out = {};

		if (boolRowNumber) {
			var has_no = (cols and cols[1] and cols[1][1] == "#");

			if (!has_no) {
				table.push(out, { "#"; ROW_NO_W });
			}
		}

		if (cols) {
			for i, c in cols {
				table.push(out, c);
			}
		}

		list.columns = out;
		row_numbered[tostring(list.hwnd)] = (boolRowNumber and true);
	}

	// 按当前显示顺序重编第 1 列，从 1 开始。
	// 必须在列表填完之后调用；没开行号的列表会被忽略，防止误改第一列。
	function renumber(list) {
		if (!list) return;
		if (!row_numbered[tostring(list.hwnd)]) return;

		for i = 1; list.count; 1 {
			list.setItemText(tostring(i), i, 1);
		}
	}

	// 打开窗口时用：先保证最小宽度，再把总宽压进可视区域。
	// 用 setColumnWidth（底层 LVM_SETCOLUMNWIDTH）逐列改，
	// 不要整体赋值 columns —— 那个 setter 是「删掉所有列再重建」，又重又不刷新。
	function fit(ctrl, min_width) {
		if (!ctrl) return;

		var cols = ctrl.columns;
		if (type(cols) != "table" or #cols == 0) return;

		var minw = min_width_of(min_width);

		// 列宽是按「逻辑像素」填的（DSG 里的数字），而 getRect 返回的是**设备像素**。
		// 150% 缩放下两者差 1.5 倍，不换算会把「放不下」误判成「放得下」。
		var dpi = ctrl.dpiScaleX or 1;
		if (dpi <= 0) dpi = 1;

		var rc = ctrl.getRect();
		// 留出竖向滚动条和边框的位置
		var avail = (rc.right - rc.left) / dpi - 22;
		if (avail <= 80) return;

		var out = {};
		var changed = false;

		for i, c in cols {
			var w = c[2] or 100;
			if (w < minw) {
				w = minw;
				changed = true;
			}
			table.push(out, { c[1]; w });
		}

		var total = 0;
		for i, c in out {
			total = total + c[2];
		}

		if (total > avail) {
			var scale = avail / total;
			for i, c in out {
				var w = math.floor(c[2] * scale);
				if (w < minw) w = minw;
				c[2] = w;
			}

			// 保底宽度加起来可能还超，从最宽的列里扣
			var guard = 0;
			while (guard < 20) {
				var sum = 0;
				for i, c in out {
					sum = sum + c[2];
				}

				if (sum <= avail) break;

				var widest = 1;
				for i, c in out {
					if (c[2] > out[widest][2]) widest = i;
				}

				if (out[widest][2] <= minw) break;

				var target = out[widest][2] - (sum - avail);
				if (target < minw) target = minw;
				out[widest][2] = target;

				guard = guard + 1;
			}

			changed = true;
		}

		if (changed) {
			for i, c in out {
				ctrl.setColumnWidth(c[2], i);
			}
		}
	}
}
