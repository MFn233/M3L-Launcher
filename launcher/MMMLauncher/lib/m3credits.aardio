//m3credits.aardio

//鸣谢页的正文来源。名单会经常改，放在库里：
//改文案不用碰界面代码，也不会因为窗体文件里的大段文本改错缩进。

namespace m3credits {

	//每一节：title = 小标题，items = 条目（一行一条，会按顺序显示）。
	//条目里用「·」分隔"名字 · 做了什么"，和界面其它说明的写法一致。
	SECTIONS = {
		{
			title = "第三方";
			items = {
				"aardio · 开发工具与运行时";
				"Mojang · Minecraft 本体与版本清单格式";
				"HMCL · 崩溃原因分析规则的参考实现（GPL-3.0）";
			};
		};

		{
			title = "实现协作";
			items = {
				"DeepSeek · 代码实现、文档整理与测试";
			};
		};

		{
			title = "参与测试";
			items = {
				"煤辰呀 · 启动器测试与问题反馈";
				"维夏_Vivia · 启动器测试与问题反馈";
			};
		};
	};

	//页脚声明：放最后，用主文字色显示。
	NOTES = {
		"本项目为个人非营利项目，与上述公司、项目无隶属关系。";
		"「Minecraft」是 Mojang Studios 的商标，本项目与 Mojang 无关联。";
	};
}
