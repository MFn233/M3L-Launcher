//m3mod.aardio

//Mod 管理：只认 mods 目录里的文件，不解压、不解析内容。
//
//禁用约定：文件名加 .disabled（各加载器都认这条），所以"启用/禁用"就是改名。
//放在这一层是因为它同时被三处用：设置里的 Mod 页、内存估算（数 Mod）、以后的拖入安装。

namespace m3mod {
	import io;
	import fsys;
	import string;
	import json;
	import zlib.unzip;
import m3toml;
	import table;     // 命名空间里访问 table.push 必须先 import，否则报 _get table
	import m3config;

	// 某个版本实际使用的 mods 目录：隔离时在版本目录里，否则在游戏目录根下
	function dir_of(cfg, name) {
		if (!cfg or !cfg.game_path or #cfg.game_path == 0) return null;

		if (!name or #name == 0) return cfg.game_path ++ "\mods";

		if (m3config.is_isolated(cfg, cfg.game_path, name)) {
			return cfg.game_path ++ "\versions\" ++ name ++ "\mods";
		}

		return cfg.game_path ++ "\mods";
	}

	function size_text(n) {
		if (!n) return "0 KB";

		var kb = n / 1024;
		if (kb < 1024) return string.format("%.0f KB", kb);

		return string.format("%.1f MB", kb / 1024);
	}

	// 列出一层 mods（含一层子目录：有的整合包按游戏版本分文件夹）
	// 返回数组，每项：{ name; file; path; folder; size; enabled }
	function scan(dir) {
		var out = {};
		if (!dir or !io.exist(dir)) return out;

		var add_files = function(dirpath, folder) {
			fsys.enum(dirpath, "*.*", function(dirname, filename, fullpath, findData) {
				if (!filename) return;   // 目录，由外层单独处理

				var low = string.lower(filename);
				var enabled = false;
				var base = filename;

				// .jar 与 .litemod 都是 Mod；禁用状态的判断靠 .disabled 后缀
				if (string.endsWith(low, ".jar.disabled")) {
					base = string.left(filename, #filename - 9);
				}
				elseif (string.endsWith(low, ".litemod.disabled")) {
					base = string.left(filename, #filename - 9);
				}
				elseif (string.endsWith(low, ".jar") or string.endsWith(low, ".litemod")) {
					enabled = true;
				}
				else {
					return;   // 其它文件不管（.txt、.old 之类）
				}

				table.push(out, {
					name = base;
					file = filename;
					path = fullpath;
					folder = folder;
					size = io.getSize(fullpath);
					enabled = enabled;
				});
			}, false);
		};

		add_files(dir, "");

		// fsys.list() 返回的目录项是**完整路径**（不是名字），别再拼一次。
		// 两种形式都兜住：能直接用就是路径，否则当名字拼。
		var _, folders = fsys.list(dir);
		for i, sub in folders {
			var subdir = sub;
			if (!io.exist(subdir)) subdir = dir ++ "\" ++ sub;
			if (!io.exist(subdir)) continue;

			add_files(subdir, io.splitpath(subdir).name);
		}

		return out;
	}


	// ---------- 元数据 ----------
	//
	// 只看压缩包里的一两个条目，不解压到磁盘：zlib.unzip(path, false) 是纯内存模式。
	// 各加载器的元数据位置不一样，按顺序试即可；读不到也不算错误（只是列表里显示文件名）。
	// 结果按 路径+大小 缓存：同一个 Mod 反复重画列表时不用再开一次压缩包。

	var meta_cache = {};
	var cache_file = ..io.fullpath("/mod-meta-cache.json");
	// 格式版本：解析规则改了就把这个数字 +1，旧缓存自动作废
	var CACHE_VER = 2;
	var cache_loaded = false;

	// 候选条目：key 是内部索引名，name 是压缩包里的条目名。
	// 顺序 = 优先级：Fabric/Quilt 先看，其次 Forge 新版、LiteLoader、老版，最后 MANIFEST。
	var META_CANDIDATES = {
		{ key = "fabric.mod.json"; name = "fabric.mod.json" };
		{ key = "quilt.mod.json"; name = "quilt.mod.json" };
		{ key = "neoforge.mods.toml"; name = "META-INF/neoforge.mods.toml" };
		{ key = "mods.toml"; name = "META-INF/mods.toml" };
		{ key = "litemod.json"; name = "litemod.json" };
		{ key = "mcmod.info"; name = "mcmod.info" };
		{ key = "manifest.mf"; name = "META-INF/MANIFEST.MF" };
	};

	// 持久缓存：读过的元数据写到配置旁边的 mod-meta-cache.json，
	// 下次开设置就不用再开压缩包了（键 = 小写路径|大小）。
	function cache_load() {
		if (cache_loaded) return;
		cache_loaded = true;

		if (!io.exist(cache_file)) return;

		var data = null;
		try {
			data = json.load(cache_file);
		}
		catch(e) {
			data = null;
		}

		if (type(data) != "table") return;

		// 版本对不上就整份丢掉，重新读
		if (tostring(data["!ver"] or "") != tostring(CACHE_VER)) return;

		for k, v in data {
			if (k == "!ver") continue;
			if (type(v) != "table") continue;

			meta_cache[k] = v;
		}
	}

	// 只查缓存，不碰磁盘（用于"先填已知道的"）
	function cache_peek(path) {
		if (!path) return null;

		var v = meta_cache[..string.lower(path)];

		// 失败的结果不能"卡"在缓存里：返回 null 让调用方重新读一次
		if (v and v.err) return null;

		return v;
	}

	// 写一条缓存（UI 线程解析完就存，不等最后统一存）
	function cache_put(path, meta) {
		if (!path or type(meta) != "table") return;

		meta_cache[..string.lower(path)] = meta;
	}

	function cache_save() {
		var out = { ["!ver"] = CACHE_VER };

		for k, v in meta_cache {
			if (type(v) != "table") continue;
			if (v.err) continue;          // 失败的别缓存，下次再试

			out[k] = {
				modid = v.modid or "";
				name = v.name or "";
				version = v.version or "";
				loader = v.loader or "";
			};
		}

		try {
			json.save(cache_file, out);
		}
		catch(e) {
		}
	}

	// 按名字跳读一个条目。zip 里用正斜杠，但有的实现按反斜杠比较，两种都试。
	// 这是"随机读取"：不遍历整个压缩包，一个 jar 只读几条。
	function read_one(zip, name) {
		var variants = { name; ..string.replace(name, "/", "\\") };

		for i, v in variants {
			var ok = false;

			try {
				ok = zip.locate(v);
			}
			catch(e) {
				ok = false;
			}

			if (!ok) continue;

			var s = null;
			try {
				s = zip.readCurrentFile();
			}
			catch(e) {
				s = null;
			}

			if (s and #s > 0) return s;
		}

		return null;
	}

	// 有的整合包里的 mcmod.info 不是合法 JSON（带注释、少逗号），
	// 解析失败只当"读不到元数据"，不能让整个列表崩掉。
	function safe_json(s) {
		var t = null;

		try {
			t = json.parse(s);
		}
		catch(e) {
			t = null;
		}

		return t;
	}

	// TOML → table。优先用标准扩展库 string.toml（装了就用它），
	// 没装就退回自带的 m3toml（子集实现，够读 mods.toml）。
	var toml_lib_ok = null;

	function toml_parse(text) {
		if (toml_lib_ok == null) {
			toml_lib_ok = false;

			try {
				import string.toml;
				toml_lib_ok = true;
			}
			catch(e) {
				toml_lib_ok = false;
			}
		}

		if (toml_lib_ok) {
			var t = null;

			try {
				t = string.toml.parse(text);
			}
			catch(e) {
				t = null;
			}

			if (type(t) == "table") return t;
		}

		return m3toml.parse(text);
	}

	// mods.toml / neoforge.mods.toml：信息在第一组 [[mods]] 里
	function parse_toml(text) {
		var t = toml_parse(text);
		var out = { modid = ""; name = ""; version = "" };

		if (type(t) != "table") return out;

		// [[mods]] 是数组；没有就退回根表
		var mod = t;
		if (type(t.mods) == "table" and type(t.mods[1]) == "table") mod = t.mods[1];

		out.modid = ..tostring(mod.modId or mod.modid or "");
		out.name = ..tostring(mod.displayName or mod.displayname or "");
		out.version = ..tostring(mod.version or "");

		return out;
	}

	// 从一个来源里解析出 { modid; name; version }（缺的留空）
	function meta_from_fabric(s) {
		var t = safe_json(s);
		if (type(t) != "table") return null;

		return {
			modid = ..tostring(t.id or "");
			name = ..tostring(t.name or "");
			version = ..tostring(t.version or "");
			loader = "Fabric";
		};
	}

	// Quilt 的信息在 quilt_loader 里，结构完全不同
	function meta_from_quilt(s) {
		var t = safe_json(s);
		if (type(t) != "table") return null;

		var ql = t.quilt_loader;
		if (type(ql) != "table") return null;

		var name = "";
		if (type(ql.metadata) == "table") name = ..tostring(ql.metadata.name or "");

		return {
			modid = ..tostring(ql.id or "");
			name = name;
			version = ..tostring(ql.version or "");
			loader = "Quilt";
		};
	}

	function meta_from_toml(s) {
		var t = parse_toml(s);

		return {
			modid = ..tostring(t.modid or "");
			name = ..tostring(t.name or "");
			version = ..tostring(t.version or "");
			loader = "Forge";
		};
	}

	function meta_from_lite(s) {
		var t = safe_json(s);
		if (type(t) != "table") return null;

		return {
			modid = ..tostring(t.modid or t.name or "");
			name = ..tostring(t.name or "");
			version = ..tostring(t.version or t.revision or "");
			loader = "LiteLoader";
		};
	}

	function meta_from_mcmod(s) {
		var t = safe_json(s);
		if (type(t) != "table") return null;

		// 有的是数组，有的是 { modList = [...] }
		var first = null;
		if (t.modList and t.modList[1]) first = t.modList[1];
		elseif (t[1]) first = t[1];

		if (type(first) != "table") return null;

		return {
			modid = ..tostring(first.modid or "");
			name = ..tostring(first.name or "");
			version = ..tostring(first.version or "");
			loader = "Forge";
		};
	}

	function meta_from_manifest(s) {
		if (type(s) != "string") return null;

		var title = ..string.match(s, 'Implementation%-Title:%s*([^\r\n]+)');
		var ver = ..string.match(s, 'Implementation%-Version:%s*([^\r\n]+)');
		var vendor = ..string.match(s, 'Implementation%-Vendor%-Id:%s*([^\r\n]+)');

		return {
			modid = vendor ? ..string.trim(vendor) : "";
			name = title ? ..string.trim(title) : "";
			version = ver ? ..string.trim(ver) : "";
			loader = "";
		};
	}

	// 逐字段填缺：先到的来源优先，后面只补空
	function fill_meta(m, t) {
		if (type(t) != "table") return;

		if (#m.modid == 0 and #(t.modid or "") > 0) m.modid = t.modid;
		if (#m.name == 0 and #(t.name or "") > 0) m.name = t.name;
		if (#m.version == 0 and #(t.version or "") > 0) m.version = t.version;
		if (#m.loader == 0 and #(t.loader or "") > 0) m.loader = t.loader;
	}

	// 从拿到的条目文本里解析（顺序就是优先级，缺的由后面的补）
	function pick_meta(texts) {
		var m = { modid = ""; name = ""; version = ""; loader = "" };

		if (!texts) return m;

		if (texts["fabric.mod.json"]) fill_meta(m, meta_from_fabric(texts["fabric.mod.json"]));
		if (texts["quilt.mod.json"]) fill_meta(m, meta_from_quilt(texts["quilt.mod.json"]));
		if (texts["neoforge.mods.toml"]) fill_meta(m, meta_from_toml(texts["neoforge.mods.toml"]));
		if (texts["mods.toml"]) fill_meta(m, meta_from_toml(texts["mods.toml"]));
		if (texts["litemod.json"]) fill_meta(m, meta_from_lite(texts["litemod.json"]));
		if (texts["mcmod.info"]) fill_meta(m, meta_from_mcmod(texts["mcmod.info"]));
		if (texts["manifest.mf"]) fill_meta(m, meta_from_manifest(texts["manifest.mf"]));

		return m;
	}

	// 读一个 Mod 的元数据；失败返回空表（调用方按文件名兜底）
	function meta_of(path) {
		if (!path) return { modid = ""; name = ""; version = ""; loader = "" };

		// 键用路径（不再拼文件大小：每次渲染都要 io.getSize 一遍，157 个文件不值当）
		var key = ..string.lower(path);
		if (meta_cache[key]) return meta_cache[key];

		var zip = null;

		try {
			zip = zlib.unzip(path, false);
		}
		catch(e) {
			zip = null;
		}

		if (!zip) {
			var bad = { modid = ""; name = ""; version = ""; loader = ""; err = "打不开压缩包" };
			meta_cache[key] = bad;
			return bad;
		}

		// MANIFEST 每个包都有，先读它当补缺来源；再按优先级读加载器专属元数据，
		// 名字与版本都齐了才停 —— 但不因为"命中一个"就停（litemod.json 可能没有 version）。
		var texts = {};
		var hit = 0;
		var tried = {};

		var mf = read_one(zip, "META-INF/MANIFEST.MF");
		if (mf) {
			texts["manifest.mf"] = mf;
			hit = hit + 1;
		}
		table.push(tried, "manifest" ++ (mf ? "+" : "-"));

		for i, c in META_CANDIDATES {
			if (c.key == "manifest.mf") continue;

			var s = read_one(zip, c.name);

			var mark = "-";
			if (s) {
				mark = "+";
				texts[c.key] = s;
				hit = hit + 1;
			}
			table.push(tried, c.key ++ mark);

			// 名字和版本都拿到了就够用了
			if (s) {
				var probe = pick_meta(texts);
				if (#probe.modid > 0 and #probe.version > 0) break;
			}
		}

		var m = pick_meta(texts);

		m.tried = table.concat(tried, ",");

		if (#m.modid == 0 and #m.name == 0) {
			if (hit == 0) m.err = "没有元数据条目";
			else m.err = "元数据解析不出名字";
		}

		zip.close();

		meta_cache[key] = m;

		return m;
	}

	// 只数启用的（内存估算用：禁用的 Mod 不会被加载）
	function count_enabled(dir) {
		var list = scan(dir);

		var n = 0;
		for i, m in list {
			if (m.enabled) n = n + 1;
		}

		return n;
	}

	// 启用/禁用 = 改名去掉或加上 .disabled
	function set_enabled(path, enabled) {
		if (!path or !io.exist(path)) return false, "文件不存在";

		var is_enabled = string.endsWith(string.lower(path), ".jar");

		if (enabled and is_enabled) return true;
		if (!enabled and !is_enabled) return true;

		var target;
		if (enabled) target = string.left(path, #path - 9);
		else target = path ++ ".disabled";

		if (io.exist(target)) return false, "目标文件已存在";

		// 用 MoveFileEx 直接改名：fsys.rename 走的是 Shell 操作，
		// 会带界面/进度框，改个文件名不值得。
		if (::Kernel32.MoveFileExW(path, target, 0)) return true;

		return false, "改名失败（文件可能正被游戏占用）";
	}
}

/**intellisense(m3mod)
dir_of(__/*配置*/,__/*版本名*/) = 该版本实际使用的 mods 目录
scan(__/*目录*/) = 列出 .jar 与 .jar.disabled（含一层子目录）
count_enabled(__/*目录*/) = 只数启用的 Mod
set_enabled(__/*文件路径*/,__/*true 启用 / false 禁用*/) = 改名切换启用状态
size_text(__/*字节数*/) = 人类可读的大小
end intellisense**/
