//m3mod.aardio

//Mod 管理：只认 mods 目录里的文件，不解压、不解析内容。
//
//禁用约定：文件名加 .disabled（各加载器都认这条），所以"启用/禁用"就是改名。
//放在这一层是因为它同时被三处用：设置里的 Mod 页、内存估算（数 Mod）、以后的拖入安装。

namespace m3mod {
	import io;
	import fsys;
	import string;
	import json;
	import zlib.unzip;
	import table;     // 命名空间里访问 table.push 必须先 import，否则报 _get table
	import m3config;

	// 某个版本实际使用的 mods 目录：隔离时在版本目录里，否则在游戏目录根下
	function dir_of(cfg, name) {
		if (!cfg or !cfg.game_path or #cfg.game_path == 0) return null;

		if (!name or #name == 0) return cfg.game_path ++ "\mods";

		if (m3config.is_isolated(cfg, cfg.game_path, name)) {
			return cfg.game_path ++ "\versions\" ++ name ++ "\mods";
		}

		return cfg.game_path ++ "\mods";
	}

	function size_text(n) {
		if (!n) return "0 KB";

		var kb = n / 1024;
		if (kb < 1024) return string.format("%.0f KB", kb);

		return string.format("%.1f MB", kb / 1024);
	}

	// 列出一层 mods（含一层子目录：有的整合包按游戏版本分文件夹）
	// 返回数组，每项：{ name; file; path; folder; size; enabled }
	function scan(dir) {
		var out = {};
		if (!dir or !io.exist(dir)) return out;

		var add_files = function(dirpath, folder) {
			fsys.enum(dirpath, "*.*", function(dirname, filename, fullpath, findData) {
				if (!filename) return;   // 目录，由外层单独处理

				var low = string.lower(filename);
				var enabled = false;
				var base = filename;

				if (string.endsWith(low, ".jar.disabled")) {
					base = string.left(filename, #filename - 9);
				}
				elseif (string.endsWith(low, ".jar")) {
					enabled = true;
				}
				else {
					return;   // 其它文件不管（.txt、.old 之类）
				}

				table.push(out, {
					name = base;
					file = filename;
					path = fullpath;
					folder = folder;
					size = io.getSize(fullpath);
					enabled = enabled;
				});
			}, false);
		};

		add_files(dir, "");

		// fsys.list() 返回的目录项是**完整路径**（不是名字），别再拼一次。
		// 两种形式都兜住：能直接用就是路径，否则当名字拼。
		var _, folders = fsys.list(dir);
		for i, sub in folders {
			var subdir = sub;
			if (!io.exist(subdir)) subdir = dir ++ "\" ++ sub;
			if (!io.exist(subdir)) continue;

			add_files(subdir, io.splitpath(subdir).name);
		}

		return out;
	}


	// ---------- 元数据 ----------
	//
	// 只看压缩包里的一两个条目，不解压到磁盘：zlib.unzip(path, false) 是纯内存模式。
	// 各加载器的元数据位置不一样，按顺序试即可；读不到也不算错误（只是列表里显示文件名）。
	// 结果按 路径+大小 缓存：同一个 Mod 反复重画列表时不用再开一次压缩包。

	var meta_cache = {};

	function read_first(zip, names) {
		for i, n in names {
			if (zip.locate(n)) {
				var s = zip.readCurrentFile();
				if (s and #s > 0) return s;
			}
		}

		return null;
	}

	// 有的整合包里的 mcmod.info 不是合法 JSON（带注释、少逗号），
	// 解析失败只当"读不到元数据"，不能让整个列表崩掉。
	function safe_json(s) {
		var t = null;

		try {
			t = json.parse(s);
		}
		catch(e) {
			t = null;
		}

		return t;
	}

	// mods.toml / neoforge.mods.toml：取第一组 modId / displayName / version
	function parse_toml(text) {
		var out = {};

		for line in ..string.gmatch(text, "[^\r\n]+") {
			var k, v = ..string.match(..string.trim(line), '^(%w+)%s*=%s*"([^"]*)"');

			if (!k) continue;
			if (k == "modId" and #out.modid == 0) out.modid = v;
			elseif (k == "displayName" and #out.name == 0) out.name = v;
			elseif (k == "version" and #out.version == 0) out.version = v;
		}

		return out;
	}

	// 读一个 Mod 的元数据；失败返回空表（调用方按文件名兜底）
	function meta_of(path) {
		if (!path) return {};

		var key = ..string.lower(path) ++ "|" ++ ..tostring(io.getSize(path) or 0);
		if (meta_cache[key]) return meta_cache[key];

		var m = { modid = ""; name = ""; version = ""; loader = "" };

		var zip = null;

		try {
			zip = zlib.unzip(path, false);
		}
		catch(e) {
			zip = null;
		}

		if (!zip) return m;

		// Fabric / Quilt
		var s = read_first(zip, {"fabric.mod.json"; "quilt.mod.json"});
		if (s) {
			var t = safe_json(s);
			if (type(t) == "table") {
				m.loader = "Fabric";
				m.modid = ..tostring(t.id or "");
				m.name = ..tostring(t.name or "");
				m.version = ..tostring(t.version or "");
			}
		}

		// Forge 1.13+ / NeoForge
		if (#m.modid == 0) {
			s = read_first(zip, {"META-INF/neoforge.mods.toml"; "META-INF/mods.toml"});
			if (s) {
				var t = parse_toml(s);
				m.loader = "Forge";
				m.modid = ..tostring(t.modid or "");
				m.name = ..tostring(t.name or "");
				m.version = ..tostring(t.version or "");
			}
		}

		// 1.12.2 及更早
		if (#m.modid == 0) {
			s = read_first(zip, {"mcmod.info"});
			if (s) {
				var t = safe_json(s);

				// 有的是数组，有的是 { modList = {...} }
				var first = null;
				if (type(t) == "table") {
					if (t.modList and t.modList[1]) first = t.modList[1];
					elseif (t[1]) first = t[1];
				}

				if (type(first) == "table") {
					m.loader = "Forge";
					m.modid = ..tostring(first.modid or "");
					m.name = ..tostring(first.name or "");
					m.version = ..tostring(first.version or "");
				}
			}
		}

		// 兜底：MANIFEST 里的标题与版本
		if (#m.modid == 0) {
			s = read_first(zip, {"META-INF/MANIFEST.MF"});
			if (s) {
				var title = ..string.match(s, "Implementation%-Title:%s*([^\r\n]+)");
				var ver = ..string.match(s, "Implementation%-Version:%s*([^\r\n]+)");
				var id = ..string.match(s, "Implementation%-Vendor%-Id:%s*([^\r\n]+)");

				if (title) m.name = ..string.trim(title);
				if (ver) m.version = ..string.trim(ver);
				if (id) {
					m.modid = ..string.trim(id);
					m.loader = "Forge";
				}
			}
		}

		zip.close();

		meta_cache[key] = m;

		return m;
	}

	// 只数启用的（内存估算用：禁用的 Mod 不会被加载）
	function count_enabled(dir) {
		var list = scan(dir);

		var n = 0;
		for i, m in list {
			if (m.enabled) n = n + 1;
		}

		return n;
	}

	// 启用/禁用 = 改名去掉或加上 .disabled
	function set_enabled(path, enabled) {
		if (!path or !io.exist(path)) return false, "文件不存在";

		var is_enabled = string.endsWith(string.lower(path), ".jar");

		if (enabled and is_enabled) return true;
		if (!enabled and !is_enabled) return true;

		var target;
		if (enabled) target = string.left(path, #path - 9);
		else target = path ++ ".disabled";

		if (io.exist(target)) return false, "目标文件已存在";

		// 用 MoveFileEx 直接改名：fsys.rename 走的是 Shell 操作，
		// 会带界面/进度框，改个文件名不值得。
		if (::Kernel32.MoveFileExW(path, target, 0)) return true;

		return false, "改名失败（文件可能正被游戏占用）";
	}
}

/**intellisense(m3mod)
dir_of(__/*配置*/,__/*版本名*/) = 该版本实际使用的 mods 目录
scan(__/*目录*/) = 列出 .jar 与 .jar.disabled（含一层子目录）
count_enabled(__/*目录*/) = 只数启用的 Mod
set_enabled(__/*文件路径*/,__/*true 启用 / false 禁用*/) = 改名切换启用状态
size_text(__/*字节数*/) = 人类可读的大小
end intellisense**/
