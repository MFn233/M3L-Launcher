//m3layout.aardio

//竖向流式布局：按「一节 → 一行一行往下排」的方式算坐标。
//
//为什么需要它：aardio 的控件坐标是绝对像素，手写每一行的 top 必然会有偏差
//（HTML 有 flex / gap 自动算，这里没有），十几个控件叠起来就"看着歪但说不上哪歪"。
//这层把行高、行距、标签列宽度都变成常量，调用方只说「放什么」，不再算坐标。
//
//分组线框：section() 会记录这一节内容占的纵向范围，等这一节结束时用 bkplus
//（无句柄背景控件）在内容外面画一圈 1px 边框，标题压在框线上。
//bkplus 是在窗体背景上绘图的，创建顺序无所谓，所以可以"先排内容、后补框"。

namespace m3layout {
	import table;
	import m3theme;

	// ---------- 尺寸常量：默认值 = 用户选定的"紧凑"密度 ----------
	LABEL_W = 64;        // 左侧标签列宽度
	ROW_H = 24;          // 行内控件高度
	ROW_STEP = 30;       // 行距（控件高 + 6）
	BTN_H = 30;          // 按钮高度
	BTN_W = 76;          // 行内按钮宽度
	BTN_GAP = 8;         // 控件与行内按钮之间
	SECTION_H = 20;      // 分组标题高度
	SECTION_GAP = 12;    // 标题与第一行之间（标题在框外，这里同时是标题与框的距离）
	SECTION_SPACE = 14;  // 上一节内容与本节标题之间
	NOTE_STEP = 18;      // 说明行步进
	TEXT_DY = 3;         // 单行文字相对控件顶部的下移量（让标签与控件视觉居中）

	// 分组线框：**只包内容**，标题在框外（参考 MultiMC 那种关系）
	GROUP_PAD_X = 12;    // 框比内容左右各宽出的部分
	GROUP_PAD_Y = 10;    // 框比内容上下各高出的部分

	function create(form, left, top, width, opt) {
		var L = {};

		L.form = form;
		L.left = left;
		L.top = top;
		L.width = width;
		L.right = left + width;
		L.y = top;

		// 允许调用方覆盖尺寸（同一个窗体里可以并排比较两种密度）
		L.label_w = (opt and opt.label_w) or LABEL_W;
		L.row_h = (opt and opt.row_h) or ROW_H;
		L.row_step = (opt and opt.row_step) or ROW_STEP;
		L.btn_h = (opt and opt.btn_h) or BTN_H;
		L.btn_w = (opt and opt.btn_w) or BTN_W;
		L.section_h = (opt and opt.section_h) or SECTION_H;
		L.section_gap = (opt and opt.section_gap) or SECTION_GAP;
		L.section_space = (opt and opt.section_space) or SECTION_SPACE;
		L.note_step = (opt and opt.note_step) or NOTE_STEP;
		L.text_dy = (opt and opt.text_dy) or TEXT_DY;
		L.font = (opt and opt.font) or -12;
		L.framed = (opt and opt.framed) or false;   // 要不要画分组线框

		L.controls = {};   // 本页建出来的所有控件，供分页显隐
		L.sections = {};   // 已记录的小节范围
		L.open_section = null;

		// 建控件：字体没给就统一用正文号；坐标由调用方补齐
		L.make = function(o) {
			var t = table.assign({}, o);

			if (t.font == null) t.font = LOGFONT(name='Microsoft YaHei'; h=L.font);

			var c = form.add(t);
			table.push(L.controls, c);

			// 记录本节内容的真实底边：框的最后一条线要靠它，
			// 不能拿"下一节的起点"来算，那样每个框底部都会多出半行。
			if (L.open_section and t.bottom) {
				if (!L.open_section.bottom or t.bottom > L.open_section.bottom) {
					L.open_section.bottom = t.bottom;
				}
			}

			return c;
		};

		// 同一类控件套同一套主题
		L.skin = function(ctrl, cls) {
			if (!ctrl) return ctrl;

			if (cls == "static") m3theme.note(ctrl);
			elseif (cls == "edit") m3theme.field(ctrl);
			elseif (cls == "checkbox") ctrl.bgcolor = m3theme.C_BG;
			elseif (cls == "plus") m3theme.button(ctrl);

			return ctrl;
		};

		// ---------- 分组框 ----------

		// 这一节结束：用 bkplus 在内容外面补一圈线，并新建标题
		// plain = true 时不画框（用于只有一行说明的占位节，画框会显得空）
		// 注意：不论画不画框，**标题一定要建**，否则占位节会只剩一行说明、没有名字。
		L.close_section = function() {
			var s = L.open_section;
			if (!s) return;

			s.y1 = s.bottom or (L.y - L.section_space);
			L.open_section = null;

			// 框只包内容：上边在内容顶上方 GROUP_PAD_Y，下边在最后一行下方 GROUP_PAD_Y。
			// 标题在框外，所以框里不会多出一块"只有标题"的空白。
			if (L.framed and !s.plain) {
				var frame = form.add({
					cls = "bkplus";
					left = L.left - GROUP_PAD_X;
					top = s.y0 - GROUP_PAD_Y;
					right = L.right + GROUP_PAD_X;
					bottom = s.y1 + GROUP_PAD_Y;
					bgcolor = m3theme.C_BG;
					border = { color = m3theme.C_FRAME; width = 1 };
				});

				table.push(L.controls, frame);
			}

			// 标题在框外、内容之上；比正文大一号，当小标题用
			var cap = L.make({
				cls = "static";
				text = s.title;
				left = L.left;
				top = s.caption_top;
				right = L.left + 160;
				bottom = s.caption_top + L.section_h;
				font = LOGFONT(name='Microsoft YaHei'; h=-13);
			});

			m3theme.ink(cap);
		};

		// 分组标题：关闭上一节、记下新节的起点
		// plain = true 时这一节不画框
		L.section = function(title, plain) {
			L.close_section();

			if (!L.first_section) L.y = L.y + L.section_space;

			var y = L.y;
			L.first_section = false;

			L.open_section = { title = title; caption_top = y; y0 = y + L.section_h + L.section_gap; plain = plain };

			L.y = L.open_section.y0;

			return y;
		};

		// ---------- 一行 ----------

		// 标签 + 控件（+ 可选的行内按钮）
		// 返回两个值：控件、行内按钮（没有按钮时按钮为 null）
		L.row = function(label, ctrl_opt, btn_text) {
			var y = L.y;
			var x = L.left + L.label_w;
			var ctrl_right = L.right;
			var row_btn = null;

			if (btn_text) ctrl_right = L.right - L.btn_w - BTN_GAP;

			if (label and #label) {
				var lab = L.make({
					cls = "static";
					text = label;
					left = L.left;
					top = y + L.text_dy;
					right = L.left + L.label_w - 8;
					bottom = y + L.text_dy + 18;
					font = LOGFONT(name='Microsoft YaHei'; h=L.font);
				});

				m3theme.note(lab);
			}

			var ctrl = L.make(table.assign({}, ctrl_opt, {
				left = x;
				top = y;
				right = ctrl_right;
				bottom = y + L.row_h;
			}));

			L.skin(ctrl, ctrl_opt.cls);

			if (btn_text) {
				row_btn = L.make({
					cls = "plus";
					text = btn_text;
					left = L.right - L.btn_w;
					top = y;
					right = L.right;
					bottom = y + L.row_h;
				});

				m3theme.button(row_btn);
			}

			L.y = y + L.row_step;

			return ctrl, row_btn;
		};

		// 复选框：贴着内容区左边（不缩进到标签列——它没有标签），占满剩余宽度
		L.check = function(text, checked) {
			var y = L.y;

			var c = L.make({
				cls = "checkbox";
				text = text;
				left = L.left;
				top = y;
				right = L.right;
				bottom = y + 20;
			});

			if (checked) c.checked = true;
			c.bgcolor = m3theme.C_BG;

			L.y = y + L.row_step;

			return c;
		};

		// 说明文字：整行次要灰字（多行用 \r\n 自己断）
		// at_left = true 时贴内容区左边（用于没有标签列的占位节）
		L.text = function(text, at_left) {
			var y = L.y;
			var x = L.left + L.label_w;
			if (at_left) x = L.left;

			var note = L.make({
				cls = "static";
				text = text;
				left = x;
				top = y;
				right = L.right;
				bottom = y + L.note_step;
				font = LOGFONT(name='Microsoft YaHei'; h=-11);
			});

			m3theme.note(note);

			L.y = y + L.note_step;

			return note;
		};

		// 按钮行：从右往左排，最后一个贴右边界；返回值顺序与传入一致
		L.buttons = function(texts) {
			var y = L.y;
			var x = L.right;
			var list = {};

			for i = #texts; 1; -1 {
				var btn = L.make({
					cls = "plus";
					text = texts[i];
					left = x - L.btn_w;
					top = y;
					right = x;
					bottom = y + L.btn_h;
				});

				m3theme.button(btn);
				table.push(list, btn);

				x = x - L.btn_w - BTN_GAP;
			}

			var ordered = {};
			for i = #list; 1; -1 {
				table.push(ordered, list[i]);
			}

			L.y = y + L.btn_h + BTN_GAP;

			return ordered;
		};

		// 手动留白 / 结束（结束时会关掉最后一节的框）
		L.gap = function(px) {
			L.y = L.y + (px or 8);
		};

		L.finish = function() {
			L.close_section();
			return L.y;
		};

		return L;
	}
}

/**intellisense(m3layout)
LABEL_W / ROW_H / ROW_STEP / BTN_H / BTN_W / SECTION_H = 尺寸常量（默认是紧凑密度）
create(__/*窗体*/,__/*left*/,__/*top*/,__/*width*/,__/*覆盖项*/) = 创建布局游标
!layout.section(__/*标题*/) = 开一节（可画线框，见 opt.framed）
!layout.row(__/*标签*/,__/*控件参数表*/,__/*行内按钮文字*/) = 一行：标签 + 控件（+ 按钮），返回控件
!layout.check(__/*文字*/,__/*默认选中*/) = 整行复选框，返回控件
!layout.text(__/*说明*/) = 整行说明文字，返回控件
!layout.buttons(__/*按钮文字数组*/) = 按钮行，从右往左排，返回按钮数组
!layout.gap(__/*像素*/) = 手动留白
!layout.finish() = 收尾（关掉最后一节）并返回当前 top
!layout.controls = 本页建出来的控件数组（分页显隐用）
end intellisense**/
