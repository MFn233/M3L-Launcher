//m3secret.aardio

//登录令牌单独存放，并用 Windows DPAPI 加密（当前用户作用域）。
//
//现状与取舍：
//   · 明文放 config.json 时，任何人/任何程序都能直接读走；
//   · Windows 没有"程序能读、用户读不到"的存储（同一用户的进程都能读），
//     所以能做的是：DPAPI 加密 + 独立文件 —— 换个用户、拷到别的机器都解不开；
//   · 仍然挡不住"同一用户下的恶意程序"，这点必须说清楚，不要给虚假的安全感。
//
//存放：M3L\secrets.dat（DPAPI 密文，不是 JSON）

namespace m3secret {
	import io;
	import fsys;
	import string;
	import web.json;
	import m3paths;
	import crypt.protectData;

	var FILE_NAME = "secrets.dat";

	function file_path() {
		return m3paths.path(FILE_NAME);
	}

	// 读出 { "type:name" = { access_token; refresh_token; expires_at } }
	// 解不开（换了用户/机器、文件损坏）就当作空，让用户重新登录。
	function load() {
		var p = file_path();
		if (!io.exist(p)) return {};

		var blob = string.load(p);
		if (!blob or #blob == 0) return {};

		var text = null;

		try {
			text = crypt.protectData.decrypt(blob, false);
		}
		catch(e) {
			return {};
		}

		if (!text or #text == 0) return {};

		var t = null;

		try {
			t = web.json.parse(text);
		}
		catch(e) {
			return {};
		}

		if (type(t) != "table") return {};

		return t;
	}

	function save(t) {
		var text = web.json.stringify(t);
		if (!text) return false;

		var blob = null;

		try {
			blob = crypt.protectData.encrypt(text, "M3L login tokens", false);
		}
		catch(e) {
			return false;
		}

		if (!blob) return false;

		return string.save(file_path(), blob) and true or false;
	}

	function clear() {
		var p = file_path();

		try {
			if (io.exist(p)) fsys.delete(p);
		}
		catch(e) {
		}
	}

	// 把命令行里的令牌打码。
	// 日志窗口、落盘日志、打包 zip、崩溃窗口都用它，别各写一份：
	// 只处理 --accessToken（唯一"拿到就能冒用账号"的参数）。
	function redact(text) {
		var s = tostring(text);
		var key = "--accessToken ";
		var p = string.indexOf(s, key);

		if (!p) {
			// 也兼容 --accessToken=xxx 这种写法
			key = "--accessToken=";
			p = string.indexOf(s, key);

			if (!p) return s;

			var rest = string.slice(s, p + #key);
			var sp = string.indexOf(rest, " ");

			if (!sp) return string.slice(s, 1, p + #key - 1) ++ "***";

			return string.slice(s, 1, p + #key - 1) ++ "***" ++ string.slice(rest, sp);
		}

		var head = string.slice(s, 1, p + #key - 1);
		var rest = string.slice(s, p + #key);
		var sp = string.indexOf(rest, " ");

		if (!sp) return head ++ "***";

		return head ++ "***" ++ string.slice(rest, sp);
	}
}
