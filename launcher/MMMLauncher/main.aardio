//main.aardio

//MMMLauncher 主页：标题、状态栏、设置 / 启动游戏。
//日志是独立窗口，每个游戏实例一个；开启多开后可同时跑多个实例。

import win.ui;
import win.ui.minmax;
import win.ui.tooltip;
import m3theme;
import m3crash;
import m3version;
import MMMLC;
import m3config;
import m3opts;
import m3log;
import m3java;
import m3game;
import m3auth;
import m3app;
import m3paths;
import m3act;
import m3dlgs;
import m3mod;
import win.ui.menu;
import process;
import crypt;
import fsys;
import string;
import math;
import time;
/*DSG{{*/
var winform = win.form(text="M³ Launcher";right=559;bottom=335;bgcolor=0xF2F2F2)
winform.add(
btnLaunch={cls="plus";text="启动游戏";left=432;top=238;right=536;bottom=282;anchors={right=1;bottom=1};font=LOGFONT(h=-14;name='Microsoft YaHei');z=4};
btnSettings={cls="plus";text="设置";left=344;top=238;right=424;bottom=282;anchors={right=1;bottom=1};font=LOGFONT(h=-14;name='Microsoft YaHei');z=3};
btnTitle={cls="plus";text="M³ Launcher";left=24;top=16;right=250;bottom=54;align="left";anchors={left=1;top=1};font=LOGFONT(h=-20;name='Microsoft YaHei');z=1};
comboVer={cls="combobox";left=344;top=292;right=536;bottom=318;anchors={right=1;bottom=1};font=LOGFONT(name='Microsoft YaHei');items={};mode="dropdownlist";z=5};
lblStatus={cls="static";left=24;top=64;right=520;bottom=96;anchors={left=1;top=1};font=LOGFONT(h=-11;name='Microsoft YaHei');z=2}
)
/*}}*/

m3theme.window(winform);

// ---------- 主题 ----------

m3theme.note(winform.lblStatus);

// 状态栏太长时用 ... 截断（SS_ENDELLIPSIS），完整版本名靠 tooltip 补。
// SS_NOTIFY 是必须的：没有它静态文本对鼠标是透明的（WM_NCHITTEST 返回 HTTRANSPARENT），
// 鼠标消息进不来，挂在它上面的 tooltip 永远不会触发。
win.modifyStyle(winform.lblStatus.hwnd, 0, 0x4000/*_SS_ENDELLIPSIS*/ | 0x100/*_SS_NOTIFY*/);
winform.lblStatus.redraw();

// 标题：无框，左键关于、右键控件样式测试台
m3theme.plain(winform.btnTitle);

// 启动游戏 / 设置：同一套外观
m3theme.button(winform.btnLaunch);
m3theme.button(winform.btnSettings);

// 最小窗口大小，否则缩放后排版会挤在一起
win.ui.minmax(winform, 480, 260);

// ---------- 旧布局迁移 ----------
//运行时文件统一收进 M3L\；旧文件只在目标不存在时搬过去，不覆盖。
var migrate_notes = {};

var mres = m3paths.migrate(function(text) { table.push(migrate_notes, text); });

//记一笔到 M3L\migrate.log（追加），方便回看搬过什么
if (mres.total > 0) {
	try {
		string.save(m3paths.path("migrate.log"),
			time() ++ "  移动 " ++ mres.moved ++ " 项，失败 " ++ mres.failed ++ " 项" ++ '\r\n'
			++ table.concat(migrate_notes, '\r\n') ++ '\r\n', 1);
	}
	catch(e) {
	}
}

// ---------- 运行状态 ----------
// var 只对声明之后的代码生效，所以统一放在最前面。

var launching = false;    // 正在启动（读 JSON、解 natives、找 Java）
var instances = {};       // 运行中的实例
var instance_seq = 0;     // 实例编号
var poll_timer = null;    // 一个定时器轮询所有实例
var cur_session = null;   // 当前的日志会话
var self_hidden = false;
var debug_mode = false;
var status_tip = null;    // 状态栏的悬停提示（win.ui.tooltip）
var shot_tip_shown = false;   // 「不要截图分享日志」这次会话里提醒过没有
var crash_seq = 0;            // 已经弹过几个崩溃窗口（用来错开位置，避免完全叠在一起）

// ---------- 日志 ----------

//本次启动的日志也写一份到版本目录，关掉程序后还能查。
//为什么不只靠日志窗口：窗口一关就没了，出问题时用户往往已经关掉了。
var launch_file = "";
var launch_buf = "";

function log_flush() {
	if (#launch_file == 0 or #launch_buf == 0) return;

	string.save(launch_file, launch_buf, 1);   // 第三个参数非 0 = 追加
	launch_buf = "";
}

function log(text, is_error) {
	if (cur_session) cur_session.write(text, is_error);

	if (#launch_file > 0) {
		launch_buf = launch_buf ++ tostring(text) ++ '\r\n';

		//攒到 8KB 才落盘一次，游戏刷屏时也不会频繁写文件
		if (#launch_buf > 8192) log_flush();
	}
}

// 调试模式下才输出的内部细节
function dbg(text) {
	if (debug_mode) log("[调试] " ++ text);
}

// 启动命令要写进日志（还会被打包分享），令牌一律打码。
// 实现放在 m3secret.redact：日志窗口、落盘、打包 zip、崩溃窗口共用一份，
// 免得哪天有人在别处又拼出一条没打码的命令行。
function mask_token(text) {
	return m3secret.redact(text);
}

// 游戏输出也进落盘文件：出问题时不用再手工跑一遍命令才知道它报了什么。
function note_to_file(text) {
	if (#launch_file == 0 or #text == 0) return;

	launch_buf = launch_buf ++ text ++ '\r\n';
	if (#launch_buf > 8192) log_flush();
}

// 把某个实例缓冲区里的完整行搬进它的日志会话
function flush_lines(inst) {
	var chunk = "";

	while (true) {
		var p = string.indexOf(inst.buffer, '\n');
		if (!p) break;

		var line = string.slice(inst.buffer, 1, p - 1);
		if (!line) line = "";
		line = string.trimRight(line);

		//记一笔"游戏真的开始输出自己的日志了"：退出判定要用。
		//"Setting user" 从 1.2 到 1.21 都会打；老版本还会打 LWJGL 版本行。
		if (!inst.saw_game_log
			and (string.indexOf(line, "Setting user") or string.indexOf(line, "LWJGL")
				or string.indexOf(line, "Created:"))) {
			inst.saw_game_log = true;
		}

		inst.buffer = string.slice(inst.buffer, p + 1);
		if (!inst.buffer) inst.buffer = "";

		note_to_file(line);

		if (string.indexOf(line, "/ERROR]") or string.indexOf(line, "/FATAL]")) {
			if (#chunk > 0) {
				inst.session.write(string.trimRight(chunk));
				chunk = "";
			}
			inst.session.write(line, true);
		}
		else {
			chunk = chunk ++ line ++ '\r\n';
		}
	}

	if (#chunk > 0) inst.session.write(string.trimRight(chunk));
}

// ---------- 状态行 / 标题栏 ----------

function refresh_status() {
	var cfg = m3config.read();
	var n = #instances;

	if (n == 0) {
		winform.text = "M³ Launcher";
	}
	elseif (n == 1) {
		winform.text = "M³ Launcher —— 右键「启动游戏」以强制停止当前实例";
	}
	else {
		winform.text = "M³ Launcher —— 运行中 ×" ++ n ++ "，右键「启动游戏」以强制停止全部实例";
	}

	if (!cfg.status_bar) {
		winform.lblStatus.visible = false;
		return;
	}
	winform.lblStatus.visible = true;

	var who = cfg.username;
	if (#who == 0) who = "player";

	var ver = cfg.version;
	if (#ver == 0) ver = "未选择版本";

	// 状态栏里先截短，完整名字挂在 tooltip 上（见下面的 refresh_tooltip）
	var ver_short = ver;
	if (#ver_short > 24) ver_short = string.slice(ver_short, 1, 24) ++ "…";

	//按账号类型显示（外置登录曾被写死成"离线登录"）
	var head = "离线登录";

	var acc = m3config.current_account(cfg);
	if (acc) {
		if (acc.type == "msa") head = "正版登录";
		elseif (acc.type == "authlib") head = "外置登录";
	}

	if (n > 0) head = "运行中";
	elseif (launching) head = "启动中";

	winform.lblStatus.text = head ++ " · " ++ who ++ " · " ++ ver_short ++ " · " ++ cfg.memory ++ " MB";

	// 完整版本名挂到悬停提示上
	refresh_tooltip();
}

// 状态栏的悬停提示：显示完整版本名。
// 用 win.ui.tooltip（TTF_SUBCLASS 标准提示），不能用 winex.tooltip.popup——
// 后者会 capture 鼠标，提示一出现就得点一下才能继续操作窗口。
function refresh_tooltip() {
	if (!status_tip) return;

	var cfg = m3config.read();
	var text = cfg.version;
	if (#text == 0) text = "未选择版本";

	status_tip.add(winform.lblStatus, text);
}

// 运行期异常的记录器：发布版出错时弹窗一闪而过，先落盘再说。
// 只在"发布版报错、F5 不报"这类跨环境问题时用它定位，不替代正常报错。
function fatal_log(text) {
	var line = time() ++ "  " ++ tostring(text);

	try {
		string.save(m3paths.path("error.log"), line ++ '\r\n', 1);
	}
	catch(e) {
	}

	log("[致命] " ++ tostring(text), true);
}

function set_launching(on) {
	//切状态往往意味着"这次启动结束/失败了"，顺手把日志落盘
	if (!on) log_flush();

	launching = on;
	winform.btnLaunch.disabled = on;
	winform.btnLaunch.text = on ? "启动中…" : "启动游戏";
	winform.btnLaunch.redraw();
	refresh_status();
}

function notice(text) {
	// 发布版可能缺窗体资源，这里不能让它把整个操作带崩
	var frm = null;
	try { frm = winform.loadForm("/dlg/notice.aardio"); }
	catch(e) { frm = null; }

	if (!frm) {
		// 退化成状态栏提示，至少不会什么都不发生
		winform.lblStatus.text = string.replace(text, '\r\n', " ");
		winform.lblStatus.visible = true;
		return;
	}

	frm.lblMsg.text = text;
	frm.doModal(winform);
}

// ---------- 版本下拉框 ----------

// 从当前游戏路径的 versions 目录填下拉框
function load_version_combo() {
	var cfg = m3config.read();

	winform.comboVer.clear();

	var vdir = io.joinpath(cfg.game_path, "versions");
	if (io.exist(vdir)) {
		var files, folders = fsys.list(vdir);

		// 当前版本排第一：下拉展开会滚到选中项，它在中间的话，
		// 前面那些版本就被滚出视野，看着像"版本不见了"。
		var names = {};
		for(i = 1; #folders; 1) {
			var name = folders[i];
			if (name) table.push(names, name);
		}

		if (cfg.version) {
			for i, name in names {
				if (name == cfg.version) winform.comboVer.add(name);
			}
		}

		for i, name in names {
			if (name != cfg.version) winform.comboVer.add(name);
		}
	}

	var items = winform.comboVer.items;
	if (#items == 0) {
		winform.comboVer.selIndex = 0;
		return;
	}

	// 选中配置里的版本；找不到就落到第一项，并把配置改过去
	var at = 0;
	for i, v in items {
		if (v == cfg.version) {
			at = i;
			break;
		}
	}

	if (at == 0) at = 1;
	winform.comboVer.selIndex = at;

	var picked = items[at];
	if (picked != cfg.version) {
		m3config.update(function(c) { c.version = picked; });
		refresh_status();
	}
}

winform.comboVer.onSelChange = function() {
	var name = winform.comboVer.selText;
	if (#name == 0) return;

	var cfg = m3config.read();
	if (cfg.version == name) return;

	m3act.log("切换版本：" ++ name);
	m3config.update(function(c) { c.version = name; });
	refresh_status();
}

// 鼠标停在状态栏上时的 full 版本名由 refresh_tooltip() 维护（win.ui.tooltip）

// ---------- 实例 ----------

function open_log_window(inst) {
	// 缺日志窗体时不能让启动流程中断，返回 null 当作「没有日志窗口」
	var frm = null;
	try { frm = winform.loadForm("/dlg/log.aardio"); }
	catch(e) { return null; }

	if (!frm) return null;

	frm.text = "日志 - " ++ inst.session.tag;
	frm.bind(inst.session, inst);   // 把实例也传进去，日志窗口的「打包日志」要用路径
	return frm;
}

// 一个实例结束：收尾、写日志、从列表里摘掉
function finish_instance(inst) {
	var o2, e2 = inst.prcs.peek(0);
	if (o2 or e2) {
		inst.buffer = inst.buffer ++ (o2 or "") ++ (e2 or "");
		flush_lines(inst);
	}

	if (#inst.buffer > 0) {
		inst.session.write(string.trimRight(inst.buffer));
		inst.buffer = "";
	}

	var code = inst.prcs.getExitCode();
	inst.prcs.close();
	inst.prcs = null;

	// 运行时长（秒），崩溃窗口里会显示
	var seconds = 0;
	if (inst.started) {
		seconds = math.floor((time.tick() - inst.started) / 1000);
		if (seconds < 0) seconds = 0;
	}

	// 用户主动结束的不算崩溃
	//退出码非 0 一定是异常；退出码为 0 也可能是异常 ——
	//老版本（1.5.2 这类）启动失败时会静默 exit(0)，用户完全看不到东西。
	//所以在 60 秒内退出、且日志里从没有过游戏启动标记时，也按失败处理。
	var early_dead = (!inst.saw_game_log and seconds < 60);
	var crashed = ((code != 0) or early_dead) and (!inst.stopped_by_user);

	inst.session.write("--------------------------------------------------");
	inst.session.write("游戏已退出，退出码 " ++ tostring(code), code != 0);

	note_to_file("--------------------------------------------------");
	note_to_file("游戏已退出，退出码 " ++ tostring(code));
	m3act.log("游戏退出：退出码 " ++ tostring(code) ++ "，实例 " ++ tostring(inst.name or ""));

	for i, v in instances {
		if (v === inst) {
			table.remove(instances, i);
			break;
		}
	}

	refresh_status();

	if (#instances == 0) {
		if (poll_timer) {
			winform.clearInterval(poll_timer);
			poll_timer = null;
		}

		// 启动后自动隐藏过的，全部退出就把窗口还回来
		if (self_hidden) {
			self_hidden = false;
			winform.show(1);
		}
	}

	// 异常退出：弹崩溃窗口（放最后，主窗口已经恢复显示了，弹窗才有正确的父窗口）
	if (crashed) open_crash_window(inst, code, seconds);
}

// 游戏异常退出时弹的窗口：列出关键信息 + 日志位置 + 复制诊断
function open_crash_window(inst, code, seconds) {
	var info = {
		version = inst.version;
		game_dir = inst.game_dir;
		work_dir = inst.work_dir;
		java = inst.java;
		memory = inst.memory;
		exit_code = code;
		seconds = seconds;
	};

	var logs = m3crash.collect(inst.work_dir);

	var frm = null;
	var load_err = null;
	try { frm = winform.loadForm("/dlg/crash.aardio"); }
	catch(e) { load_err = tostring(e); }

	// 窗体缺失（比如发布版忘了同步）或窗体脚本出错时不能静默：
	// 一定要把原始错误写进日志，否则只剩一句「打不开」，没法查。
	if (!frm) {
		log("[错误] 游戏异常退出（退出码 " ++ tostring(code) ++ "），但崩溃窗口打不开：" ++ tostring(load_err), true);
		return;
	}

	// 崩溃窗口前面还要叠一个「请勿直接截图分享此窗口」的提醒（设置里能关，默认开）。
	// 提醒由崩溃窗口自己在显示出来之后弹出，这样它一定压在崩溃窗口上面。
	var cfg = m3config.read();   // main 里的 cfg 都是各函数自己读的，这里也要读一份
	var want_tip = false;
	if (cfg.shot_tip and !shot_tip_shown) {
		want_tip = true;
		shot_tip_shown = true;
	}

	frm.bind({
		info = info;
		logs = logs;
		session = (inst.session ? inst.session.text() : "");
		cmdline = inst.cmdline or "";
		show_tip = want_tip;
	});

	// 非模态显示：多开时可能同时有好几个实例崩溃，一个窗口挡住别的不合适。
	// 归属主窗口，主窗口关掉时它们跟着关；每多一个就错开一点，避免完全叠在一起看不出来。
	win.setOwner(frm.hwnd, winform.hwnd);
	frm.center(winform);

	if (crash_seq > 0) {
		var rc = frm.getRect(true);
		var off = (crash_seq % 4) * 28;
		frm.setPos(rc.left + off, rc.top + off);
	}

	crash_seq = crash_seq + 1;

	frm.show();
}

// 60ms 轮询所有实例：搬日志、看谁退出了
function poll() {
	try {
		poll_core();
	}
	catch(e) {
		fatal_log("轮询进程输出时出错：" ++ tostring(e));
	}
}

function poll_core() {
	if (#instances == 0) {
		if (poll_timer) {
			winform.clearInterval(poll_timer);
			poll_timer = null;
		}
		return;
	}

	var done = {};

	for i, inst in instances {
		var out, errout = inst.prcs.peek(0);
		if (out or errout) {
			inst.buffer = inst.buffer ++ (out or "") ++ (errout or "");
			flush_lines(inst);

			inst.last_out = time.tick();
			inst.hang_reported = false;
		}
		elseif (inst.last_out and !inst.hang_reported and (time.tick() - inst.last_out) > 60000) {
			//进程还活着但一分钟没有新输出：多半卡在 mod 自己的下载/加载上，
			//先说清楚，免得用户以为启动器没反应。
			inst.hang_reported = true;

			log("[提示] 检测到 60 秒没有新的游戏输出，游戏可能正在下载文件。");
		}

		if (!inst.prcs.stillActive()) table.push(done, inst);
	}

	for i, inst in done {
		finish_instance(inst);
	}
}

// 右键「启动游戏」：强制结束全部实例
function stop_all() {
	if (#instances == 0) return;

	var list = instances;
	instances = {};

	if (poll_timer) {
		winform.clearInterval(poll_timer);
		poll_timer = null;
	}

	for i, inst in list {
		inst.stopped_by_user = true;
		inst.session.write("[提示] 强制结束该实例。", true);

		if (inst.prcs) {
			if (inst.prcs.stillActive()) {
				inst.prcs.terminate();
			}
			else {
				inst.prcs.close();
			}
			inst.prcs = null;
		}
	}

	refresh_status();

	if (self_hidden) {
		self_hidden = false;
		winform.show(1);
	}
}

// ---------- 启动 ----------

// 设置游戏进程优先级（launch 之后立刻调用）
function apply_priority(prcs, name) {
	var classes = {
		idle = 0x40;      // _IDLE_PRIORITY_CLASS
		below = 0x4000;   // _BELOW_NORMAL_PRIORITY_CLASS
		normal = 0x20;    // _NORMAL_PRIORITY_CLASS
		above = 0x8000;   // _ABOVE_NORMAL_PRIORITY_CLASS
		high = 0x80;      // _HIGH_PRIORITY_CLASS
	};

	var cls = classes[name];
	if (!cls or !prcs) return;
	if (!prcs.process) return;

	prcs.process.setPriorityClass(cls);
}

function start_game(retried, inst) {
	if (launching) return;

	//异常统一记录：发布版没有控制台，靠在 M3L\error.log 里留痕
	try {
		start_game_core(retried, inst);
	}
	catch(e) {
		var msg = "启动游戏时出错：" ++ tostring(e);

		fatal_log(msg);

		try {
			notice(msg ++ '\r\n\r\n' ++ "详情已写入 M3L\\error.log。");
		}
		catch(e2) {
		}

		set_launching(false);
	}
}

function start_game_core(retried, inst) {

	var cfg = m3config.read();

	m3act.log("启动游戏：" ++ tostring(cfg.version));
	debug_mode = (cfg.debug ? true : false);

	//兼容处理开关：关掉后 classpath/参数一律照 JSON 原样，不做任何"纠正"。
	//read_json 里就要用到，所以必须在读版本文件之前设置。
	MMMLC.set_compat(cfg.compat_fix !== false);

	//微软登录的客户端 ID：用户填了就用用户的，否则用内置默认
	var ms_client = cfg.ms_client_id;
	if (!ms_client or #ms_client == 0) ms_client = m3app.MS_CLIENT_DEFAULT;
	m3auth.set_client(ms_client);

	// 第一次进来才检查多开
	if (!inst) {
		if (#instances > 0 and !cfg.allow_multi) {
			notice("多开模式未开启，当前仅允许一个实例。" ++ '\r\n' ++ "可以在「设置 → 启动器」里打开多开。");
			return;
		}
	}

	set_launching(true);

	//落盘文件在这里就定好：账号、Java、兼容处理这些提示都在读 JSON 之前产生，
	//晚设的话它们进不了文件（外置登录的提示就是这么丢的）。
	if (#cfg.version > 0) {
		launch_file = io.joinpath(cfg.game_path, "versions", cfg.version, "m3l-launch.txt");
		string.save(launch_file, "");
		launch_buf = "";
		log("[提示] 本次启动日志： " ++ launch_file);
	}

	//把版本与核心构建写进日志：排查"发行版和 F5 表现不同"时，一眼看出是哪份代码
	log("[提示] 启动器 " ++ m3app.version_text() ++ "，核心 " ++ MMMLC.BUILD);

	// 没设用户名就用 player 顶上，稍后提示用户
	var username = cfg.username;
	var use_player = false;
	if (#username == 0) {
		username = "player";
		use_player = true;
	}

	// 参数先校验完，再建日志窗口——这样标题里就能直接带上版本名
	if (#cfg.game_path == 0 or !io.exist(cfg.game_path)) {
		notice("[错误] 游戏目录不存在。");
		set_launching(false);
		return;
	}
	if (#cfg.version == 0) {
		notice("[错误] 未选择版本。");
		set_launching(false);
		return;
	}

	// 版本独立设置：全局打底，版本目录里的 .m3l.options.json 盖上去。
	// 后面的内存 / 窗口 / 优先级 / JVM 参数都用这份"实际生效"的值。
	var eff = m3opts.effective(cfg, cfg.game_path, cfg.version);

	// 版本隔离：默认每个版本用自己的目录（versions\<版本>）；
	// 关掉隔离的版本改用 .minecraft 根目录。判断要带上游戏目录，
	// 否则不同 .minecraft 里的同名版本会共用同一份设置。
	var isolated = m3config.is_isolated(cfg, cfg.game_path, cfg.version);

	var work_dir = isolated
		? io.joinpath(cfg.game_path, "versions", cfg.version)
		: cfg.game_path;

	if (!io.exist(io.joinpath(cfg.game_path, "versions", cfg.version))) {
		notice("[错误] 找不到版本：" ++ '\r\n' ++ cfg.version);
		set_launching(false);
		return;
	}

	//启动前自检：版本目录不可写时，natives 解压、日志、模组配置全部会失败，
	//而游戏给出的报错通常和真正原因无关（"无法创建窗口"之类），所以先拦下来。
	//这同时是"提权能起、双击起不来"最常见的原因。
	if (!can_write(work_dir)) {
		log("[错误] 游戏目录不可写：" ++ tostring(work_dir), true);
		log("        natives、日志、模组配置都写不进去，游戏会在创建窗口前失败。", true);
		log("        若目录权限正常（资源管理器能新建文件），多半是安全软件拦了本程序。", true);
		log("        对策：把启动器加入信任区 / 排除项，或用管理员身份运行。", true);

		notice("[错误] 游戏目录不可写：" ++ '\r\n' ++ tostring(work_dir) ++ '\r\n\r\n'
			++ "若目录权限正常（资源管理器里能新建文件），" ++ '\r\n'
			++ "多半是安全软件拦截了本程序：" ++ '\r\n'
			++ "请加入信任区 / 排除项，或用管理员身份运行。");

		set_launching(false);
		return;
	}

	// 参数齐了，建会话 + 日志窗口
	if (!inst) {
		// 没有实例在跑时从头编号，避免编号一直往上飘
		if (#instances == 0) instance_seq = 0;
		instance_seq = instance_seq + 1;

		inst = {
			id = instance_seq;
			buffer = "";
			prcs = null;
			log_form = null;
			session = m3log.create("实例 " ++ instance_seq ++ " · " ++ cfg.version);
		};

		cur_session = inst.session;

		if (cfg.log) inst.log_form = open_log_window(inst);
	}

	if (use_player) {
		log("[提示] 还未设置用户名，将使用 player 作为临时用户名。", true);
		notice("还未设置用户名，将使用 player 作为临时用户名。" ++ '\r\n' ++ "可以在「设置 → 游戏设置」里改。");
	}

	dbg("实例 " ++ inst.id ++ "：游戏目录 " ++ cfg.game_path);
	dbg("版本：" ++ cfg.version);
	dbg("工作目录：" ++ work_dir);
	note_to_file("[提示] 工作目录： " ++ work_dir);
	note_to_file("[提示] Java： " ++ tostring(java));
	dbg("内存：" ++ eff.memory ++ " MB");
	dbg("窗口模式：" ++ eff.window_mode);
	dbg("配置的 Java：" ++ tostring(cfg.java));

	if (debug_mode) {
		var cands = m3java.scan_paths(work_dir);
		dbg("扫描到 " ++ #cands ++ " 个 Java：");
		for i, p in cands {
			dbg("    " ++ p);
		}
	}

	// 游戏窗口大小三种规则
	var game_w = eff.width;
	var game_h = eff.height;

	if (eff.window_mode == "fullscreen") {
		m3game.set_fullscreen(work_dir, true);
	}
	elseif (eff.window_mode == "match") {
		m3game.set_fullscreen(work_dir, false);
		game_w = winform.width;
		game_h = winform.height;
	}
	else {
		m3game.set_fullscreen(work_dir, false);
	}

	// 账号：离线 / 正版（微软）/ 外置登录
	var uuid = crypt.md5("OfflinePlayer:" ++ username);
	var access_token = "0";
	var user_type = "msa";
	var acc = m3config.current_account(cfg);

	if (acc) {
		var custom = string.trim(acc.uuid or "");
		if (#custom > 0) uuid = custom;
	}

	if (acc and (acc.type == "msa" or acc.type == "authlib") and #(acc.access_token or "") > 0) {
		// 微软凭据快到期就先续期：否则游戏能起来但进服务器会被踢
		if (acc.type == "msa") {
			var exp = tonumber(acc.expires_at) or 0;
			var now = tonumber(time.now());

			if (exp > 0 and (exp - now) < 600 and #(acc.refresh_token or "") > 0) {
				var r, rerr = m3auth.refresh_ms(acc.refresh_token);

				if (r) {
					acc.access_token = r.access_token;
					acc.refresh_token = r.refresh_token;
					acc.expires_at = now + r.expires_in;
					m3config.save_keys(cfg, {"accounts"});
					log("[提示] 登录凭据已自动续期。");
				}
				else {
					log("[警告] 登录凭据续期失败：" ++ tostring(rerr), true);
				}
			}
		}

		access_token = acc.access_token;
		user_type = (acc.type == "authlib" ? "mojang" : "msa");

		if (#(acc.uuid or "") > 0) uuid = acc.uuid;

		log("[提示] 使用账号：" ++ username ++ "（" ++ (acc.type == "authlib" ? "外置登录" : "正版") ++ "）");
	}

	// 自定义 JVM 参数：一行一条，空行忽略
	var extra_jvm = {};
	var jvm_text = string.replace(eff.jvm_args or "", '\r', "");
	if (#jvm_text > 0) {
		var jvm_lines = string.split(jvm_text, '\n');
		for k, line in jvm_lines {
			line = string.trim(line);
			if (#line > 0) table.push(extra_jvm, line);
		}
	}

	// 外置登录：把 authlib-injector 挂成 javaagent（缺 jar 会自己去下）
	if (acc and acc.type == "authlib" and #(acc.authlib_server or "") > 0) {
		var injector_dir = m3paths.injector_dir();
		var agent, aerr = m3auth.injector_arg(acc.authlib_server, injector_dir);

		if (agent) {
			table.push(extra_jvm, agent);
			log("[提示] 已挂载外置登录：" ++ tostring(acc.authlib_server));
		}
		else {
			log("[警告] " ++ tostring(aerr), true);
			log("        本次将以离线身份启动。", true);
		}
	}

	var opts = {
		minecraft_dir = cfg.game_path;
		version = cfg.version;
		username = username;
		uuid = uuid;
		access_token = access_token;
		user_type = user_type;
		version_type = "M3LC";
		memory = eff.memory;
		work_dir = work_dir;
		java_hint = cfg.java;
		width = game_w;
		height = game_h;
		no_wait = false;
		extra_jvm = extra_jvm;
	};

	log("--------------------------------------------------");
	log("启动 " ++ cfg.version ++ "   玩家 " ++ username ++ "   内存 " ++ eff.memory ++ " MB");

	// 启动前先把版本目录的 JSON 归位（文件名、id 与目录名对齐）。
	// 用户在资源管理器里改过文件夹名时，不做这一步 --version 会指到不存在的目录。
	var fixed, why = m3version.repair(opts.minecraft_dir, cfg.version);
	if (fixed) log("[提示] 已修正版本目录里的 JSON 文件名或 id。", true);
	elseif (why) dbg("版本目录自愈：" ++ why);

	var info, err = MMMLC.read_json(opts.minecraft_dir, cfg.version);

	// 再给一次机会：万一刚才没修成，读失败后再试一次
	if (!info) {
		var fixed2 = m3version.repair(opts.minecraft_dir, cfg.version);
		if (fixed2) {
			log("[提示] 已修正版本目录里的 JSON 文件名，重试读取。", true);
			info, err = MMMLC.read_json(opts.minecraft_dir, cfg.version);
		}
	}

	if (!info) {
		log("[错误] " ++ err, true);
		if (!cfg.log) notice("[错误] " ++ err);
		set_launching(false);
		return;
	}

	//本次启动的日志落到版本目录。放在缺库检查**之前**，
	//否则「缺少 N 个库文件」这类最关键的几行反而进不了文件。
	launch_file = io.joinpath(info.version_dir, "m3l-launch.txt");
	string.save(launch_file, "");
	launch_buf = "";
	log("[提示] 本次启动日志： " ++ launch_file);

	// 这个版本勾了「关闭文件校验」：明知可能缺文件也照常启动，不再报这一条
	if (!eff.skip_check and #info.missing > 0) {
		log("[警告] 缺少 " ++ #info.missing ++ " 个库文件，可能导致游戏无法正常启动：", true);
		for i, p in info.missing {
			if (i > 6) {
				log("        ……还有 " ++ (#info.missing - 6) ++ " 个", true);
				break;
			}
			log("        " ++ p, true);
		}
		log("        请补齐这些文件后再启动游戏。", true);

		//只写日志不够：窗口一关就没人知道为什么起不来，这里必须弹出来
		var msg = "客户端文件不完整：缺少 " ++ #info.missing ++ " 个库文件。" ++ '\r\n';

		for i, p in info.missing {
			if (i > 3) {
				msg = msg ++ "……还有 " ++ (#info.missing - 3) ++ " 个。" ++ '\r\n';
				break;
			}
			msg = msg ++ "  " ++ p ++ '\r\n';
		}

		msg = msg ++ '\r\n' ++ "请补齐这些文件后再启动游戏。";
		notice(msg);
	}

	//启动前把我们做过的兼容处理说清楚：方便日后对照日志判断问题出在哪一层。
	var notes = info.notes;
	if (notes) {
		for i, s in notes {
			log("[提示] " ++ s);
		}
	}

	//本次启动的日志落到版本目录，便于事后排查（也随「打包日志」一起带走）
	var ok, nerr = MMMLC.prepare_natives(info);
	if (!ok) { log("[错误] " ++ nerr, true); set_launching(false); return; }

	//版本独立设置里指定了 Java：优先用它（相对路径以版本文件夹为起点）
	if (eff.java) {
		var vj, vjerr = MMMLC.version_java(eff.java, info.version_dir);

		if (vj) {
			opts.java_hint = vj;
			log("[提示] 本版本指定了 Java：" ++ vj);
		}
		else {
			log("[警告] " ++ tostring(vjerr), true);
			log("        已改用全局 Java。", true);
		}
	}

	var java, jerr = MMMLC.find_java(opts.java_hint);
	if (!java) { log("[错误] " ++ jerr, true); set_launching(false); return; }

	var major, verr, fatal = MMMLC.get_java_version(java);
	if (fatal) { log("[错误] " ++ verr, true); set_launching(false); return; }
	if (!major) log("[警告] " ++ verr, true);

	opts.java = java;
	opts.java_major = major;

	// 记下这次启动的关键信息，崩溃时直接拿给 crash 窗口用
	if (inst) {
		inst.version = cfg.version;
		inst.game_dir = cfg.game_path;
		inst.work_dir = work_dir;
		inst.java = java;
		inst.memory = eff.memory;
		inst.started = time.tick();
	inst.last_out = inst.started;   // 卡住提示用

		// 打包日志时把启动命令行也带上，排查 Java 参数问题很有用。
		// 存进 inst 之前就脱敏：这条会进日志窗口、崩溃窗口和打包 zip，
		// 打包 zip 是准备发给别人的，里面绝不能有令牌。
		try {
			var cmd_args = MMMLC.build_args(info, opts);
			inst.cmdline = m3secret.redact(java ++ " " ++ table.concat(cmd_args, " "));
		}
		catch(e) {
			inst.cmdline = java;
		}
	}

	log("Java " ++ tostring(major) ++ "   类路径 " ++ #info.classpath ++ " 个 jar");
	log("        " ++ java);

	if (debug_mode) {
		var args, aerr = MMMLC.build_args(info, opts);
		if (args) {
			dbg("启动命令：");
			dbg("    " ++ mask_token(java ++ " " ++ process.joinArguments(args)));

			//命令行对排查"游戏没输出/一闪而过"很关键，无条件落盘一份（令牌打码）
			note_to_file("[提示] 启动命令： " ++ mask_token(java ++ " " ++ process.joinArguments(args)));
		}
		else {
			dbg("无法生成命令：" ++ tostring(aerr));
		}
	}

	// Java 版本不匹配：弹窗让用户选
	if (!retried and major and info.java_version and (major != info.java_version)) {
		var frm = winform.loadForm("/dlg/java_warn.aardio");
		frm.lblMsg.text = "需要 Java ：" ++ info.java_version ++ "，当前 Java ：" ++ major ++ "。";
		var choice = frm.doModal(winform);

		if (choice == 1) {
			// 直接从已经检测过的列表里挑，不用再起一堆进程问版本
			var p, m2 = m3java.pick_cfg(cfg, info.java_version);

			if (p) {
				m3config.update(function(c) { c.java = p; });
				log("已换用 Java " ++ m2 ++ "：" ++ p);
			}
			else {
				log("[警告] 没有可用的 Java " ++ info.java_version ++ "（可能都被加入了黑名单）。", true);
				log("        本次仍然使用 Java ：" ++ tostring(major) ++ "：" ++ java, true);
				log("        可在「设置 → Java 管理」里调整。", true);
			}

			set_launching(false);
			start_game(true, inst);
			return;
		}
		elseif (choice == 2) {
			// 带起始页打开设置：第 4 页是 Java 管理
			g_settings_start_page = 4;
			var java_frm = winform.loadForm("/dlg/settings2.aardio");
			if (java_frm.doModal(winform)) {
				load_version_combo();
				refresh_status();
			}
			set_launching(false);
			start_game(true, inst);
			return;
		}
	}

	var newPrcs, pid, lerr = MMMLC.launch(info, opts);
	if (!newPrcs) { log("[错误] " ++ lerr, true); set_launching(false); return; }

	inst.prcs = newPrcs;
	inst.buffer = "";
	table.push(instances, inst);

	// 进程优先级（在游戏起来之后设，设不上也不影响启动）
	apply_priority(inst.prcs, eff.priority);

	log("已启动，PID = " ++ tostring(pid));
	log("游戏运行期间，右键「启动游戏」可强制结束。");

	set_launching(false);

	if (cfg.hide_after_launch) {
		self_hidden = true;
		winform.show(0);
	}

	if (!poll_timer) poll_timer = winform.setInterval(poll, 60);
}

winform.btnLaunch.oncommand = function(id, event) {
	start_game(false, null);
}

// 右键 = 强制停止全部实例
winform.btnLaunch.onRightMouseUp = function(wParam, lParam) {
	stop_all();
}

// ---------- 设置 / 关于 ----------

winform.btnSettings.oncommand = function(id, event) {
	// 设置窗口：左侧导航 + 右侧分组，所有设置与管理都在里面
	var frm = winform.loadForm("/dlg/settings2.aardio");
	if (frm.doModal(winform)) {
		// 设置里可能换了游戏路径、换了账号，版本下拉框与状态栏都要跟着刷新
		load_version_combo();
		refresh_status();
	}
}

// 右键标题 = 调试菜单（只有开了「调试模式」才响应，正式用户点不出来）。
//
// 三件事要一起绕开：
// 1) popmenu.popup() 不带 TPM_RETURNCMD，返回值恒为 0 —— 判断点中项只能靠菜单项回调；
// 2) 回调可能在 popup() 返回后才分派 —— 所以动作延一拍执行，不紧接着 popup 就跑；
// 3) 在回调里弹模态窗口会让回调重入 —— 所以回调只记"想做什么"，动作统一在 run_debug_action 里做。
var debug_want = 0;

winform.btnTitle.onRightMouseDown = function(wParam, lParam) {
	var cfg = m3config.read();
	if (!cfg.debug) return;

	show_debug_menu(cfg);
}

function show_debug_menu(cfg) {
	var menu = win.ui.popmenu(winform);

	// ---- 只读摘要：置灰，点了没反应 ----
	var acc = m3config.current_account(cfg);
	var acc_text = "尚未配置账号";

	if (acc) {
		var kind = "离线登录";
		if (acc.type == "msa") kind = "正版登录";
		elseif (acc.type == "authlib") kind = "外置登录";

		acc_text = kind ++ "：" ++ tostring(acc.name or "");
	}

	var ver_text = cfg.version;
	if (#ver_text == 0) ver_text = "未选择版本";

	menu.add({ text = "启动器 " ++ m3app.version_text() ++ "　核心 " ++ MMMLC.BUILD; flag = 0x1/*_MF_GRAYED*/ });
	menu.add({ text = "账号 " ++ acc_text; flag = 0x1 });
	menu.add({ text = "版本 " ++ ver_text; flag = 0x1 });
	menu.add();

	// ---- 可点项 ----
	var ID = {
		style = 101;
		crash = 102;
		data = 103;
		launchlog = 104;
		cache = 105;
		migrate = 106;
		actlog = 107;
		exit_debug = 108;
	};

	debug_want = 0;

	var pick = function(id) {
		return function(id2) {
			debug_want = id;
		};
	}

	menu.add("控件样式测试台", pick(ID.style));
	menu.add("崩溃窗口测试台", pick(ID.crash));
	menu.add();

	// ---- 子菜单：单独打开某个窗体（调样式用）----
	// 清单在 lib/m3dlgs.aardio，加窗体只改那边。
	var subDlg = win.ui.popmenu(winform);

	for i, item in m3dlgs.LIST {
		var code = 1000 + i;

		subDlg.add(item.title, pick(code));
	}

	menu.add("打开窗体（调样式）", subDlg);
	menu.add();

	menu.add("打开数据目录", pick(ID.data));
	menu.add("打开启动日志目录", pick(ID.launchlog));
	menu.add();

	menu.add("清空元数据缓存", pick(ID.cache));
	menu.add("重新执行布局迁移", pick(ID.migrate));
	menu.add({ text = "记录操作日志"; flag = (cfg.action_log ? 0x8/*_MF_CHECKED*/ : 0); proc = pick(ID.actlog) });
	menu.add();

	menu.add("关闭调试模式", pick(ID.exit_debug));

	// 阻塞到菜单关闭；点击结果记在 debug_want 里
	menu.popup();

	// 点击可能由消息队列稍后分派，延一拍再执行（此时菜单已关，可安全弹模态窗口）
	winform.setTimeout(function() {
		var want = debug_want;
		debug_want = 0;

		if (want != 0) run_debug_action(want, cfg);
	}, 30);
}

function run_debug_action(want, cfg) {
	var ID = {
		style = 101;
		crash = 102;
		data = 103;
		launchlog = 104;
		cache = 105;
		migrate = 106;
		actlog = 107;
		exit_debug = 108;
	};

	// 窗体预览：1000 + 序号（清单见 lib/m3dlgs.aardio）
	if (want >= 1000) {
		var item = m3dlgs.LIST[want - 1000];

		if (!item) return;

		m3act.log("预览窗体：" ++ tostring(item.title));

		var ok, why = m3dlgs.open(winform, item);

		if (!ok and why) notice(why);

		return;
	}

	if (want == ID.style) {
		m3act.log("打开控件样式测试台");
		winform.loadForm("/dlg/theme_test.aardio").doModal(winform);
		return;
	}

	if (want == ID.crash) {
		m3act.log("打开崩溃窗口测试台");
		winform.loadForm("/dlg/crash_test.aardio").doModal(winform);
		return;
	}

	if (want == ID.data) {
		m3act.log("打开数据目录");
		process.explore(m3paths.root());
		return;
	}

	if (want == ID.launchlog) {
		if (#cfg.version == 0) {
			notice("未选择版本。");
			return;
		}

		var dir = io.joinpath(cfg.game_path, "versions", cfg.version);

		if (!io.exist(dir)) {
			notice("找不到版本目录：" ++ dir);
			return;
		}

		m3act.log("打开启动日志目录：" ++ cfg.version);
		process.explore(dir);
		return;
	}

	if (want == ID.cache) {
		var n = m3mod.cache_clear();
		m3act.log("清空元数据缓存：" ++ n ++ " 项");
		notice("已清空元数据缓存（" ++ n ++ " 项）。" ++ '\r\n' ++ "下次打开 Mod 列表会重新读取。");
		return;
	}

	if (want == ID.migrate) {
		var notes = {};
		var r = m3paths.migrate(function(text) { table.push(notes, text); });

		m3act.log("重新执行布局迁移：移动 " ++ r.moved ++ " 项，失败 " ++ r.failed ++ " 项");

		if (r.total == 0) {
			notice("没有需要迁移的文件。");
			return;
		}

		var msg = "移动 " ++ r.moved ++ " 项，失败 " ++ r.failed ++ " 项。";

		for i, line in notes {
			msg = msg ++ '\r\n' ++ line;
		}

		notice(msg);
		return;
	}

	if (want == ID.actlog) {
		// 以磁盘现值为准取反，避免用到旧快照
		var fresh = m3config.read();
		var on = (fresh.action_log !== true);

		m3config.update(function(c) { c.action_log = on; });

		// 先写"关"这一笔，再真正关掉，否则最后一条会丢
		if (on) m3act.set_enabled(true);
		m3act.log("操作日志：" ++ (on ? "开" : "关"));
		if (!on) m3act.set_enabled(false);

		if (on) notice("已开始记录操作日志。");
		else notice("已停止记录操作日志。");

		return;
	}

	if (want == ID.exit_debug) {
		m3act.log("关闭调试模式");

		m3config.update(function(c) { c.debug = false; });
		refresh_status();

		notice("已关闭调试模式。" ++ '\r\n' ++ "如需重新打开，请到「设置 → 启动器设置」勾选。");
		return;
	}
}

// 启动时把操作日志的开关状态同步给 m3act
m3act.set_enabled(m3config.read().action_log === true);

// ---------- 初始化 ----------

// 先把"这份 exe 到底在哪、读哪份配置、有没有写权限"记下来。
// 发布版与 F5 的差别主要就在这里：exe 目录 vs 工程目录，权限也可能不同。
m3act.log("启动器启动：exe=" ++ io._exepath ++ "，数据目录=" ++ m3paths.root());

// 写权限自检：数据目录与游戏目录各试写一个临时文件。
// 写不进去会表现成"配置读不到"或"natives 解不出来"，但表面看不出来。
// 说明：普通权限与管理员权限最现实的差别就是它 —— 同一份代码，
// 提权能起、双击起不来，多半是这里。
function can_write(dir) {
	if (#(dir or "") == 0) return false;

	if (!io.exist(dir)) return false;

	var file = io.joinpath(dir, "m3l-write-test.tmp");
	var ok = false;

	try {
		ok = string.save(file, "x") and true or false;
	}
	catch(e) {
		ok = false;
	}

	if (ok) {
		try{ fsys.delete(file); }catch(e){}
	}

	return ok;
}

// 分步探测：目录在不在 → 能不能建子目录 → 能不能写文件。
// 三者失败原因不同（缺目录 / 缺 CreateDirectories / 缺 CreateFiles），
// 分开报出来才能分清是 ACL、完整性级别，还是我们自己的路径拼错。
function probe_write(dir) {
	if (#(dir or "") == 0) return "未配置";

	if (!io.exist(dir)) return "目录不存在";

	// 建子目录
	var sub = io.joinpath(dir, "m3l-write-test-dir");
	var made = false;

	try {
		made = fsys.createDir(sub) and true or false;
	}
	catch(e) {
		made = false;
	}

	if (made) {
		try{ fsys.delete(sub); }catch(e){}
	}

	// 写文件
	var file = io.joinpath(dir, "m3l-write-test.tmp");
	var wrote = false;
	var why = "";

	try {
		wrote = string.save(file, "x") and true or false;
	}
	catch(e) {
		wrote = false;
		why = tostring(e);
	}

	if (!wrote and #why == 0) {
		// string.save 失败不给原因，这里捞一下系统错误码的文字
		try {
			why = tostring(..lasterr());
		}
		catch(e) {
			why = "";
		}
	}

	if (wrote) {
		try{ fsys.delete(file); }catch(e){}
	}

	if (#why > 0) {
		if (#why > 40) why = string.slice(why, 1, 40) ++ "…";
		return "不可写（" ++ why ++ "）";
	}

	if (made and wrote) return "可写";
	if (!made and !wrote) return "不可写（建目录与写文件都被拒）";
	if (!made) return "不可写（能写文件，不能建子目录）";

	return "不可写（能建目录，不能写文件）";
}

function probe_writable(label, dir) {
	if (#(dir or "") == 0) return label ++ "：未配置";

	var shown = tostring(dir);
	if (#shown > 60) shown = string.slice(shown, 1, 60) ++ "…";

	return label ++ "：" ++ probe_write(dir) ++ "（" ++ shown ++ "）";
}

var boot_cfg = m3config.read();
m3act.log(probe_writable("数据目录", m3paths.root()) ++ "；" ++ probe_writable("游戏目录", boot_cfg.game_path));

refresh_status();
load_version_combo();

// 状态栏的悬停提示：标准 tooltip 控件，自动显示/隐藏，不抢鼠标
status_tip = win.ui.tooltip(winform);
refresh_tooltip();

// 关窗时把没落盘的日志刷出去，否则最后几行会丢
winform.onClose = function(hwnd, message, wParam, lParam) {
	note_to_file("[提示] 启动器关闭，日志至此。");
	log_flush();
}

winform.show();
return win.loopMessage();
